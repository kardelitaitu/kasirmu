# kasir.mu License Server .dockerignore
# Excludes files that should not be copied into the Docker build context.

# Go build artifacts
*.exe
*.test
*.out
coverage.html

# Local runtime data (dev SQLite DB with seeded test superusers). The
# Dockerfile copies explicit source files, so this never enters the image —
# but keeping it out of the build context avoids shipping dev credentials
# to the daemon and bloating every build with the DB.
pb_data/
pb_data_*/

# Dev log files
*.log

# Windows-only build resources (go-winres manifest; irrelevant to the
# Linux container image)
*.syso
winres/
app.manifest

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files (not needed in the build)
*_test.go

# Documentation (bundled separately)
DEPLOY.md
README.md

# Git
.git/
.gitignore

# Environment files
.env
.env.*
