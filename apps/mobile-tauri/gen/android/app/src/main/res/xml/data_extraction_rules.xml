<?xml version="1.0" encoding="utf-8"?>
<!--
  M-4: Android 12+ (API 31) data extraction rules.
  Prevents cloud backup and device transfer from including the SQLite
  database (PIN hashes, customer data, sync secrets).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
