<?xml version="1.0" encoding="utf-8"?>
<!--
  M-4: Prevent adb backup from extracting the SQLite database.
  Excludes all database files, shared preferences containing secrets,
  and any file in the databases/ directory.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
