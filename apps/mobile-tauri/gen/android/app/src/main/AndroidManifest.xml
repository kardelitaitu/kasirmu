<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ── Network ─────────────────────────────────────────────────────────
         INTERNET is the only permission the current code paths genuinely need:
         the sync client, the license check and the image-download daemon all go
         through reqwest, and the WebView needs it as well. A WebSocket to the
         sync server rides on INTERNET too — there is no separate WiFi permission
         for it. ACCESS_NETWORK_STATE / ACCESS_WIFI_STATE are normal permissions
         that let the app *read* connectivity, so a dropped socket or a failed
         sync can back off and retry instead of hammering blind. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keep the CPU and radio up while a sync, print or payment is in flight.
         Normal permission; inert until the code actually acquires a wake lock,
         which nothing does yet — see the note at the bottom. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Haptics ─────────────────────────────────────────────────────────
         ui/src/utils/interaction.ts calls navigator.vibrate(15); the WebView
         Vibration API is a silent no-op without this. Normal, auto-granted.
         Every entry in INTERACTIONS currently sets vibrate:false, so it is
         dormant today and takes effect the moment one is enabled. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── Camera, for reading QR / barcodes ───────────────────────────────
         CAMERA is a DANGEROUS permission: declaring it is necessary but NOT
         sufficient — the user must also be asked at runtime, and for a WebView
         source the app has to answer WebChromeClient.onPermissionRequest for
         getUserMedia. BOTH already exist, but in wry, not here: the generated
         RustWebChromeClient (wry 0.55.1, the version this workspace locks)
         maps VIDEO_CAPTURE -> CAMERA, fires the OS permission dialog through
         its own permissionLauncher and grants or denies the WebView request
         from the result. Verified 2026-09-20 against the wry-v0.55.1 source,
         so no app-side runtime request is needed; the note at the bottom was
         corrected the same day. When tauri 2.12 ships the permission-handler
         exposure (merged upstream, milestone 2.12), this stays true.
         required="false" keeps the app installable on tablets with no camera,
         which matters because scanning is an optional input sitting alongside
         the serial / USB / BT hardware scanners. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ── Notifications ───────────────────────────────────────────────────
         DANGEROUS on API 33+ and likewise needs a runtime request, plus a
         channel created before the first post. Nothing posts a notification
         today; see the note at the bottom. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Bluetooth: receipt printer, and the cash drawer through it ───────
         Split by API level, because the capability moved. On API 31+
         (Android 12+) BLUETOOTH_CONNECT and BLUETOOTH_SCAN are DANGEROUS
         runtime permissions; on API 26-30 the same capability is the
         install-time BLUETOOTH / BLUETOOTH_ADMIN pair, which is why those
         carry maxSdkVersion=30 rather than being dropped — minSdk is 26.

         neverForLocation: scan results are used to find a known printer,
         never to infer where the tablet is. That exemption is what keeps
         ACCESS_FINE_LOCATION out of this file. Drop the flag and Android
         will demand location permission for scanning.

         The drawer needs no transport of its own: HAL's PrinterKickCashDrawer
         fires the RJ12 kick through the printer's ESC/POS port, so one
         Bluetooth link drives both. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!--
      Declared above and their runtime implementation status:

      Needs CODE, not just a line here:
        POST_NOTIFICATIONS   dangerous on API 33+; no channel/notification post yet.
        WAKE_LOCK            dormant; screen retention is handled cleanly by
                             FLAG_KEEP_SCREEN_ON via KasirmuNativeBridge.

      Fully implemented in app code:
        BLUETOOTH_CONNECT,   runtime permissions requested via KasirmuNativeBridge in
        BLUETOOTH_SCAN       MainActivity.kt; RFCOMM socket transport implemented via
                             crates/kasirmu-hal/src/transport/bt_android.rs (JNI).

      Handled by wry itself — no app-side code:
        CAMERA               the generated RustWebChromeClient answers
                             onPermissionRequest and raises the OS dialog.

      Not needed, and absent on purpose:
        CHANGE_WIFI_MULTICAST_STATE  mDNS is out of scope by decision.
        android.hardware.usb.host    USB is out of scope; tablet uses Bluetooth.
        RECORD_AUDIO                 app only plays sound, no audio input.
        ACCESS_FINE_LOCATION         not required (BLUETOOTH_SCAN is neverForLocation).
    -->

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.kasirmu_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kasirmu" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <provider
          android:name=".SyncInitProvider"
          android:authorities="${applicationId}.syncinitprovider"
          android:exported="false"
          android:initOrder="-100" />
    </application>
</manifest>
