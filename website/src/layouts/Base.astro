---
import { ClientRouter } from 'astro:transitions';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, t } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const ogLocale = locale === 'id' ? 'id_ID' : 'en_US';
const ogAltLocale = locale === 'id' ? 'en_US' : 'id_ID';
const desc = description ?? t(locale, 'meta.description');
// hreflang alternates for the same page in the other locale. Reuse the
// locale-stripping logic from LocaleSwitcher so /en/docs/x → /id/docs/x.
// The 404 page is served at /404 (no locale prefix) — fall back to home
// like LocaleSwitcher so hreflang never points at /en/404/.
const rawPath = Astro.url.pathname.replace(/^\/(?:en|id)(?:\/|$)/, '');
const path = !rawPath || rawPath.replace(/^\/+/, '').startsWith('404') ? '/' : rawPath;
---

<!doctype html>
<html lang={locale}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Runtime backend URL: served by the Worker from [vars] so a backend
         move needs no rebuild (see worker.ts); absent locally → falls back
         to the build-time PUBLIC_LICENSE_API_URL. Deferred: it only feeds
         hydration-time config reads, so it must not sit in the critical
         path ahead of the LCP resources. -->
    <script is:inline src="/__oz/runtime-config.js" defer></script>
    <!-- Inter + JetBrains Mono are self-hosted (fontsource, bundled into
         global.css as the 'Inter Variable' / 'JetBrains Mono Variable'
         families) — no third-party font origin, no blocking font CSS. -->
<!-- Apply the stored theme before first paint and on SPA swaps. -->
<script is:inline>
  (() => {
    const applyTheme = () => {
      // Read new key first, fall back to legacy key for migration
      const t = localStorage.getItem('kasirmu_theme') ?? localStorage.getItem('oz_theme');
      // Migrate legacy key if present
      if (localStorage.getItem('oz_theme') !== null) {
        localStorage.setItem('kasirmu_theme', localStorage.getItem('oz_theme'));
        localStorage.removeItem('oz_theme');
      }
      document.documentElement.dataset.theme = t === 'dark' ? 'dark' : 'light';
    };
    applyTheme();
    document.addEventListener('astro:after-swap', applyTheme);
  })();
</script>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Preconnect: Cloudflare Web Analytics beacon (auto-injected by the edge).
         Establishes TLS + DNS early so the RUM request at ~300ms doesn't
         block the critical path while waiting for a cold connection. -->
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {locales.map((code) => (
      <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('id', path)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kasir.mu" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <!-- PNG (not SVG): social scrapers (Facebook/Twitter) don't rasterize SVG. The source is public/og-image.svg — regenerate with: magick public/og-image.svg public/og-image.png -->
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "kasir.mu",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Windows, Linux, macOS, Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": desc
    })} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg text-ink antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll-reveal: observe elements with [data-reveal] and add .revealed class
      function initScrollReveal() {
        const elements = document.querySelectorAll('[data-reveal]:not(.revealed)');
        if (!elements.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
        );

        elements.forEach((el) => {
          // Check if element is already in viewport on load
          const rect = el.getBoundingClientRect();
          const isInView = rect.top < window.innerHeight + 20 && rect.bottom > -20;
          if (isInView) {
            // Small delay to ensure smooth animation on page load
            setTimeout(() => el.classList.add('revealed'), 50);
          } else {
            observer.observe(el);
          }
        });
      }

      document.addEventListener('DOMContentLoaded', initScrollReveal);
      document.addEventListener('astro:page-load', () => {
        // Small delay to ensure DOM is ready after Astro navigation
        setTimeout(initScrollReveal, 100);
      });
    </script>
  </body>
</html>
