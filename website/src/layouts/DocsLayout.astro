---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocSidebar, { type CategoryGroup } from '../components/DocSidebar.astro';
import SiteHead from '../components/SiteHead.astro';
import { t } from '../i18n';
import type { SearchDoc } from '../lib/search-index';
import '../styles/global.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  locale: string;
  title: string;
  description?: string;
  updated?: string;
  entries: CategoryGroup[];
  currentSlug?: string;
  headings?: Heading[];
  /**
   * This locale's docs for the header's quick-search modal, built by the docs
   * route that renders this layout (`toSearchDocs`). Forwarded verbatim — the
   * docs-ness rule stays with the routes, so this layout owns no data fetch.
   */
  searchDocs?: SearchDoc[];
}

const { locale, title, description, updated, entries, currentSlug, headings, searchDocs } = Astro.props;
const toc = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3);
const docDesc = description ?? t(locale, 'docs.title');
---

<!doctype html>
<html lang={locale}>
  <head>
    <SiteHead title={title} titleTag={`${title} — ${t(locale, 'docs.title')}`} description={docDesc} locale={locale} runtimeConfig={false} ogType="article" articleUpdatedAt={updated}>
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "kasir.mu", "item": "https://kasir.mu/" },
          { "@type": "ListItem", "position": 2, "name": t(locale, 'docs.title'), "item": new URL(`/${locale}/docs/`, Astro.site).toString() },
          { "@type": "ListItem", "position": 3, "name": title }
        ]
      })} />
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": docDesc,
        "inLanguage": locale,
        // image, publisher and mainEntityOfPage are part of Google's Article
        // guidance; without them the Article block was incomplete and the
        // docs pages could not qualify for an article rich result.
        "image": new URL('/og-image.png', Astro.site).toString(),
        "mainEntityOfPage": new URL(Astro.url.pathname, Astro.site).toString(),
        ...(updated ? { "dateModified": updated } : {}),
        "author": { "@type": "Organization", "name": "kasir.mu", "url": "https://kasir.mu" },
        "publisher": {
          "@type": "Organization",
          "name": "kasir.mu",
          "logo": { "@type": "ImageObject", "url": new URL('/og-image.png', Astro.site).toString() }
        }
      })} />
    </SiteHead>
  </head>
  <body class="flex min-h-screen flex-col bg text-ink antialiased">
    <!-- Skip link — see Base.astro. On docs pages the sidebar adds ~18 more
         tab stops before the article, so this matters most here. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-on-primary"
    >
      {t(locale, 'nav.skipToContent')}
    </a>
    <Header locale={locale} searchDocs={searchDocs} />

    <!-- Mobile sidebar (collapsible) -->
    <details class="border-b border-ink/5 md:hidden">
      <summary class="px-4 py-3 text-sm font-semibold">{t(locale, 'docs.title')}</summary>
      <div class="px-4 pb-4">
        <DocSidebar locale={locale} entries={entries} currentSlug={currentSlug} />
      </div>
    </details>

    <div class="mx-auto flex w-full max-w-7xl flex-1">
      <!-- Desktop sidebar -->
      <aside class="sticky top-[4.5rem] hidden h-[calc(100vh-4.5rem)] w-60 shrink-0 overflow-y-auto border-r border-ink/5 px-4 py-8 md:block">
        <p class="px-2 text-xs font-semibold uppercase tracking-wide text-muted">
          {t(locale, 'docs.title')}
        </p>
        <DocSidebar locale={locale} entries={entries} currentSlug={currentSlug} />
      </aside>

      <main id="main" class="min-w-0 flex-1 px-4 py-10 sm:px-8">
        <article class="docs-content mx-auto max-w-3xl">
          <h1 class="text-3xl font-bold">{title}</h1>
          {description && <p class="mt-3 text-muted">{description}</p>}
          {updated && (
            <p class="mt-4 text-xs text-muted">
              {t(locale, 'docs.updated')} {updated}
            </p>
          )}
          <div class="mt-8">
            <slot />
          </div>

          <!-- Doc Page Helpful Feedback Widget -->
          <div class="mt-12 rounded-xl border border-ink/10 bg-surface/50 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <p class="text-sm font-medium text-ink">{locale === 'id' ? 'Apakah halaman ini bermanfaat?' : 'Was this page helpful?'}</p>
              <p class="text-xs text-muted mt-0.5">{locale === 'id' ? 'Bantu kami menyempurnakan dokumentasi kasir.mu' : 'Help us improve the kasir.mu documentation'}</p>
            </div>
            <div class="flex items-center gap-2" data-doc-feedback-wrap>
              <button
                type="button"
                data-doc-feedback-yes
                class="rounded-md border border-ink/10 bg-surface px-3 py-1.5 text-xs font-medium text-ink transition hover:bg-ink/5"
              >
                👍 {locale === 'id' ? 'Ya' : 'Yes'}
              </button>
              <button
                type="button"
                data-doc-feedback-no
                class="rounded-md border border-ink/10 bg-surface px-3 py-1.5 text-xs font-medium text-ink transition hover:bg-ink/5"
              >
                👎 {locale === 'id' ? 'Belum' : 'No'}
              </button>
            </div>
          </div>
        </article>
      </main>

      <!-- On-this-page TOC -->
      {
        toc.length > 0 && (
          <aside class="sticky top-[4.5rem] hidden h-[calc(100vh-4.5rem)] w-56 shrink-0 overflow-y-auto px-4 py-8 xl:block">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">
              {t(locale, 'docs.onThisPage')}
            </p>
            <ul class="mt-3 space-y-1.5 text-sm">
              {
                toc.map((h) => (
                  <li class:list={[h.depth === 3 ? 'pl-3' : '']}>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link
                      class="text-muted transition-colors duration-150 hover:text-ink block py-0.5"
                    >
                      {h.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </aside>
        )
      }
    </div>

    <Footer locale={locale} />

    <script is:inline>
      (() => {
        const setupDocsFeatures = () => {
          // 1. Copy code buttons on pre blocks
          document.querySelectorAll('.docs-content pre').forEach((pre) => {
            if (pre.parentElement && pre.parentElement.classList.contains('code-block-wrapper')) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'code-block-wrapper';
            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);

            const btn = document.createElement('button');
            btn.className = 'copy-code-btn';
            btn.type = 'button';
            btn.textContent = 'Copy';
            btn.setAttribute('aria-label', 'Copy code to clipboard');
            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(code);
                btn.textContent = '✓ Copied';
                btn.classList.add('text-green-500');
                setTimeout(() => {
                  btn.textContent = 'Copy';
                  btn.classList.remove('text-green-500');
                }, 2000);
              } catch {}
            });
            wrapper.appendChild(btn);
          });

          // 2. Active TOC scroll spy
          const headings = Array.from(document.querySelectorAll('.docs-content h2, .docs-content h3'));
          const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
          if (headings.length && tocLinks.length) {
            const onScroll = () => {
              const scrollPos = window.scrollY + 120;
              let currentId = '';
              for (const h of headings) {
                if (h.offsetTop <= scrollPos) {
                  currentId = h.id;
                }
              }
              tocLinks.forEach((link) => {
                const isActive = link.getAttribute('href') === `#${currentId}`;
                link.classList.toggle('text-link', isActive);
                link.classList.toggle('font-medium', isActive);
                link.classList.toggle('text-muted', !isActive);
              });
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
          }

          // 3. Feedback buttons
          const fbWrap = document.querySelector('[data-doc-feedback-wrap]');
          const btnYes = document.querySelector('[data-doc-feedback-yes]');
          const btnNo = document.querySelector('[data-doc-feedback-no]');
          if (fbWrap && btnYes && btnNo) {
            const isId = document.documentElement.lang === 'id';
            btnYes.addEventListener('click', () => {
              fbWrap.innerHTML = '<span class="text-xs font-semibold text-green-500">✓ ' + (isId ? 'Terima kasih atas masukannya!' : 'Thanks for your feedback!') + '</span>';
            });
            btnNo.addEventListener('click', () => {
              fbWrap.innerHTML = '<span class="text-xs font-semibold text-muted">' + (isId ? 'Terima kasih, kami akan terus menyempurnakannya.' : 'Thanks, we will improve it!') + '</span>';
            });
          }
        };

        setupDocsFeatures();
        document.addEventListener('astro:page-load', setupDocsFeatures);
      })();
    </script>
  </body>
</html>
