---
// Root /pair redirect — detects locale and forwards query string (?code=...)
//
// The pairing SCREEN is src/pages/[locale]/pair.astro, which has its own h1;
// this document only chooses the language and forwards. It has no visible
// content by design, which used to mean no <body> content at all — so a reader
// with scripting off got a blank page, and the document had no h1 for any
// consumer that reads the markup (check-seo check 12). The noscript block below
// is the same fallback the root locale stub carries.
import { LANGUAGE_STORAGE_KEY } from '../lib/language';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>kasir.mu — Pair Tablet</title>
    <meta name="robots" content="noindex" />
    <!-- The key arrives via define:vars because an is:inline script is never
         bundled, so it cannot import the owner (lib/language.ts) directly. -->
    <script is:inline define:vars={{ LANGUAGE_STORAGE_KEY }}>
      const saved = localStorage.getItem(LANGUAGE_STORAGE_KEY);
      const lang = (saved || navigator.language || 'id').toLowerCase();
      const locale = lang.startsWith('id') ? 'id' : 'en';
      window.location.replace(`/${locale}/pair${window.location.search}`);
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/id/pair" />
    </noscript>
  </head>
  <body>
    <noscript>
      <h1>kasir.mu — memasangkan tablet sebagai terminal kasir</h1>
      <p>
        Skrip dimatikan di browser ini, jadi kami tidak bisa mengarahkan Anda ke halaman pasangkan
        tablet yang tepat. Silakan pilih sendiri:
      </p>
      <ul>
        <li><a href="/id/pair">Pasangkan tablet (Bahasa Indonesia)</a></li>
        <li><a href="/en/pair">Pair a tablet (English)</a></li>
      </ul>
    </noscript>
  </body>
</html>
