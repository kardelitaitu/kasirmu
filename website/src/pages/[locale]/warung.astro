---
export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "id" } }];
}
import Base from "../../layouts/Base.astro";
import VerticalLanding from "../../components/VerticalLanding.astro";
import { t } from "../../i18n";

const locale = Astro.currentLocale ?? "en";
const pageTitle = `kasir.mu — ${t(locale, "vertical.warung.title")}`;
---

<Base title={pageTitle} description={t(locale, "vertical.warung.tagline")}>
  <VerticalLanding vertical="warung" showBundle />
</Base>
