---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import PairView, { PAIR_LABELS } from '../../components/PairView.tsx';
import { labelMap, t } from '../../i18n';
import { isNonPublic } from '../../lib/site';

const locale = Astro.currentLocale ?? 'en';
// The island's strings travel with the document, so the browser never loads a
// locale dictionary (see src/i18n/labels.ts).
const pairLabels = labelMap(locale, PAIR_LABELS);
const pageTitle = `kasir.mu — ${t(locale, 'pair.title')}`;
// noindex is derived from the same NON_PUBLIC_PAGES list the sitemap filter
// and llms.txt use (src/lib/site.ts) — the three surfaces cannot disagree.
const noindex = isNonPublic(Astro.url.pathname);
---

<Base title={pageTitle} description={t(locale, 'pageDesc.pair')} noindex={noindex}>
  <section data-reveal class="mx-auto max-w-xl px-4 py-20">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold">{t(locale, 'pair.title')}</h1>
      <p class="mx-auto mt-2 max-w-md text-sm text-muted">{t(locale, 'pair.subtitle')}</p>
    </div>
    <PairView client:load locale={locale} labels={pairLabels} />
  </section>
</Base>
