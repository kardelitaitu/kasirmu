---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
/**
 * About — who kasir.mu is, what it exists to fix, and what it commits to.
 *
 * The page is laid out as a company page rather than a feature page, in the
 * order a reader evaluates one: the FACTS first (what this is, when it started,
 * what it runs on — `about.facts`), the story behind it, the PROBLEM in the
 * market, what we built instead, the GOAL we are steering by, and the PROMISES
 * a merchant can hold us to. Every promise is worded so it can be checked on
 * the reader's own machine — that is what separates a promise from a slogan.
 *
 * The founding year in `about.facts` is the owner's own statement (2025), and
 * it is the only fact on the page that does not come from the product itself.
 * Everything else is verifiable from the site: the platforms are the ones
 * `Base.astro` already advertises, the pricing line restates the free plan
 * without inventing a number that would rot at the next price change, and the
 * support line matches /contact. Deliberately absent: team names, headcount,
 * funding, and customer counts — a page that claims none of them cannot be
 * caught having invented one.
 *
 * Copy lives in the dictionaries (`about.*`) in both locales. Scalars resolve
 * through `t(locale, …)` inline, as the other pages read theirs; the structured
 * blocks are read with `dict()` and named back through `t()` in a
 * `data-i18n-key` attribute, which is what keeps them visible to
 * `scripts/audit-i18n.mjs` (it collects literals inside `t(…)`, and a key read
 * only through `dict()` is invisible to it).
 */
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, dict } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
// The whole document title. Composing `kasir.mu — ` on top of it would name the
// brand twice (the title already says "…built kasir.mu"), which reads as a
// mistake in a search result and spends characters of the ~60 a SERP shows.
const pageTitle = t(locale, 'about.title');

interface Differentiator {
  title: string;
  body: string;
  value: string;
}

interface AboutCopy {
  facts: { label: string; value: string }[];
  story: string[];
  problems: string[];
  items: Differentiator[];
  table: { feature: string; value: string }[];
  promises: { title: string; body: string }[];
}

const about = dict(locale).about as AboutCopy;
// Array order is the argument's order — storage → sync → hardware → footprint →
// server, each building on the previous. It is authoring order in the
// dictionary, so both locales render the same sequence.
const { facts, story, problems, items, table, promises } = about;

const downloadHref = getRelativeLocaleUrl(locale, 'download');
const pricingHref = getRelativeLocaleUrl(locale, 'pricing');
const contactHref = getRelativeLocaleUrl(locale, 'contact');
---

<Base title={pageTitle} description={t(locale, 'pageDesc.about')}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold sm:text-5xl">{pageTitle}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">{t(locale, 'about.subtitle')}</p>
    </div>

    <!-- The facts a reader checks before reading anything else. A description
         list, so each label is announced with its own value rather than as a
         row of loose text. -->
    <div
      data-reveal
      class="mt-12 rounded-2xl border border-ink/10 bg-surface/40 p-6 sm:p-8"
      data-i18n-key={t(locale, 'about.facts')}
    >
      <h2 class="text-xl font-bold">{t(locale, 'about.factsTitle')}</h2>
      <dl class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{fact.label}</dt>
              <dd class="mt-1 text-sm text-ink">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div data-reveal class="mt-16" data-i18n-key={t(locale, 'about.story')}>
      <h2 class="text-2xl font-bold">{t(locale, 'about.storyTitle')}</h2>
      <div class="mt-3 space-y-4 leading-relaxed text-muted">
        {story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <!-- The problem, named before the product is mentioned. Each item is a
         failure mode a merchant has already lived through once. -->
    <div data-reveal class="mt-16" data-i18n-key={t(locale, 'about.problems')}>
      <h2 class="text-2xl font-bold">{t(locale, 'about.problemTitle')}</h2>
      <p class="mt-3 text-muted">{t(locale, 'about.problemIntro')}</p>
      <ul class="mt-6 space-y-3">
        {
          problems.map((problem) => (
            <li class="flex gap-3 rounded-xl border border-ink/10 bg-surface/40 p-5 text-sm leading-relaxed text-muted">
              <span aria-hidden="true" class="mt-0.5 shrink-0 font-semibold text-danger">
                ✗
              </span>
              <span>{problem}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- What we did instead. Each card is the engineering fact plus the outcome
         it buys, because the fact alone is not why anyone switches. -->
    <div data-reveal class="mt-16" data-i18n-key={t(locale, 'about.items')}>
      <h2 class="text-2xl font-bold">{t(locale, 'about.approachTitle')}</h2>
      <p class="mt-3 text-muted">{t(locale, 'about.approachIntro')}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          items.map((item, i) => (
            <article class="rounded-xl border border-ink/10 bg-surface/40 p-6 transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)] hover:border-ink/20 hover:shadow-md">
              <h3 class="text-lg font-semibold">
                <span aria-hidden="true" class="mr-2 text-primary">
                  {i + 1}.
                </span>
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
              <p class="mt-4 flex gap-2 border-t border-ink/10 pt-4 text-sm font-medium text-ink">
                <span aria-hidden="true" class="text-success">
                  ✓
                </span>
                <span>{item.value}</span>
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- The same five points as one column of engineering and one column of
         consequence, for a reader who wants the summary rather than the essay.
         A real table with scoped headers, so a screen reader announces the pair
         instead of reading eleven loose cells. -->
    <div data-reveal class="mt-16" data-i18n-key={t(locale, 'about.table')}>
      <h2 class="text-2xl font-bold">{t(locale, 'about.tableTitle')}</h2>
      <p class="mt-3 text-muted">{t(locale, 'about.tableIntro')}</p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-ink/10">
        <table class="w-full min-w-[520px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-ink/10 bg-ink/[0.03]">
              <th scope="col" class="px-5 py-4 font-semibold">{t(locale, 'about.tableFeature')}</th>
              <th scope="col" class="px-5 py-4 font-semibold">{t(locale, 'about.tableValue')}</th>
            </tr>
          </thead>
          <tbody>
            {
              table.map((row) => (
                <tr class="border-b border-ink/5 last:border-0">
                  <th scope="row" class="px-5 py-4 font-normal text-muted">
                    {row.feature}
                  </th>
                  <td class="px-5 py-4 font-medium text-ink">{row.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- The goal, set apart from the surrounding cards: it is the one paragraph
         on the page that is about intent rather than mechanism. -->
    <div data-reveal class="mt-16 rounded-2xl border border-primary/30 bg-primary/[0.04] p-8 sm:p-10">
      <h2 class="text-2xl font-bold">{t(locale, 'about.goalTitle')}</h2>
      <p class="mt-4 text-lg font-medium leading-relaxed text-ink">
        {t(locale, 'about.goalStatement')}
      </p>
      <p class="mt-3 text-sm leading-relaxed text-muted">{t(locale, 'about.goalBody')}</p>
    </div>

    <div data-reveal class="mt-16" data-i18n-key={t(locale, 'about.promises')}>
      <h2 class="text-2xl font-bold">{t(locale, 'about.promisesTitle')}</h2>
      <p class="mt-3 text-muted">{t(locale, 'about.promisesIntro')}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          promises.map((promise) => (
            <article class="rounded-xl border border-ink/10 bg-surface/40 p-6">
              <h3 class="flex gap-2 text-base font-semibold text-ink">
                <span aria-hidden="true" class="text-success">
                  ✓
                </span>
                <span>{promise.title}</span>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{promise.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div data-reveal class="mt-16 rounded-2xl border border-ink/10 bg-surface/60 p-8 text-center sm:p-10">
      <h2 class="text-2xl font-bold">{t(locale, 'about.closingTitle')}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted">{t(locale, 'about.closingBody')}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={downloadHref}
          class="rounded-md bg-primary px-6 py-3 font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
        >
          {t(locale, 'hero.ctaPrimary')}
        </a>
        <a
          href={pricingHref}
          class="rounded-md border border-ink/15 px-6 py-3 font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
        >
          {t(locale, 'hero.ctaSecondary')}
        </a>
        <a
          href={contactHref}
          class="rounded-md border border-ink/15 px-6 py-3 font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
        >
          {t(locale, 'about.contactCta')}
        </a>
      </div>
    </div>
  </section>
</Base>
