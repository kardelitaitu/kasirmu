---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { toSearchDocs } from '../../../lib/search-index';
import { t, dict } from '../../../i18n';

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}

// The dev portal (docs-portal/) is generated at build time from docs/book/
// (scripts/import-portal.sh) and is absent when that source isn't built — e.g.
// a CI checkout without the portal step. Only render its cards when the files
// actually exist so the hub never links to 404s (the build degrades to just
// the Get Started card instead).

const locale = Astro.params.locale ?? 'en';
const allDocs = await getCollection('docs');
const docs = allDocs.filter((d) => d.id.startsWith(`${locale}/`));
// The docs hub is a docs page too (it renders through `Base`, not
// `DocsLayout`), so it builds the header's search payload the same way every
// docs page does — the payload is unchanged, only its owner moved here.
const searchDocs = toSearchDocs(allDocs, locale);
// The first Getting Started doc is where the user-facing guide begins.
const first = docs
  .filter((d) => d.data.category === 'gettingStarted')
  .sort((a, b) => a.data.order - b.data.order)[0];
// Trailing slash matters: the built page lives at /<locale>/docs/<slug>/, and a
// link without it costs every visitor and every crawler a 307 hop to the
// canonical URL the sitemap declares. Keep this in step with the docs links in
// src/content/docs/*/api-read-tiers.md.
const guideTarget = first
  ? `/${locale}/docs/${first.id.slice(locale.length + 1)}/`
  : `/${locale}/`;

// The dev portal (mdBook) is English-only and served from public/ verbatim —
// the same targets apply for both locales. See scripts/import-portal.sh.
const portalExists = fs.existsSync(
  new URL('../../../public/docs-portal/intro.html', import.meta.url),
);
const hubCards = (dict(locale).docs as { hub: { cards: { title: string; description: string; cta: string }[] } })
  .hub.cards;
// portalExists gates the 3 portal cards; Get Started (index 0) always shows.
const cards = portalExists ? hubCards : hubCards.slice(0, 1);
const targets = [
  guideTarget,
  '/docs-portal/intro.html',
  '/docs-portal/api/rust/',
  '/docs-portal/api/ts/',
];
const subtitle = t(locale, 'docs.hub.subtitle');
---

<Base title={`kasir.mu — ${t(locale, 'docs.title')}`} description={subtitle} searchDocs={searchDocs}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'docs.title')}</h1>
      <p class="mt-3 text-muted">{subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2" data-i18n-key={t(locale, 'docs.hub.cards')}>
      {
        cards.map((card, i) => (
          <a
            href={targets[i]}
            class="group flex flex-col rounded-2xl border border-ink/10 bg-surface/40 p-6 transition hover:border-link/40 hover:shadow-lg"
          >
            <h2 class="text-xl font-bold">{card.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{card.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-link">
              {card.cta}
              <svg
                aria-hidden="true"
                class="h-4 w-4 transition group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
