---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const legal = await getCollection('legal');
  return ['en', 'id'].map((locale) => {
    const doc = legal.find((d) => d.id === `${locale}/privacy`);
    if (!doc) throw new Error(`missing legal/privacy content for locale ${locale}`);
    return { params: { locale }, props: { doc } };
  });
}

const { doc } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const pageTitle = `kasir.mu — ${t(locale, 'legal.privacyTitle')}`;
const { Content } = await render(doc);
---

<Base title={pageTitle} description={t(locale, 'pageDesc.privacy')}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold">{t(locale, 'legal.privacyTitle')}</h1>
    {doc.data.effective && doc.data.version && (
      <p class="mt-3 text-xs text-muted">
        {t(locale, 'legal.effective')} {doc.data.effective} · {t(locale, 'legal.version')} {doc.data.version}
      </p>
    )}
    <div class="docs-content mt-8" data-i18n-key={t(locale, 'legal.placeholder')}>
      <Content />
    </div>
  </section>
</Base>
