---
export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "id" } }];
}
import Base from "../../layouts/Base.astro";
import LandingPage from "../../components/LandingPage.astro";
import { t } from "../../i18n";

const locale = Astro.currentLocale ?? "en";
---

<Base title={`kasir.mu — ${t(locale, "landing.murah.title")}`} description={t(locale, "landing.murah.description")}>
  <LandingPage landing="murah" />
</Base>
