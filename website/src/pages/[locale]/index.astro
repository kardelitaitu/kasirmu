---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import PricingPreviewCard from '../../components/PricingPreviewCard.astro';
import { t, dict } from '../../i18n';
import { pricingFor } from '../../content/pricing';
import { getRelativeLocaleUrl } from 'astro:i18n';
// Tech-stack logos (order = left to right on the home page).
import rustLogo from '../../assets/logo-rust.svg?url';
import tauriLogo from '../../assets/logo-tauri.svg?url';
import paddleLogo from '../../assets/logo-paddle.svg?url';
import midtransLogo from '../../assets/logo-midtrans.svg?url';
import trivyLogo from '../../assets/logo-trivy.svg?url';
import postgresLogo from '../../assets/logo-postgresql.svg?url';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'hero.title')}`;
const features = (dict(locale).features as { items: { title: string; description: string }[] }).items;
const pricing = pricingFor(locale).slice(0, 3); // free, plus, pro
const download = getRelativeLocaleUrl(locale, 'download');
const pricingHref = getRelativeLocaleUrl(locale, 'pricing');
// Tech-stack logos shown after the features grid.
// Tech-stack logos shown after the features grid.
// Tightened aspect ratios (width/height) and optical heights so all logos
// align with uniform visual weight.
const techStack = [
  { name: 'Rust', src: rustLogo, ratio: 540 / 201, height: '1.35rem' },
  { name: 'Tauri', src: tauriLogo, ratio: 432 / 137, height: '1.35rem' },
  { name: 'Paddle', src: paddleLogo, ratio: 430.9 / 132.6, height: '1.6rem' },
  { name: 'Midtrans', src: midtransLogo, ratio: 185 / 30, height: '1.5rem' },
  { name: 'Trivy', src: trivyLogo, ratio: 1581 / 691, height: '1.5rem' },
  { name: 'PostgreSQL', src: postgresLogo, ratio: 1308.7 / 174.4, height: '1.25rem' },
];
---

<Base title={pageTitle}>
  <Hero />

  <!-- Features -->
  <section data-reveal class="mx-auto max-w-6xl px-4 py-16" aria-label={t(locale, 'features.title')}>
    <div class="text-center">
      <h2 class="text-3xl font-bold">{t(locale, 'features.title')}</h2>
      <p class="mt-2 text-muted">{t(locale, 'features.subtitle')}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-xl border border-ink/10 bg-surface/40 p-6">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted">{f.description}</p>
          </div>
        ))
      }
    </div>

    <!-- Tech stack logos inside features area -->
    <div class="mt-12">
      <p class="text-center text-sm text-muted">{t(locale, 'techStack.subtitle')}</p>
      <!-- Locked to 6x1 at lg and up, 3x2 below. The breakpoint is arithmetic,
           not taste: each logo's width is height * ratio from `techStack`
           above, so the six sum to 621px and need 821px with 2.5rem gaps. The
           section is max-w-6xl minus px-4, giving 992px at lg (fits) but only
           736px at md (overflows by 85px) — hence lg, not md.
           Tracks are max-content rather than grid-cols-6 because PostgreSQL is
           180px wide while six equal columns of the 1120px container are 153px
           each, which would squeeze it; max-content sizes each column to its
           own logo and lg:justify-center centres the group. -->
      <div class="mt-6 grid grid-cols-3 items-center justify-items-center gap-x-6 gap-y-6 lg:grid-cols-[repeat(6,max-content)] lg:justify-center lg:gap-x-10">
        {techStack.map((logo) => (
          <span
            class="opacity-70 transition-opacity duration-200 hover:opacity-100 flex-shrink-0"
            style={{
              display: 'inline-block',
              height: logo.height,
              backgroundColor: 'var(--color-muted)',
              aspectRatio: String(logo.ratio),
              width: `calc(${logo.height} * ${logo.ratio})`,
              maxWidth: '100%',
              WebkitMaskImage: `url("${logo.src}")`,
              WebkitMaskSize: 'contain',
              WebkitMaskRepeat: 'no-repeat',
              WebkitMaskPosition: 'center',
              maskImage: `url("${logo.src}")`,
              maskSize: 'contain',
              maskRepeat: 'no-repeat',
              maskPosition: 'center',
            }}
            aria-label={logo.name}
            role="img"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing preview -->
  <section data-reveal class="mx-auto max-w-6xl px-4 py-16" aria-label={t(locale, 'pricingPreview.title')}>
    <div class="text-center">
      <h2 class="text-3xl font-bold">{t(locale, 'pricingPreview.title')}</h2>
      <p class="mt-2 text-muted">{t(locale, 'pricingPreview.subtitle')}</p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {pricing.map((tier) => <PricingPreviewCard tier={tier} locale={locale} />)}
    </div>
    <div class="mt-8 text-center">
      <a href={pricingHref} class="text-sm font-semibold text-link hover:underline">
        {t(locale, 'pricingPreview.viewAll')} →
      </a>
    </div>
  </section>

  <!-- CTA banner -->
  <section data-reveal class="mx-auto max-w-6xl px-4 pb-20">
    <div class="rounded-2xl border border-accent/30 bg-surface/60 px-6 py-14 text-center">
      <h2 class="text-3xl font-bold">{t(locale, 'ctaBanner.title')}</h2>
      <p class="mt-3 text-muted">{t(locale, 'ctaBanner.subtitle')}</p>
      <a
        href={download}
        class="cta-btn mt-8 inline-block rounded-md bg-accent px-6 py-3 font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t(locale, 'ctaBanner.cta')}
      </a>
    </div>
  </section>
</Base>
