---
/**
 * One guide: `/id/panduan/<slug>/`, `/en/guides/<slug>/`.
 *
 * Deliberately built on Base rather than DocsLayout: a guide is editorial
 * content, not product documentation, so it gets the marketing page's
 * structured data (SoftwareApplication/Organization/WebSite) plus the two
 * blocks an article owes (BreadcrumbList + Article), and no docs sidebar.
 *
 * The commercial-parent link the gate demands is authored IN the markdown, not
 * emitted here. A template CTA at the end of every guide would be one more
 * block identical on every page; a sentence inside the article that says why
 * the reader should go there is the link that actually earns the click.
 * scripts/check-seo.mjs check 15 is what stops an author forgetting it.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { locales, t } from '../../../i18n';
import { guideSegment as segmentFor, guideAlternatePath } from '../../../lib/guides';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return locales.flatMap((locale) =>
    guides
      .filter((entry) => entry.id.startsWith(`${locale}/`))
      .map((entry) => ({
        params: {
          locale,
          guideSegment: segmentFor(locale),
          slug: entry.id.slice(locale.length + 1),
        },
        props: { guide: entry },
      })),
  );
}

const { guide } = Astro.props;
const locale = Astro.params.locale ?? 'en';
const slug = guide.id.slice(locale.length + 1);
const { Content } = await render(guide);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const hubUrl = new URL(`/${locale}/${segmentFor(locale)}/`, Astro.site).toString();
// Counterparts only: this page's own hreflang entry must stay the path it
// computed for itself. `pair` carries the other locale's slug when the two
// titles are not the same words.
const counterpartSlug = guide.data.pair ?? slug;
const alternatePaths = Object.fromEntries(
  locales.filter((code) => code !== locale).map((code) => [code, guideAlternatePath(code, counterpartSlug)]),
);
---

<Base
  title={`kasir.mu — ${guide.data.title}`}
  description={guide.data.description}
  locale={locale}
  alternatePaths={alternatePaths}
  ogType="article"
  articleUpdatedAt={guide.data.updated}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "kasir.mu", "item": "https://kasir.mu/" },
      { "@type": "ListItem", "position": 2, "name": t(locale, 'guides.hubHeading'), "item": hubUrl },
      { "@type": "ListItem", "position": 3, "name": guide.data.title }
    ]
  })} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": guide.data.title,
    "description": guide.data.description,
    "inLanguage": locale,
    "image": new URL('/og-image.png', Astro.site).toString(),
    "mainEntityOfPage": canonical,
    ...(guide.data.updated ? { "dateModified": guide.data.updated } : {}),
    "author": { "@type": "Organization", "name": "kasir.mu", "url": "https://kasir.mu" },
    "publisher": {
      "@type": "Organization",
      "name": "kasir.mu",
      "logo": { "@type": "ImageObject", "url": new URL('/og-image.png', Astro.site).toString() }
    }
  })} />
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{guide.data.title}</h1>
    {guide.data.updated && (
      <p class="mt-2 text-sm text-muted">
        {t(locale, 'guides.updated')}: <time datetime={guide.data.updated}>{guide.data.updated}</time>
      </p>
    )}
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</Base>
