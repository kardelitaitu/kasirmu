---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
/**
 * Media kit — the page a journalist, a reviewer, or a partner lands on.
 *
 * It answers the three things that page is opened for, in the order they are
 * needed: how to write the name, what to say about the product (a one-line and
 * a one-paragraph description, ready to paste), and what to download.
 *
 * Every asset linked here is one the site ALREADY serves — the brand mark that
 * backs the favicon and the social share card — rather than a second copy of
 * `assets/branding/default/vector/`. That directory is the origin those files
 * are synced FROM (`scripts/sync-branding.ps1` overwrites its destinations), so
 * a hand-copied duplicate under `website/public/` would silently drift the
 * first time the brand is re-exported. The page says where to ask for the rest
 * instead of pointing at files that may not exist.
 *
 * The colours are the real tokens from `src/styles/global.css`
 * (`--color-primary`, `--color-accent`, `--color-ink`, `--color-surface`),
 * spelled as hex because a third party cannot use a CSS custom property.
 */
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, dict } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
// The page's NAME is the same two words in both locales ("Media Kit" is the
// term Indonesian press contacts use), so a title composed from it would be
// byte-identical on /en/media-kit/ and /id/media-kit/ — and
// `scripts/check-seo.mjs` fails a duplicate <title> site-wide, because two
// results with one title are one result to a searcher. The document title
// therefore names what the page holds; the <h1> stays the plain page name.
const pageTitle = `kasir.mu — ${t(locale, 'mediaKit.docTitle')}`;

interface MediaKitCopy {
  usageDo: string[];
  usageDont: string[];
}

const copy = dict(locale).mediaKit as MediaKitCopy;

// The design-system tokens: values live here, labels in the dictionary.
const COLORS = [
  { label: t(locale, 'mediaKit.colorPrimary'), hex: '#1170EC', swatch: 'bg-[#1170EC]' },
  { label: t(locale, 'mediaKit.colorAccent'), hex: '#FECB2E', swatch: 'bg-[#FECB2E]' },
  { label: t(locale, 'mediaKit.colorInk'), hex: '#1A1D23', swatch: 'bg-[#1A1D23]' },
  {
    label: t(locale, 'mediaKit.colorSurface'),
    hex: '#FFFFFF',
    swatch: 'bg-[#FFFFFF] border border-ink/10',
  },
];

const contactHref = getRelativeLocaleUrl(locale, 'contact');
---

<Base title={pageTitle} description={t(locale, 'pageDesc.mediaKit')}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold sm:text-5xl">{t(locale, 'mediaKit.title')}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">{t(locale, 'mediaKit.subtitle')}</p>
    </div>

    <div data-reveal class="mt-14 rounded-2xl border border-ink/10 bg-surface/40 p-6 sm:p-8">
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.nameTitle')}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">{t(locale, 'mediaKit.nameBody')}</p>
    </div>

    <div data-reveal class="mt-10" data-i18n-key={t(locale, 'mediaKit.boilerplateShort')}>
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.boilerplateTitle')}</h2>
      <div class="mt-5 space-y-4">
        <div class="rounded-xl border border-ink/10 bg-surface/40 p-5">
          <p class="text-xs font-semibold uppercase tracking-wider text-muted">
            {t(locale, 'mediaKit.boilerplateShortTitle')}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-ink">{t(locale, 'mediaKit.boilerplateShort')}</p>
        </div>
        <div class="rounded-xl border border-ink/10 bg-surface/40 p-5">
          <p class="text-xs font-semibold uppercase tracking-wider text-muted">
            {t(locale, 'mediaKit.boilerplateLongTitle')}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-ink">{t(locale, 'mediaKit.boilerplateLong')}</p>
        </div>
      </div>
    </div>

    <!-- The two assets the site itself serves. Each is previewed at the size a
         reader will use it and downloadable from the same card. -->
    <div data-reveal class="mt-14">
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.assetsTitle')}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">{t(locale, 'mediaKit.assetsIntro')}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col rounded-xl border border-ink/10 bg-surface/40 p-5">
          <div class="flex items-center gap-4">
            <img
              src="/favicon.svg"
              alt={t(locale, 'mediaKit.previewAlt')}
              width="64"
              height="64"
              class="h-16 w-16 rounded-lg"
            />
            <div>
              <p class="font-semibold text-ink">{t(locale, 'mediaKit.assetMark')}</p>
              <p class="mt-1 text-xs text-muted">{t(locale, 'mediaKit.assetMarkNote')}</p>
            </div>
          </div>
          <a
            href="/favicon.svg"
            download
            class="mt-5 w-fit rounded-md border border-ink/15 px-4 py-2 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-ink/5"
          >
            {t(locale, 'mediaKit.download')}
          </a>
        </div>
        <div class="flex flex-col rounded-xl border border-ink/10 bg-surface/40 p-5">
          <img
            src="/og-image.svg"
            alt={t(locale, 'mediaKit.socialPreviewAlt')}
            width="1200"
            height="630"
            class="h-16 w-full rounded-lg border border-ink/10 object-cover"
          />
          <p class="mt-4 font-semibold text-ink">{t(locale, 'mediaKit.assetSocial')}</p>
          <p class="mt-1 text-xs text-muted">{t(locale, 'mediaKit.assetSocialNote')}</p>
          <a
            href="/og-image.png"
            download
            class="mt-5 w-fit rounded-md border border-ink/15 px-4 py-2 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-ink/5"
          >
            {t(locale, 'mediaKit.download')}
          </a>
        </div>
      </div>
    </div>

    <div data-reveal class="mt-14">
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.colorsTitle')}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">{t(locale, 'mediaKit.colorsIntro')}</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          COLORS.map((color) => (
            <li class="flex items-center gap-4 rounded-xl border border-ink/10 bg-surface/40 p-4">
              <span class={`h-10 w-10 shrink-0 rounded-lg ${color.swatch}`} aria-hidden="true" />
              <span class="flex flex-col">
                <span class="text-sm font-semibold text-ink">{color.label}</span>
                {/* The value a third party copies — a literal, not prose. */}
                <span class="font-mono text-xs text-muted">{color.hex}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div data-reveal class="mt-14">
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.typoTitle')}</h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">{t(locale, 'mediaKit.typoBody')}</p>
    </div>

    <div data-reveal class="mt-14">
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.usageTitle')}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div data-i18n-key={t(locale, 'mediaKit.usageDo')} class="rounded-xl border border-ink/10 bg-surface/40 p-5">
          <h3 class="flex items-center gap-2 font-semibold text-ink">
            <span aria-hidden="true" class="text-success">✓</span>
            {t(locale, 'mediaKit.usageDoTitle')}
          </h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
            {copy.usageDo.map((rule) => <li>{rule}</li>)}
          </ul>
        </div>
        <div
          data-i18n-key={t(locale, 'mediaKit.usageDont')}
          class="rounded-xl border border-ink/10 bg-surface/40 p-5"
        >
          <h3 class="flex items-center gap-2 font-semibold text-ink">
            <span aria-hidden="true" class="text-danger">✗</span>
            {t(locale, 'mediaKit.usageDontTitle')}
          </h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
            {copy.usageDont.map((rule) => <li>{rule}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div data-reveal class="mt-14 rounded-2xl border border-ink/10 bg-surface/60 p-8 text-center sm:p-10">
      <h2 class="text-xl font-bold">{t(locale, 'mediaKit.contactTitle')}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        {t(locale, 'mediaKit.contactBody')}
      </p>
      <a
        href={contactHref}
        class="mt-6 inline-block rounded-md bg-primary px-6 py-3 font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t(locale, 'mediaKit.contactCta')}
      </a>
    </div>
  </section>
</Base>
