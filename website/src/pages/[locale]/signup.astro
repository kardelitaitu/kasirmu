---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import SignupForm, { SIGNUP_FORM_LABELS } from '../../components/SignupForm.tsx';
import { labelMap, t } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
// The island's strings travel with the document, so the browser never loads a
// locale dictionary (see src/i18n/labels.ts).
const formLabels = labelMap(locale, SIGNUP_FORM_LABELS);
const pageTitle = `kasir.mu — ${t(locale, 'signup.title')}`;
---

<Base title={pageTitle} description={t(locale, 'pageDesc.signup')} noindex>
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div data-reveal class="mb-10 text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'signup.title')}</h1>
      <p class="mx-auto mt-3 max-w-md text-muted">{t(locale, 'signup.subtitle')}</p>
    </div>
    <div data-reveal>
      <SignupForm client:load locale={locale} labels={formLabels} />
    </div>
  </section>
</Base>
