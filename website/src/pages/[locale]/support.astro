---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { t, dict } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `kasir.mu — ${t(locale, 'support.title')}`;
const faq = (dict(locale).support as { faq: { q: string; a: string }[] }).faq;
const email = t(locale, 'support.email');
---

<Base title={pageTitle} description={t(locale, 'pageDesc.support')}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'support.title')}</h1>
      <p class="mt-3 text-muted">{t(locale, 'support.subtitle')}</p>
    </div>

    <div data-reveal class="mx-auto mt-10 max-w-2xl">
      <ContactForm client:load locale={locale} />
      <p class="mt-4 text-center text-sm text-muted">
        {t(locale, 'support.emailLabel')}:{' '}
        <a href={`mailto:${email}`} class="footer-link relative text-link transition-colors duration-200 hover:text-primary-hover">
          {email}
          <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
        </a>
      </p>
    </div>

    <div data-reveal class="mt-14" data-i18n-key={t(locale, 'support.faq')}>
      <h2 class="text-2xl font-bold">{t(locale, 'support.faqTitle')}</h2>
      <div class="mt-6 space-y-3">
        {
          faq.map((item, i) => (
            <details
              class="faq-item group rounded-xl border border-ink/10 bg-surface/40 transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)] hover:border-ink/20"
              style={`transition-delay: ${i * 50}ms`}
            >
              <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-medium transition-colors duration-200 hover:text-link [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <svg
                  class="h-5 w-5 text-muted transition-transform duration-200 ease-[cubic-bezier(0.2,0,0,1)] group-open:rotate-180"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="faq-answer overflow-hidden transition-all duration-350 ease-[cubic-bezier(0.2,0,0,1)]">
                <p class="px-5 pb-4 text-sm leading-relaxed text-muted">{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a },
    })),
  })} />
</Base>
