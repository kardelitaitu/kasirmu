---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import { t, dict } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
// The dictionary value already names the brand ("Unduh kasir.mu" / "Download
// kasir.mu"), so it is the whole title — prefixing it produced
// "kasir.mu — Unduh kasir.mu" on the same search result.
const pageTitle = t(locale, 'download.title');
const releaseUrl = 'https://github.com/kardelitaitu/kasirmu/releases';
// Only Windows ships today; the other four are on the roadmap and render a
// "coming soon" badge instead of a download link. Flip `ready` to true when
// a platform's installers start publishing (website-plan.md §8).
type Platform = 'windows' | 'macos' | 'linux' | 'android' | 'ios';
const platforms: { name: string; label: string; platform: Platform; ready: boolean }[] = [
  { name: 'Windows', label: 'Windows 10/11', platform: 'windows', ready: true },
  { name: 'macOS', label: 'macOS 12+', platform: 'macos', ready: false },
  { name: 'Linux', label: 'Linux (glibc 2.31+)', platform: 'linux', ready: false },
  { name: 'Android', label: 'Android (Tablets & phones)', platform: 'android', ready: false },
  { name: 'iOS', label: 'iOS (Tablets & phones)', platform: 'ios', ready: false },
];
const reqList = (dict(locale).download as { requirements: string[] }).requirements;
// The three-step stepper was the last block on this page carrying inline
// `locale === 'id' ? … : …` copy, which `audit-i18n.mjs` cannot see: a string
// that is not in the dictionary cannot be found missing from it. It is data
// now, and the number beside each step is its position rather than a literal.
const steps = (dict(locale).download as { steps: { title: string; body: string }[] }).steps;
// Segmented-trial callout copy (C2.1): revealed client-side when the URL
// carries a vertical (?v=kafe / ?v=restoran / ?v=enterprise_referral).
const trialProText = t(locale, 'download.trialCallout');
const trialEnterpriseText = t(locale, 'download.trialCalloutEnterprise');
---

<Base title={pageTitle} description={t(locale, 'pageDesc.download')}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'download.title')}</h1>
      <p class="mt-3 text-muted">{t(locale, 'download.subtitle')}</p>
      <!-- Segmented-trial callout (C2.1): hidden until the client-side
           script sees a vertical landing-page param (?v=...). The localized
           copy rides in data-* attributes so the inline script needs no
           Astro expression interpolation. -->
      <p
        id="trial-callout"
        data-pro={trialProText}
        data-enterprise={trialEnterpriseText}
        class="mx-auto mt-6 hidden max-w-2xl rounded-xl border border-accent/40 bg-surface/60 p-4 text-sm"
        role="status"
      ></p>
      <script is:inline>
        (() => {
          const el = document.getElementById('trial-callout');
          if (!el) return;
          const v = new URLSearchParams(window.location.search).get('v') ?? '';
          const key = v.trim().toLowerCase();
          const pro = ['kafe', 'restoran', 'restaurant', 'cafe'].includes(key);
          const enterprise = key === 'enterprise_referral';
          if (!pro && !enterprise) return;
          el.textContent = pro ? (el.dataset.pro ?? '') : (el.dataset.enterprise ?? '');
          el.classList.remove('hidden');
        })();
      </script>
    </div>

    <h2 data-reveal class="mt-14 text-lg font-semibold">{t(locale, 'download.platformsTitle')}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        platforms.map((p, i) => (
          <div
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
            class="platform-card group flex flex-col rounded-xl border border-ink/10 bg-surface/40 p-6 text-center transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)] hover:border-ink/20 hover:shadow-md hover:-translate-y-0.5"
          >
            <div class="transition-transform duration-200 ease-[cubic-bezier(0.2,0,0,1)] group-hover:scale-110">
              <PlatformIcon platform={p.platform} class="mx-auto h-10 w-10" />
            </div>
            <h3 class="mt-3 font-semibold transition-colors duration-200 group-hover:text-link">{p.label}</h3>
            <div class="mt-auto pt-5">
              {p.ready ? (
                <a
                  href={releaseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-11 w-full items-center justify-center rounded-md bg-accent px-4 text-sm font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
                >
                  {t(locale, 'download.title')} — {p.name}
                </a>
              ) : (
                <span
                  class="flex h-11 w-full items-center justify-center rounded-md border border-ink/10 px-4 text-sm font-semibold text-muted"
                  aria-hidden="true"
                >
                  {t(locale, 'download.comingSoon')}
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2">
      <section data-reveal aria-label={t(locale, 'download.version')}>
        <h2 class="text-lg font-semibold">{t(locale, 'download.version')}</h2>
        <p class="mt-3 font-mono text-2xl">{t(locale, 'download.versionValue')}</p>
        <p class="mt-4 text-sm text-muted">{t(locale, 'download.note')}</p>
        <a
          href={releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link relative mt-2 inline-block text-sm font-semibold text-link transition-colors duration-200 hover:text-primary-hover"
        >
          {t(locale, 'download.releaseLink')} →
          <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
        </a>
      </section>
      <section data-reveal aria-label={t(locale, 'download.requirementsTitle')}>
        <h2 class="text-lg font-semibold">{t(locale, 'download.requirementsTitle')}</h2>
        <ul class="mt-3 list-inside list-disc space-y-1 text-sm text-muted" data-i18n-key={t(locale, 'download.requirements')}>
          {reqList.map((r) => <li>{r}</li>)}
        </ul>
      </section>
    </div>

    <!-- Visual 3-Step Setup Stepper -->
    <div data-reveal class="mt-16 rounded-2xl border border-ink/10 bg-surface/50 p-8 shadow-sm">
      <h2 class="text-center text-xl font-bold">{t(locale, 'download.stepsTitle')}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <div class="flex flex-col items-center text-center p-4 rounded-xl bg-surface border border-ink/5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-on-primary font-bold text-sm">
                {i + 1}
              </div>
              <h3 class="mt-3 font-semibold text-ink">{step.title}</h3>
              <p class="mt-1 text-xs text-muted leading-relaxed">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
