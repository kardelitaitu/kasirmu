---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import PricingGrid, { PRICING_LABELS } from '../../components/PricingGrid.tsx';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { labelMap, t } from '../../i18n';
import { pricing as enPricing, featureRows as enRows } from '../../content/pricing/en';
import { pricing as idPricing, featureRows as idRows } from '../../content/pricing/id';
import { schemaPrice } from '../../lib/schema-price';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `kasir.mu — ${t(locale, 'pricingPage.title')}`;
const pricing = locale === 'id' ? idPricing : enPricing;
const rows = locale === 'id' ? idRows : enRows;
// schema.org `Offer.price` must be a NUMBER, but the tier cards render a
// display string ('$4.99' / 'Rp 1.000.000' / 'Custom'). Emitting the display
// string produced invalid offers ("price":"$0", "price":"Custom") that Google
// drops, taking the Product rich result with them. Convert here and simply
// omit the tiers that have no numeric price (Enterprise is quote-only) — an
// absent offer is better than a wrong price. See lib/schema-price.ts.
const offers = pricing.flatMap((tier) => {
  const price = schemaPrice(tier.prices.monthly.price, tier.currency);
  if (price === undefined) return [];
  return [{
    '@type': 'Offer',
    name: tier.name,
    price,
    priceCurrency: tier.currency,
    description: tier.description,
  }];
});
const downloadHref = getRelativeLocaleUrl(locale, 'download');
const contactHref = 'mailto:adikaradwiatmaja@gmail.com';
// The island's strings travel with the document, so the browser never loads a
// locale dictionary (see src/i18n/labels.ts).
const gridLabels = labelMap(locale, PRICING_LABELS);
---

<Base title={pageTitle} description={t(locale, 'pageDesc.pricing')} offerPrice={locale === 'id' ? '49000' : '4.99'} offerCurrency={locale === 'id' ? 'IDR' : 'USD'}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "kasir.mu",
    "description": t(locale, 'pricingPage.subtitle'),
    "brand": { "@type": "Brand", "name": "kasir.mu" },
    "url": new URL(Astro.url.pathname, Astro.site).toString(),
    "image": new URL('/og-image.png', Astro.site).toString(),
    "offers": offers
  })} />
  <section class="mx-auto max-w-7xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'pricingPage.title')}</h1>
      <p class="mx-auto mt-3 max-w-2xl text-muted">{t(locale, 'pricingPage.subtitle')}</p>
    </div>

    <div data-reveal>
      <PricingGrid
        client:load
        tiers={pricing}
        locale={locale}
        labels={gridLabels}
        downloadHref={downloadHref}
        contactHref={contactHref}
      />
    </div>

    <div data-reveal class="mt-6 flex flex-wrap justify-center gap-6 text-sm text-muted">
      <span class="flex items-center gap-2 transition-colors duration-200 hover:text-ink">
        <span class="text-success">✓</span> {t(locale, 'pricingPage.trust1')}
      </span>
      <span class="flex items-center gap-2 transition-colors duration-200 hover:text-ink">
        <span class="text-success">✓</span> {t(locale, 'pricingPage.trust2')}
      </span>
    </div>

    <div data-reveal class="mt-16">
      <FeatureTable rows={rows} columns={pricing} />
    </div>

    <p data-reveal class="mt-6 text-center text-xs text-muted">{t(locale, 'pricingPage.note')}</p>
  </section>
</Base>
