---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

// The root 404 is locale-agnostic; default to EN and offer both locales.
//
// `locale` is passed to Base as well as used for the copy, because the two
// must agree: this page is served at the locale-less /404 path, so `Base`
// would otherwise fall back to the site default (`id`) and emit
// `<html lang="id">` around English text — a document that lies about its own
// language to screen readers, translations and search engines. Measured live
// before this: HTTP 404, `<html lang="id">`, `<h1>Page not found</h1>`.
const locale = 'en';
---

<Base title="404 — kasir.mu" locale={locale}>
  <section class="mx-auto max-w-6xl px-4 py-24 text-center">
    <div data-reveal>
      <p class="text-7xl font-bold text-accent">404</p>
    </div>
    <div data-reveal style="transition-delay: 100ms">
      <h1 class="mt-4 text-2xl font-semibold">{t(locale, 'notFound.title')}</h1>
    </div>
    <div data-reveal style="transition-delay: 200ms">
      <p class="mt-2 text-muted">{t(locale, 'notFound.subtitle')}</p>
    </div>
    <div data-reveal style="transition-delay: 300ms" class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/en/"
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t(locale, 'notFound.home')}
      </a>
      <a
        href="/id/"
        class="rounded-md border border-ink/15 px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
      >
        Bahasa Indonesia
      </a>
    </div>
  </section>
</Base>
