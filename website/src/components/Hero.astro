---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import HeroCarousel from './HeroCarousel.astro';

const locale = Astro.currentLocale ?? 'en';
const download = getRelativeLocaleUrl(locale, 'download');
const pricing = getRelativeLocaleUrl(locale, 'pricing');
const carouselLabels = {
  restaurant: t(locale, 'hero.carousel.restaurant'),
  retail: t(locale, 'hero.carousel.retail'),
  kitchen: t(locale, 'hero.carousel.kitchen'),
  warehouse: t(locale, 'hero.carousel.warehouse'),
  topology: t(locale, 'hero.carousel.topology'),
} as const;
const carouselDescriptions = {
  restaurant: t(locale, 'hero.carousel.restaurantDesc'),
  retail: t(locale, 'hero.carousel.retailDesc'),
  kitchen: t(locale, 'hero.carousel.kitchenDesc'),
  warehouse: t(locale, 'hero.carousel.warehouseDesc'),
  topology: t(locale, 'hero.carousel.topologyDesc'),
} as const;
const carouselComingSoon = t(locale, 'hero.carousel.screenshotComingSoon');
---

<section class="mx-auto max-w-7xl px-4 pb-16 pt-20 text-center sm:pt-28">
  <div class="mb-6 inline-flex items-center justify-center">
    <div style="display: inline-flex; align-items: center; background: rgba(255, 74, 0, 0.1); border: 1px solid rgba(255, 74, 0, 0.3); color: #ff4a00; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 9999px; gap: 6px; user-select: none;">
      <!-- YC-style Orange Dot -->
      <span style="width: 6px; height: 6px; background-color: #ff4a00; border-radius: 50%;"></span>
      <span>Not backed by Y Combinator</span>
    </div><span style="opacity: 0.5; margin-left: 6px; font-size: 14px; vertical-align: middle;">😎</span>
  </div>
  <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
    {t(locale, 'hero.title')}
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">{t(locale, 'hero.subtitle')}</p>
  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      href={download}
      class="rounded-md bg-primary px-6 py-3 text-base font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-primary-hover hover:scale-[1.03] active:scale-[0.97] hover:shadow-lg"
    >
      {t(locale, 'hero.ctaPrimary')}
    </a>
    <a
      href={pricing}
      class="rounded-md border border-ink/15 px-6 py-3 text-base font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
    >
      {t(locale, 'hero.ctaSecondary')}
    </a>
  </div>
  
  <!-- Hero Mockup Carousel — 5 slides (Restaurant/Retail/Kitchen/Warehouse/Topology) -->
  <div class="mt-12 mx-auto max-w-[1280px]">
    <HeroCarousel labels={carouselLabels} descriptions={carouselDescriptions} comingSoon={carouselComingSoon} />
  </div>
</section>
