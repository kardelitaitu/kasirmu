---
/**
 * Site footer: socials + copyright on the left, the sitemap and the legal
 * links on the right.
 *
 * The sitemap is DATA (`FOOTER_COLUMNS` in ../lib/footer-nav), not markup, and
 * every visible string resolves through `t(locale, …)` — including the column
 * headings and the nav's accessible name. The link text used to be written
 * into the markup as bare Indonesian words with no locale branch, so /en/
 * pages rendered "Fitur / Harga / Unduh / Warung / Kafe / …" under English
 * headings. A label key cannot drift like that: the i18n audit fails on a key
 * that is missing from either dictionary.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import { FOOTER_COLUMNS } from '../lib/footer-nav';

interface Props {
  /** Page locale, threaded down by Base so the copy matches the document. */
  locale?: string;
}

const locale = Astro.props.locale ?? Astro.currentLocale ?? 'en';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/5 bg-surface/40">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 py-8 sm:flex-row sm:items-end">
    <!-- Left: Social icons on top of Copyright -->
    <div class="flex flex-col items-center sm:items-start gap-2.5 text-center sm:text-left">
      <!-- Social links — muted → brand color on hover, monochrome currentColor glyphs.
           Each anchor is a 24×24 hit area (h-6 w-6) around its 16px glyph, so the
           pointer target meets the WCAG 2.2 target-size minimum on every page; the
           row's gap drops to 8px to keep the glyph pitch where the design had it
           (16+14 before, 24+8 now). Measured 2026-09-23: the Telegram link on
           /en/docs/ was a 16×16 target 19px from its neighbour. -->
      <div class="flex items-center gap-2">
        <a
          href="https://discord.gg/NdWDgEzNxx"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted inline-flex h-6 w-6 items-center justify-center transition-colors duration-200 hover:text-[#5865F2]"
          aria-label="Discord"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M20.317 4.369a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"/>
          </svg>
        </a>
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted inline-flex h-6 w-6 items-center justify-center transition-colors duration-200 hover:text-ink"
          aria-label="X (Twitter)"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>
          </svg>
        </a>
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted inline-flex h-6 w-6 items-center justify-center transition-colors duration-200 hover:text-[#E4405F]"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
          </svg>
        </a>
        <a
          href="https://www.facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted inline-flex h-6 w-6 items-center justify-center transition-colors duration-200 hover:text-[#1877F2]"
          aria-label="Facebook"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a
          href="https://telegram.org"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted inline-flex h-6 w-6 items-center justify-center transition-colors duration-200 hover:text-[#229ED9]"
          aria-label="Telegram"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </a>
      </div>
      <p class="text-xs text-muted">
        © {year} kasir.mu. {t(locale, 'footer.rights')}
      </p>
    </div>

    <!-- Right: Sitemap + Legal Links -->
    <div class="flex flex-col items-center gap-6 sm:items-end">
      <nav class="flex flex-wrap items-start justify-center gap-x-10 gap-y-4 text-xs sm:justify-end" aria-label={t(locale, 'footer.sitemap')}>
        {
          FOOTER_COLUMNS.map((column) => (
            <div class="flex flex-col gap-2">
              <span class="font-semibold text-ink">{t(locale, column.heading)}</span>
              {column.links.map((link) => (
                <a
                  href={getRelativeLocaleUrl(locale, link.slug)}
                  class="footer-link relative w-fit text-muted transition-colors duration-200 hover:text-ink"
                >
                  {t(locale, link.label)}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
      <nav class="flex items-center gap-6 text-xs text-muted" aria-label={t(locale, 'footer.legal')}>
        <a href={getRelativeLocaleUrl(locale, 'legal/privacy')} class="footer-link relative transition-colors duration-200 hover:text-ink">
          {t(locale, 'footer.privacy')}
          <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
        </a>
        <a href={getRelativeLocaleUrl(locale, 'legal/terms')} class="footer-link relative transition-colors duration-200 hover:text-ink">
          {t(locale, 'footer.terms')}
          <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
        </a>
      </nav>
    </div>
  </div>
</footer>
