---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, t } from '../i18n';

interface Props {
  /** Page locale, threaded down by Header so the active pill matches it. */
  locale?: string;
}

const locale = (Astro.props.locale ?? Astro.currentLocale ?? 'en') as 'en' | 'id';
const path = Astro.url.pathname.replace(/^\/(?:en|id)(?:\/|$)/, '');
const target = !path || path.replace(/^\/+/, '').startsWith('404') ? '/' : path;
const activeIndex = locales.indexOf(locale);
---

<div
  class="lang-switcher relative flex items-center rounded-lg bg-ghost-bg p-[3px]"
  role="group"
  aria-label={t(locale, 'nav.language')}
  data-active-index={activeIndex}
>
  <!-- Sliding blue pill indicator — design-language: ms-indicator -->
  <div
    class="pill absolute rounded-lg bg-primary transition-all duration-[280ms] ease-[cubic-bezier(0.33,1,0.68,1)]"
    style={`top: 3px; bottom: 3px; left: ${activeIndex === 1 ? 'calc(50% + 0.5px)' : '3px'}; width: calc(50% - 3.5px);`}
    aria-hidden="true"
  ></div>

  {
    locales.map((code, i) => (
      <a
        href={getRelativeLocaleUrl(code, target)}
        aria-current={locale === code ? 'page' : undefined}
        class:list={[
          'relative z-10 flex-1 min-w-[40px] px-3 py-[5px] rounded-lg text-[13px] font-semibold transition-colors duration-200 text-center',
          locale === code ? 'text-on-primary' : 'text-[#606470] hover:text-ink',
        ]}
        data-index={i}
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import { setPreferredLanguage } from '../lib/language';
  import { setRegion } from '../lib/region';

  function initLangSwitcher() {
    const switcher = document.querySelector('.lang-switcher') as HTMLElement | null;
    if (!switcher) return;

    const pill = switcher.querySelector('.pill') as HTMLElement | null;
    const links = switcher.querySelectorAll('a[data-index]');
    if (!pill || !links.length) return;

    function updatePillPosition(index: number) {
      const switcherRect = switcher!.getBoundingClientRect();
      const btn = links[index] as HTMLElement;
      if (!btn) return;
      const btnRect = btn.getBoundingClientRect();
      pill!.style.left = `${btnRect.left - switcherRect.left - 1}px`;
      pill!.style.width = `${btnRect.width + 2}px`;
    }

    const currentIdx = parseInt(switcher.dataset.activeIndex || '0');
    updatePillPosition(currentIdx);

    // Intercept clicks: animate pill first, then navigate after transition
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const idx = parseInt((link as HTMLElement).dataset.index || '0');
        const currentActive = parseInt(switcher!.dataset.activeIndex || '0');
        // If already on this language, do nothing
        if (idx === currentActive) {
          e.preventDefault();
          return;
        }
        // Prevent immediate navigation
        e.preventDefault();
        // Save both preferences through their owners — `oz_language` is spelled
        // in lib/language.ts and `oz_region` in lib/region.ts and nowhere else,
        // so these writes cannot name different keys than the readers do.
        const lang = idx === 0 ? 'en' : 'id';
        setPreferredLanguage(lang);
        setRegion(lang === 'id' ? 'id' : 'global');
        // Slide pill to clicked option
        switcher!.dataset.activeIndex = String(idx);
        updatePillPosition(idx);
        // Navigate after pill animation completes (280ms matches CSS transition)
        setTimeout(() => {
          const href = link.getAttribute('href');
          if (href) {
            navigate(href);
          }
        }, 280);
      });
    });
  }

  if (document.readyState !== 'loading') {
    initLangSwitcher();
  } else {
    document.addEventListener('DOMContentLoaded', initLangSwitcher);
  }
  document.addEventListener('astro:page-load', initLangSwitcher);
</script>
