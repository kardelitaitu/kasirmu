---
// Platform logo icons for the download page.
//
// Windows and Android use the real brand assets (logo-os-windows.svg,
// logo-os-android.svg) rendered via CSS mask tinted with `currentColor` by
// default — the logo's silhouette is preserved but inherits the surrounding
// text color.
//
// Android additionally reveals its real brand colours on hover
// (group-hover): a coloured <img> sits underneath the mask; when the card
// is hovered the mask fades out and the coloured logo appears.
//
// macOS renders the Apple silhouette filled with `currentColor`.
// Linux renders Tux the penguin.
// iOS stays as a hand-drawn stroke-only (outline) SVG with `currentColor`.
import windowsLogo from '../assets/logo-os-windows.svg?url';
import androidLogo from '../assets/logo-os-android.svg?url';

interface Props {
  platform: 'windows' | 'macos' | 'linux' | 'android' | 'ios';
  class?: string;
}

const { platform, class: className } = Astro.props;

// Native aspect ratio of each brand asset (width / height). Used to size
// the mask container so a wide logo (the Android wordmark) keeps its shape
// instead of being squashed into a square box.
const logoAspect: Record<string, number> = {
  windows: 1, // 1920 / 1920
  android: 1257 / 201,    // wide wordmark
};
const brandAsset: Record<string, string> = {
  windows: windowsLogo,
  android: androidLogo,
};

const applePath =
  'M10.167 3.242c.435-.523.742-1.24.742-1.958 0-.105-.008-.202-.03-.284-.704.03-1.55.47-2.06 1.069-.397.448-.772 1.173-.772 1.891 0 .112.023.217.03.254.045.008.12.015.188.015.636 0 1.43-.419 1.902-.987zm.495 1.144c-1.057 0-1.918.643-2.465.643-.591 0-1.355-.606-2.284-.606C4.168 4.423 2.4 5.866 2.4 8.58c0 1.697.652 3.49 1.46 4.642C4.557 14.193 5.164 15 6.04 15c.869 0 1.251-.575 2.33-.575 1.093 0 1.333.56 2.292.56.95 0 1.587-.867 2.18-1.727.673-.986.95-1.943.958-1.988-.053-.015-1.873-.755-1.873-2.833 0-1.794 1.431-2.6 1.513-2.66-.943-1.354-2.381-1.391-2.778-1.391z';
---

{
  brandAsset[platform] !== undefined ? (
    platform === 'android' ? (
      <span
        class={className}
        style={{
          position: 'relative',
          display: 'inline-block',
          width: '7.5rem',
          maxWidth: '100%',
          height: '2.5rem',
        }}
      >
        <img
          src={brandAsset[platform]}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-200 group-hover:opacity-100"
          style={{ objectFit: 'contain' }}
        />
        <span
          aria-hidden="true"
          class="absolute inset-0 h-full w-full transition-opacity duration-200 group-hover:opacity-0"
          style={{
            backgroundColor: 'currentColor',
            WebkitMaskImage: `url("${brandAsset[platform]}")`,
            WebkitMaskSize: 'contain',
            WebkitMaskRepeat: 'no-repeat',
            WebkitMaskPosition: 'center',
            maskImage: `url("${brandAsset[platform]}")`,
            maskSize: 'contain',
            maskRepeat: 'no-repeat',
            maskPosition: 'center',
          }}
        />
      </span>
    ) : (
      <span
        class={className}
        style={{
          display: 'inline-block',
          backgroundColor: 'currentColor',
          WebkitMaskImage: `url("${brandAsset[platform]}")`,
          WebkitMaskSize: 'contain',
          WebkitMaskRepeat: 'no-repeat',
          WebkitMaskPosition: 'center',
          maskImage: `url("${brandAsset[platform]}")`,
          maskSize: 'contain',
          maskRepeat: 'no-repeat',
          maskPosition: 'center',
          aspectRatio: String(logoAspect[platform]),
          width: 'auto',
        }}
        aria-hidden="true"
      />
    )
  ) : (
    <>
      {platform === 'windows' && (
        <svg
          viewBox="0 0 1920 1920"
          fill="currentColor"
          class={className}
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M1863.53 1016.437c31.171 0 56.47 25.299 56.47 56.47v790.589c0 16.376-7.115 31.849-19.313 42.465-10.39 9.149-23.605 14.005-37.158 14.005-2.484 0-5.082-.113-7.567-.452l-903.53-123.331c-28.008-3.84-48.903-27.784-48.903-56.02v-667.256c0-31.171 25.3-56.47 56.471-56.47Zm-1129.412 0c31.171 0 56.47 25.299 56.47 56.47v634.504c0 16.376-7.115 31.85-19.426 42.579-10.39 9.035-23.491 13.891-37.044 13.891-2.485 0-5.196-.113-7.68-.564L48.79 1669.35C20.78 1665.51 0 1641.68 0 1613.444v-540.537c0-31.171 25.299-56.47 56.47-56.47Zm-7.726-859.855c16.151-2.372 32.415 2.597 44.725 13.327 12.424 10.73 19.426 26.315 19.426 42.579V846.99c0 31.285-25.186 56.47-56.47 56.47H56.424c-31.171 0-56.47-25.185-56.47-56.47V306.455c0-28.123 20.781-52.066 48.79-55.906ZM1855.974.474c16.15-2.033 32.414 2.71 44.724 13.44 12.198 10.73 19.313 26.203 19.313 42.466v790.588c0 31.285-25.299 56.471-56.47 56.471H960.01c-31.171 0-56.47-25.186-56.47-56.47V179.711c0-28.235 20.78-52.066 48.903-55.906Z"
          />
        </svg>
      )}
      {platform === 'macos' && (
        <svg
          viewBox="0 0 16 16"
          fill="currentColor"
          class={className}
          aria-hidden="true"
        >
          <path d={applePath} />
        </svg>
      )}
      {platform === 'linux' && (
        <svg
          viewBox="0 0 16 16"
          fill="none"
          class={className}
          aria-hidden="true"
        >
          <path fill="#202020" d="M13.338 12.033c-.1-.112-.146-.319-.197-.54-.05-.22-.107-.457-.288-.61v-.001a.8.8 0 0 0-.223-.134c.252-.745.153-1.487-.1-2.157-.312-.823-.855-1.54-1.27-2.03-.464-.586-.918-1.142-.91-1.963.014-1.254.138-3.579-2.068-3.582q-.135 0-.28.012c-2.466.198-1.812 2.803-1.849 3.675-.045.638-.174 1.14-.613 1.764-.515.613-1.24 1.604-1.584 2.637-.162.487-.24.984-.168 1.454a1 1 0 0 0-.064.063c-.151.161-.263.357-.388.489-.116.116-.282.16-.464.225-.183.066-.383.162-.504.395v.001a.7.7 0 0 0-.077.339c0 .108.016.217.032.322.034.22.068.427.023.567-.144.395-.163.667-.061.865.102.199.31.286.547.335.473.1 1.114.075 1.619.342l.043-.082-.043.082c.54.283 1.089.383 1.526.284a.99.99 0 0 0 .706-.552c.342-.002.717-.146 1.318-.18.408-.032.918.145 1.503.113a.8.8 0 0 0 .068.183l.001.001c.227.455.65.662 1.1.627s.928-.301 1.315-.762l-.07-.06.07.06c.37-.448.982-.633 1.388-.878.203-.123.368-.276.38-.499s-.118-.471-.418-.805" />
          <path fill="#f8bf11" d="M13.571 12.828c-.007.137-.107.24-.29.35-.368.222-1.019.414-1.434.918-.362.43-.802.665-1.19.696s-.721-.13-.919-.526v-.002c-.123-.233-.072-.6.031-.987s.251-.785.271-1.108v-.001c.02-.415.044-.776.114-1.055.07-.28.179-.468.373-.575l.027-.014c.022.359.2.725.514.804.343.09.838-.204 1.047-.445l.122-.004c.184-.005.337.006.495.143v.001c.121.102.179.296.229.512s.09.453.239.621c.287.32.38.534.371.672m-6.979 1.015v.003c-.034.435-.28.672-.656.758-.377.086-.888 0-1.398-.266-.565-.3-1.237-.27-1.667-.36-.216-.045-.357-.113-.421-.238-.064-.126-.066-.345.071-.72v-.001l.001-.002c.068-.209.018-.438-.015-.653-.033-.214-.049-.41.024-.546l.001-.001c.094-.181.232-.246.403-.307.17-.062.373-.11.533-.27l.001-.001h.001c.148-.157.26-.353.39-.492.11-.117.22-.195.385-.196h.005a1 1 0 0 1 .093.008c.22.033.411.187.596.437l.533.971v.001c.142.296.441.622.695.954.254.333.45.666.425.921" />
          <path fill="#d6a312" d="M9.25 4.788c-.043-.084-.13-.164-.28-.225-.31-.133-.444-.142-.617-.254-.28-.181-.513-.244-.706-.244a.8.8 0 0 0-.272.047c-.236.08-.392.25-.49.342-.02.019-.044.035-.104.08-.06.043-.15.11-.28.208-.117.086-.154.2-.114.332s.167.285.4.417h.001c.145.085.244.2.358.291a.8.8 0 0 0 .189.117.8.8 0 0 0 .26.058c.248.015.43-.06.59-.151.16-.092.296-.204.452-.255h.001c.32-.1.548-.301.62-.493a.32.32 0 0 0-.008-.27" />
          <path fill="#202020" d="M8.438 5.26c-.255.133-.552.294-.869.294s-.566-.146-.745-.289c-.09-.07-.163-.142-.218-.193-.096-.075-.084-.181-.045-.178.066.008.076.095.117.134.056.052.126.12.211.187.17.135.397.266.68.266s.614-.166.816-.28c.115-.064.26-.179.379-.266.09-.067.087-.147.162-.138s.02.089-.085.18c-.105.092-.27.214-.403.283" />
          <path fill="#fff" d="M12.337 10.694h-.114c.088-.277-.106-.48-.621-.713-.534-.235-.96-.212-1.032.265l-.011.076a1 1 0 0 0-.12.054c-.252.137-.389.386-.465.692s-.098.674-.119 1.09c-.013.208-.099.49-.186.79-.875.624-2.09.894-3.122.19q-.107-.166-.233-.328l-.16-.205a.65.65 0 0 0 .268-.05.34.34 0 0 0 .186-.192c.063-.17 0-.408-.202-.68-.201-.273-.542-.58-1.043-.888-.368-.23-.574-.51-.67-.814-.097-.305-.084-.635-.01-.96.143-.625.51-1.233.743-1.614.063-.046.023.086-.236.567-.232.44-.667 1.455-.072 2.248a4.7 4.7 0 0 1 .377-1.677c.329-.747 1.018-2.041 1.072-3.073.029.02.125.086.169.11.126.075.221.184.344.283a.85.85 0 0 0 .575.2c.24 0 .427-.079.582-.168.17-.096.304-.204.433-.245.27-.085.486-.235.608-.41.21.83.7 2.027 1.014 2.611.167.31.5.969.643 1.762q.137-.004.299.038c.375-.973-.319-2.022-.636-2.314-.128-.124-.135-.18-.07-.177.343.304.795.917.96 1.608.075.315.09.646.01.973q.06.025.12.054c.603.293.826.548.719.897" />
          <path fill="#e6e6e6" d="M8.04 8.062c-.556.002-1.099.251-1.558.716S5.668 9.9 5.464 10.666l.061.038v.004c.47.298.805.598 1.012.878.219.296.316.584.223.834a.5.5 0 0 1-.27.283l-.041.015q.112.145.213.3c.944.628 2.042.396 2.867-.172.08-.278.153-.536.163-.698.021-.415.042-.792.124-1.12.082-.33.242-.63.544-.795q.026-.013.051-.023a1 1 0 0 1 .022-.094c-.242-.622-.591-1.14-1.01-1.5s-.897-.551-1.382-.554zm2.37 2.155-.002.005v-.002l.001-.004z" />
          <path fill="#fff" d="M9.278 3.833a1.05 1.05 0 0 1-.215.656 4 4 0 0 0-.218-.09l-.127-.045c.029-.035.085-.075.107-.127a.7.7 0 0 0 .05-.243l.001-.01a.7.7 0 0 0-.035-.236.43.43 0 0 0-.108-.184.22.22 0 0 0-.156-.07H8.57a.23.23 0 0 0-.151.06.43.43 0 0 0-.122.175.7.7 0 0 0-.05.243v.01a1 1 0 0 0 .009.14 2 2 0 0 0-.354-.12 1 1 0 0 1-.01-.133v-.013a1 1 0 0 1 .088-.447.8.8 0 0 1 .25-.328.55.55 0 0 1 .346-.123h.006c.125 0 .232.036.342.116a.8.8 0 0 1 .257.324c.063.138.094.273.097.433zm-1.89.164a1 1 0 0 0-.277.125.6.6 0 0 0 .002-.15v-.008a.7.7 0 0 0-.048-.192.4.4 0 0 0-.096-.141.16.16 0 0 0-.119-.045.16.16 0 0 0-.11.065.4.4 0 0 0-.07.156.6.6 0 0 0-.013.205v.008a.6.6 0 0 0 .048.193.37.37 0 0 0 .116.156l-.102.08-.078.056a.7.7 0 0 1-.16-.24 1.1 1.1 0 0 1-.09-.381v-.001a1.1 1.1 0 0 1 .045-.39.7.7 0 0 1 .167-.292.36.36 0 0 1 .264-.118.36.36 0 0 1 .235.09.7.7 0 0 1 .199.271c.053.12.08.24.089.382v.001q.005.089-.002.17" />
          <path fill="#202020" d="M7.806 4.335c.01.034.065.029.097.045.027.014.05.045.08.046s.076-.01.08-.04c.005-.038-.052-.063-.088-.077-.047-.019-.107-.028-.151-.003-.01.005-.021.018-.018.03zm-.322 0c-.01.034-.065.029-.096.045-.028.014-.05.045-.081.046-.03.001-.076-.01-.08-.04-.005-.038.052-.063.088-.077.047-.019.108-.028.152-.003.01.005.02.018.017.03z" />
        </svg>
      )}
      {platform === 'android' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={className}
          aria-hidden="true"
        >
          {/* Android robot head: dome + eyes + antennae (fallback) */}
          <path d="M4 15 A8 8 0 0 1 20 15" />
          <line x1="4" y1="15" x2="20" y2="15" />
          <circle cx="9" cy="12" r="1.8" fill="currentColor" stroke="none" />
          <circle cx="15" cy="12" r="1.8" fill="currentColor" stroke="none" />
          <line x1="7" y1="8" x2="4.5" y2="4" />
          <line x1="17" y1="8" x2="19.5" y2="4" />
        </svg>
      )}
      {platform === 'ios' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={className}
          aria-hidden="true"
        >
          {/* iPhone device frame */}
          <rect x="5" y="1.5" width="14" height="21" rx="3" />
          {/* Screen notch */}
          <line x1="9" y1="4" x2="15" y2="4" />
          {/* Home indicator */}
          <line x1="9.5" y1="20" x2="14.5" y2="20" />
        </svg>
      )}
    </>
  )
}