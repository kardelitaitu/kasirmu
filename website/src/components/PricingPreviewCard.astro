---
import type { PricingTier } from '../content/pricing/types';
import { t } from '../i18n';

interface Props {
  tier: PricingTier;
  locale: string;
}

const { tier, locale } = Astro.props;
// Annual is the default selection on the full pricing page (subscription-tiers.md §2).
const price = tier.prices.yearly;
---

<article
  class:list={[
    'pricing-card relative flex flex-col rounded-xl border p-6 transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]',
    tier.highlight ? 'border-primary bg-surface shadow-md hover:shadow-lg hover:-translate-y-1' : 'border-ink/10 bg-surface/40 hover:border-ink/20 hover:shadow-md hover:-translate-y-0.5',
  ]}
>
  {
    tier.highlight && (
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 z-10 inline-flex items-center rounded-full bg-primary px-3 py-0.5 text-[11px] font-bold text-on-primary shadow-sm uppercase tracking-wider">
        {t(locale, 'pricingPage.mostPopular')}
      </span>
    )
  }
  <h3 class="text-lg font-semibold">{tier.name}</h3>
  <div class="mt-3 min-h-[44px] flex items-baseline gap-1">
    <span class="text-3xl font-bold">{price.price}</span>
    {price.period && <span class="text-sm font-normal text-muted">{price.period}</span>}
  </div>
  <p class="mt-2 min-h-[48px] text-sm text-muted">{tier.description}</p>

  <ul class="mt-6 space-y-2 text-sm">
    {tier.features.map((f) => (
      <li class:list={['flex items-center gap-2', f.included ? '' : 'text-muted']}>
        <span aria-hidden="true" class:list={[f.included ? 'text-link' : 'text-muted/50']}>
          {f.included ? '✓' : '✗'}
        </span>
        {f.label}
      </li>
    ))}
  </ul>
</article>
