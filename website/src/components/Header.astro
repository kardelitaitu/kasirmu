---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger';

const locale = Astro.currentLocale ?? 'en';
const isDocs = Astro.url.pathname.includes('/docs');
const nav = [
  { href: getRelativeLocaleUrl(locale, '/'), label: t(locale, 'nav.home') },
  { href: getRelativeLocaleUrl(locale, 'features'), label: t(locale, 'nav.features') },
  { href: getRelativeLocaleUrl(locale, 'pricing'), label: t(locale, 'nav.pricing') },
  { href: getRelativeLocaleUrl(locale, 'download'), label: t(locale, 'nav.download') },
  { href: getRelativeLocaleUrl(locale, 'support'), label: t(locale, 'nav.support') },
  { href: getRelativeLocaleUrl(locale, 'docs'), label: t(locale, 'nav.docs') },
];
const home = getRelativeLocaleUrl(locale, '/');
const login = getRelativeLocaleUrl(locale, 'login');
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-surface/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href={home} class="text-lg font-bold tracking-tight" aria-label={t(locale, 'nav.homeAria')}>
      <span class="text-primary">OZ</span>-POS
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label={t(locale, 'nav.mainNav')}>
      <a href={getRelativeLocaleUrl(locale, '/')} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
        {t(locale, 'nav.home')}
        <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>

      <a href={getRelativeLocaleUrl(locale, 'features')} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
        {t(locale, 'nav.features')}
        <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>

      {/* Solutions dropdown */}
      <div class="group relative">
        <button
          type="button"
          class="nav-link flex items-center gap-1 text-sm text-muted transition-colors duration-200 group-hover:text-ink focus:outline-none"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>{t(locale, 'nav.solutions')}</span>
          <svg
            class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"
            />
          </svg>
        </button>

        {/* Dropdown panel */}
        <div class="invisible absolute left-1/2 top-full z-50 mt-2 w-[560px] -translate-x-1/2 opacity-0 transition-all duration-200 ease-out group-hover:visible group-hover:opacity-100">
          <div class="rounded-2xl border border-ink/10 bg-surface p-5 shadow-2xl backdrop-blur-lg">
            <div class="grid grid-cols-2 gap-6">
              {/* Column 1: By Industry */}
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-muted/80 mb-3 px-2">
                  {t(locale, 'nav.solutionsByIndustry')}
                </p>
                <div class="space-y-1">
                  <a
                    href={getRelativeLocaleUrl(locale, 'restaurant')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 2v6a3 3 0 0 1-3 3 3 3 0 0 1-3-3V2"></path>
                        <path d="M15 2v18"></path>
                        <path d="M7 2v20"></path>
                        <path d="M4 2v4a3 3 0 0 0 6 0V2"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionRestaurants')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionRestaurantsDesc')}
                      </p>
                    </div>
                  </a>

                  <a
                    href={getRelativeLocaleUrl(locale, 'cafe')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
                        <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
                        <line x1="6" x2="6" y1="2" y2="4"></line>
                        <line x1="10" x2="10" y1="2" y2="4"></line>
                        <line x1="14" x2="14" y1="2" y2="4"></line>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionCafes')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionCafesDesc')}
                      </p>
                    </div>
                  </a>

                  <a
                    href={getRelativeLocaleUrl(locale, 'minimarket')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionRetail')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionRetailDesc')}
                      </p>
                    </div>
                  </a>

                  <a
                    href={getRelativeLocaleUrl(locale, 'warung')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                        <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                        <path d="M2 7h20"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionWarung')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionWarungDesc')}
                      </p>
                    </div>
                  </a>
                </div>
              </div>

              {/* Column 2: System & Core */}
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-muted/80 mb-3 px-2">
                  {t(locale, 'nav.solutionsBySystem')}
                </p>
                <div class="space-y-1">
                  <a
                    href={getRelativeLocaleUrl(locale, 'warehouse')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                        <path d="m3.3 7 8.7 5 8.7-5"></path>
                        <path d="M12 22V12"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionWarehouses')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionWarehousesDesc')}
                      </p>
                    </div>
                  </a>

                  <a
                    href={getRelativeLocaleUrl(locale, 'docs/inventory')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="15" x="2" y="3" rx="2"></rect>
                        <line x1="8" x2="16" y1="21" y2="21"></line>
                        <line x1="12" x2="12" y1="18" y2="21"></line>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionKitchens')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionKitchensDesc')}
                      </p>
                    </div>
                  </a>

                  <a
                    href={getRelativeLocaleUrl(locale, 'docs/shifts')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionAudits')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionAuditsDesc')}
                      </p>
                    </div>
                  </a>

                  <a
                    href={getRelativeLocaleUrl(locale, 'docs/cloud-sync')}
                    class="group/item flex items-center gap-3 rounded-xl p-2 transition hover:bg-ink/5"
                  >
                    <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover/item:scale-105 group-hover/item:bg-primary group-hover/item:text-on-primary group-hover/item:shadow-md group-hover/item:shadow-primary/20">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20v-6M6 20V10M18 20V4"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink group-hover/item:text-primary transition-colors">
                        {t(locale, 'nav.solutionLogging')}
                      </p>
                      <p class="text-xs text-muted leading-snug">
                        {t(locale, 'nav.solutionLoggingDesc')}
                      </p>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a href={getRelativeLocaleUrl(locale, 'pricing')} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
        {t(locale, 'nav.pricing')}
        <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>

      <a href={getRelativeLocaleUrl(locale, 'download')} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
        {t(locale, 'nav.download')}
        <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>

      <a href={getRelativeLocaleUrl(locale, 'support')} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
        {t(locale, 'nav.support')}
        <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>

      <a href={getRelativeLocaleUrl(locale, 'docs')} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
        {t(locale, 'nav.docs')}
        <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>
    </nav>
    <!-- The search trigger only exists on docs pages, but its slot is always
         rendered: without the spacer the whole cluster (theme toggle, locale
         switcher, login button) visibly shifts sideways when you navigate
         between docs and the rest of the site. h-9 w-9 matches the trigger
         button exactly — and matches ThemeToggle, which is the same box — so
         the reserved area is the same width as the real thing. SearchModal
         portals to document.body and returns null while closed, so the
         trigger's only layout footprint really is that 36px square. -->
    <div class="flex items-center gap-2.5">
      {isDocs ? <SearchTrigger client:load locale={locale} /> : <span class="h-9 w-9" aria-hidden="true"></span>}
      <ThemeToggle />
      <LocaleSwitcher />
      <a
        href={login}
        data-auth-nav
        data-locale={locale}
        data-login-text={t(locale, 'nav.login')}
        data-account-text={t(locale, 'nav.account')}
        class="hidden rounded-md bg-primary px-4 py-2 text-sm font-semibold text-on-primary transition hover:bg-primary-hover sm:inline-block"
      >
        {t(locale, 'nav.login')}
      </a>
      <!-- Mobile menu -->
      <details class="group relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-ink/10 text-muted transition hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label={t(locale, 'nav.menu')}
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 w-64 max-h-[80vh] overflow-y-auto rounded-xl border border-ink/10 bg-surface p-3 shadow-xl"
          aria-label={t(locale, 'nav.menu')}
        >
          <a
            href={getRelativeLocaleUrl(locale, '/')}
            class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
          >
            {t(locale, 'nav.home')}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, 'features')}
            class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
          >
            {t(locale, 'nav.features')}
          </a>

          {/* Mobile Solutions Section */}
          <div class="my-2 border-t border-b border-ink/10 py-2">
            <p class="px-3 text-xs font-bold uppercase tracking-wider text-muted/70">
              {t(locale, 'nav.solutions')}
            </p>
            <div class="mt-1 space-y-0.5">
              <a
                href={getRelativeLocaleUrl(locale, 'restaurant')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionRestaurants')}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, 'cafe')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionCafes')}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, 'minimarket')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionRetail')}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, 'warung')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionWarung')}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, 'warehouse')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionWarehouses')}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, 'docs/inventory')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionKitchens')}
              </a>
              <a
                href={getRelativeLocaleUrl(locale, 'docs/shifts')}
                class="block rounded-md px-3 py-1.5 text-xs text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {t(locale, 'nav.solutionAudits')}
              </a>
            </div>
          </div>

          <a
            href={getRelativeLocaleUrl(locale, 'pricing')}
            class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
          >
            {t(locale, 'nav.pricing')}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, 'download')}
            class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
          >
            {t(locale, 'nav.download')}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, 'support')}
            class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
          >
            {t(locale, 'nav.support')}
          </a>

          <a
            href={getRelativeLocaleUrl(locale, 'docs')}
            class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
          >
            {t(locale, 'nav.docs')}
          </a>

          <a
            href={login}
            data-auth-nav
            data-locale={locale}
            data-login-text={t(locale, 'nav.login')}
            data-account-text={t(locale, 'nav.account')}
            class="mt-2 block rounded-md bg-primary px-3 py-2 text-center text-sm font-semibold text-on-primary transition hover:bg-primary-hover"
          >
            {t(locale, 'nav.login')}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  function updateAuthNav() {
    const isAuth = Boolean(sessionStorage.getItem('oz_session'));
    const loginLinks = document.querySelectorAll<HTMLAnchorElement>('[data-auth-nav]');
    loginLinks.forEach((link) => {
      const loc = link.getAttribute('data-locale') || 'en';
      if (isAuth) {
        link.href = `/${loc}/account`;
        link.textContent = link.getAttribute('data-account-text') || 'Account';
      } else {
        link.href = `/${loc}/login`;
        link.textContent = link.getAttribute('data-login-text') || 'Sign in';
      }
    });
  }

  // Update on initial load, after SPA page swap, and on storage change
  updateAuthNav();
  document.addEventListener('astro:page-load', updateAuthNav);
  document.addEventListener('astro:after-swap', updateAuthNav);
  window.addEventListener('storage', updateAuthNav);

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest('details.group a');
    if (link) {
      const details = link.closest('details');
      if (details) details.removeAttribute('open');
    }
  });
</script>
