---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, dict } from '../i18n';

/**
 * Vertical landing page body (subscription-tiers.md §5). Customers don't
 * identify as "Pro tier users" — they identify as cafe owners, minimarket
 * operators, or warung owners — so these pages lead with vertical language
 * and the kasir.mu positioning statement, never tier names. Each vertical has
 * an entry hook, highlighted features, and a CTA that deep-links to the
 * natural tier on the pricing page (kafe/minimarket → Pro, warung → Plus,
 * restoran → Premium).
 */
export type VerticalKey = 'kafe' | 'minimarket' | 'warung' | 'restoran' | 'warehouse';

export const verticalKeys: VerticalKey[] = ['restoran', 'kafe', 'minimarket', 'warung', 'warehouse'];

export const verticalPathMap: Record<VerticalKey, string> = {
  kafe: 'cafe',
  minimarket: 'minimarket',
  warung: 'warung',
  restoran: 'restaurant',
  warehouse: 'warehouse',
};

interface VerticalFeature {
  title: string;
  description: string;
}

interface VerticalContent {
  label: string;
  title: string;
  tagline: string;
  tierAnchor: string;
  ctaPrimary: string;
  features: VerticalFeature[];
  benefits: string[];
  /**
   * A concrete working day, in order. Written from the product docs (the
   * `guides` collection: first-sale, shifts, inventory, payments) so the page
   * shows the work a merchant recognises instead of only feature names — the
   * ten vertical pages used to carry 149–271 words of body copy, which is not
   * enough to explain anything to someone deciding. `content-depth.test.ts`
   * and `check:seo` keep them at that floor.
   */
  day: string[];
  /** Questions the docs already answer, in this vertical's words. */
  faq: { q: string; a: string }[];
  /**
   * Lead with the trial CTA instead of the plan-browsing link (§5). Kafe is
   * the one vertical whose entry hook is the 14-day Pro trial — the
   * restaurant/cafe segment gets Pro on trial activation (§4, server
   * trialSegmentation) — so the primary button funnels into the download
   * page with ?v=kafe and the pricing deep-link demotes to secondary.
   */
  leadWithTrial?: boolean;
  /** Label for the trial CTA when leadWithTrial is set. */
  trialCta?: string;
}

interface VerticalSection {
  positioning: string;
  whyTitle: string;
  otherTitle: string;
  otherSubtitle: string;
  dayTitle: string;
  hardwareTitle: string;
  hardware: string[];
  ctaSecondary: string;
  bundleCta?: string;
  kafe: VerticalContent;
  minimarket: VerticalContent;
  warung: VerticalContent;
  restoran: VerticalContent;
  warehouse: VerticalContent;
}

interface Props {
  vertical: VerticalKey;
  /** Show the Restaurant Starter bundle CTA (C3.2) — warung + restoran. */
  showBundle?: boolean;
}

const { vertical, showBundle } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const section = dict(locale).vertical as VerticalSection;
const v = section[vertical];
const pricingHref = getRelativeLocaleUrl(locale, 'pricing');
const downloadHref = getRelativeLocaleUrl(locale, 'download');
// Section-level strings — wired through t() so each vertical key is a
// first-class i18n reference (the audit tracks t() literals, not dict()).
const positioning = t(locale, 'vertical.positioning');
const whyTitle = t(locale, 'vertical.whyTitle');
const otherSubtitle = t(locale, 'vertical.otherSubtitle');
const ctaSecondary = t(locale, 'vertical.ctaSecondary');
const bundleCta = t(locale, 'vertical.bundleCta');
// Per-vertical string fields — literal t() keys per vertical (the audit
// needs the literal key text; the values match what dict() provides).
const vStrings: Record<VerticalKey, { label: string; ctaPrimary: string; tierAnchor: string }> = {
  kafe: {
    label: t(locale, 'vertical.kafe.label'),
    ctaPrimary: t(locale, 'vertical.kafe.ctaPrimary'),
    tierAnchor: t(locale, 'vertical.kafe.tierAnchor'),
  },
  minimarket: {
    label: t(locale, 'vertical.minimarket.label'),
    ctaPrimary: t(locale, 'vertical.minimarket.ctaPrimary'),
    tierAnchor: t(locale, 'vertical.minimarket.tierAnchor'),
  },
  warung: {
    label: t(locale, 'vertical.warung.label'),
    ctaPrimary: t(locale, 'vertical.warung.ctaPrimary'),
    tierAnchor: t(locale, 'vertical.warung.tierAnchor'),
  },
  restoran: {
    label: t(locale, 'vertical.restoran.label'),
    ctaPrimary: t(locale, 'vertical.restoran.ctaPrimary'),
    tierAnchor: t(locale, 'vertical.restoran.tierAnchor'),
  },
  warehouse: {
    label: t(locale, 'vertical.warehouse.label'),
    ctaPrimary: t(locale, 'vertical.warehouse.ctaPrimary'),
    tierAnchor: t(locale, 'vertical.warehouse.tierAnchor'),
  },
};
const trialCta = t(locale, 'vertical.kafe.trialCta');
// Structured per-vertical keys (features/benefits arrays) — referenced via
// t() so the i18n audit tracks them; the arrays themselves are read through
// dict() at render time.
const vStructuredKeys: Record<
  VerticalKey,
  { features: string; benefits: string; day: string; faq: string }
> = {
  kafe: {
    features: t(locale, 'vertical.kafe.features'),
    benefits: t(locale, 'vertical.kafe.benefits'),
    day: t(locale, 'vertical.kafe.day'),
    faq: t(locale, 'vertical.kafe.faq'),
  },
  minimarket: {
    features: t(locale, 'vertical.minimarket.features'),
    benefits: t(locale, 'vertical.minimarket.benefits'),
    day: t(locale, 'vertical.minimarket.day'),
    faq: t(locale, 'vertical.minimarket.faq'),
  },
  warung: {
    features: t(locale, 'vertical.warung.features'),
    benefits: t(locale, 'vertical.warung.benefits'),
    day: t(locale, 'vertical.warung.day'),
    faq: t(locale, 'vertical.warung.faq'),
  },
  restoran: {
    features: t(locale, 'vertical.restoran.features'),
    benefits: t(locale, 'vertical.restoran.benefits'),
    day: t(locale, 'vertical.restoran.day'),
    faq: t(locale, 'vertical.restoran.faq'),
  },
  warehouse: {
    features: t(locale, 'vertical.warehouse.features'),
    benefits: t(locale, 'vertical.warehouse.benefits'),
    day: t(locale, 'vertical.warehouse.day'),
    faq: t(locale, 'vertical.warehouse.faq'),
  },
};
// The kafe vertical alone carries the lead-with-trial flag (a boolean in the
// dict); referenced here so the audit tracks it as a used key.
const leadWithTrialKey = t(locale, 'vertical.kafe.leadWithTrial');
const tierHref = `${pricingHref}#${vStrings[vertical].tierAnchor}`;
// Segmented-trial passthrough (C2.1, subscription-tiers.md §4): carry the
// vertical onto the download page (?v=kafe etc.) so the download page can
// show the matching trial offer and the desktop app's onboarding can detect
// it (the POS normalizes kafe/restoran → restaurant = 14-day Pro trial).
const trialHref = `${downloadHref}?v=${vertical}`;
// CTA leadership (§5): kafe leads with its Pro trial CTA — the restaurant/
// cafe segment is the one that mints a 14-day Pro trial (§4), so the
// primary button funnels into the trial download (?v=kafe) instead of a
// plan-browsing link. All other verticals lead with the natural-tier
// pricing deep-link and demote the download CTA to secondary.
const leadsWithTrial = Boolean(v.leadWithTrial);
const primaryCta = {
  href: leadsWithTrial ? trialHref : tierHref,
  label: leadsWithTrial ? (trialCta ?? ctaSecondary) : vStrings[vertical].ctaPrimary,
};
const secondaryCta = {
  href: leadsWithTrial ? tierHref : trialHref,
  label: leadsWithTrial ? vStrings[vertical].ctaPrimary : ctaSecondary,
};
// Bundle purchase path (C3.2): deep-links to the Plus card with the
// Restaurant Starter bundle pre-enabled — the pricing grid reads
// `?bundle=restaurant_starter` and the checkout carries it into the
// webhook (custom_field4 / custom_data.bundle).
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div data-reveal class="mx-auto max-w-3xl text-center" data-i18n-key={leadWithTrialKey}>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{v.title}</h1>
    <p class="mt-4 text-lg text-muted">{v.tagline}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={primaryCta.href}
        class="rounded-md bg-accent px-6 py-3 text-base font-semibold text-on-primary transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
      >
        {primaryCta.label}
      </a>
      <a
        href={secondaryCta.href}
        class="rounded-md border border-ink/15 px-6 py-3 text-base font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
      >
        {secondaryCta.label}
      </a>
    </div>
  </div>

  <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-i18n-key={vStructuredKeys[vertical].features}>
    {
      v.features.map((f, i) => (
        <article
          data-reveal
          style={`transition-delay: ${i * 80}ms`}
          class="rounded-xl border border-ink/10 bg-surface/40 p-6 transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)] hover:border-ink/20 hover:shadow-md hover:-translate-y-0.5"
        >
          <h2 class="text-lg font-semibold">{f.title}</h2>
          <p class="mt-2 text-sm text-muted">{f.description}</p>
        </article>
      ))
    }
  </div>

  <div data-reveal class="mt-16 rounded-2xl border border-accent/30 bg-surface/60 p-8 sm:p-10" data-i18n-key={vStructuredKeys[vertical].benefits}>
    <h2 class="text-xl font-semibold">{whyTitle}</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        v.benefits.map((b) => (
          <li class="flex items-start gap-2 text-sm text-muted transition-colors duration-200 hover:text-ink">
            <span aria-hidden="true" class="text-link">✓</span>
            {b}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- A day with kasir.mu. Written from the product docs rather than from
       feature names, because the feature grid above does not answer the
       question a merchant actually arrives with: what will my day look
       like? Order comes from the shift lifecycle (open → sell → count →
       close), which is the sequence the docs describe. -->
  <div data-reveal class="mt-16" data-i18n-key={vStructuredKeys[vertical].day}>
    <h2 class="text-xl font-semibold">{section.dayTitle}</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        v.day.map((step, i) => (
          <li class="flex gap-3 rounded-xl border border-ink/10 bg-surface/40 p-5 text-sm leading-relaxed text-muted">
            <span class="font-semibold text-ink" aria-hidden="true">
              {i + 1}.
            </span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Hardware Compatibility Trust Badges. The four labels used to be inline
       `locale === 'id' ? … : …` copy, which `audit-i18n.mjs` cannot see: a
       string that is not in the dictionary cannot be found missing from it. -->
  <div data-reveal class="mt-12 rounded-xl border border-ink/10 bg-surface/40 p-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted text-center">
      {section.hardwareTitle}
    </p>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-6 text-sm text-ink font-medium">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9" />
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
          <rect x="6" y="14" width="12" height="8" />
        </svg>
        {section.hardware[0]}
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <path d="M7 7h3v3H7zM14 7h3v3h-3zM7 14h3v3H7zM14 14h3v3h-3z" />
        </svg>
        {section.hardware[1]}
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <line x1="12" y1="12" x2="12" y2="12" />
        </svg>
        {section.hardware[2]}
      </span>
    </div>
  </div>

  <!-- FAQ. The answers are already in the docs (offline queue mechanics,
       hardware support, QRIS settlement, closing the day); they were simply
       not on the page a merchant lands on first. This also emits FAQPage
       structured data, which the keyword landings already did and these ten
       pages did not. -->
  <div
    data-reveal
    class="mt-16 rounded-2xl border border-ink/10 bg-surface/40 p-8 sm:p-10"
    data-i18n-key={vStructuredKeys[vertical].faq}
  >
    <h2 class="text-xl font-semibold">{t(locale, 'support.faqTitle')}</h2>
    <div class="mt-6 space-y-3">
      {
        v.faq.map((item) => (
          <details class="faq-item group rounded-xl border border-ink/10 bg-surface/60 transition-all duration-200 hover:border-ink/20">
            <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-medium transition-colors duration-200 hover:text-link [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <svg
                class="h-5 w-5 text-muted transition-transform duration-200 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="faq-answer overflow-hidden">
              <p class="px-5 pb-4 text-sm leading-relaxed text-muted">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>

  <div data-reveal class="mt-16 text-center">
    <h2 class="text-xl font-semibold">{section.otherTitle}</h2>
    <p class="mt-2 text-sm text-muted">{otherSubtitle}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      {
        verticalKeys
          .filter((key) => key !== vertical)
          .map((key) => (
            <a
              href={getRelativeLocaleUrl(locale, verticalPathMap[key])}
              class="rounded-full border border-ink/10 px-4 py-2 text-sm text-muted transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:border-accent hover:text-ink hover:scale-[1.03] active:scale-[0.97]"
            >
              {vStrings[key].label}
            </a>
          ))
      }
    </div>
  </div>
</section>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: v.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })}
/>
