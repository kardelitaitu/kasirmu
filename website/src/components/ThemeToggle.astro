---
// Header theme toggle. Dark is the default; the stored choice lives in
// localStorage (key oz_theme) and is applied to <html data-theme> by an
// inline script in the layout head (before first paint, so no flash). The
// icon swaps via CSS (.icon-sun/.icon-moon rules in global.css).
import { t } from '../i18n';

interface Props {
  /** Page locale, threaded down by Header so the label matches the document. */
  locale?: string;
}

const locale = Astro.props.locale ?? Astro.currentLocale ?? 'en';
---

<button
  type="button"
  data-theme-toggle
  class="theme-toggle flex h-9 w-9 items-center justify-center rounded-md text-muted transition hover:text-ink"
  aria-label={t(locale, 'nav.theme')}
  title={t(locale, 'nav.theme')}
>
  <!-- Moon: shown in dark mode — click to switch to light -->
  <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M13.5 9.2A5.5 5.5 0 1 1 6.8 2.5a4.3 4.3 0 0 0 6.7 6.7Z"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <!-- Sun: shown in light mode — click to switch to dark -->
  <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.4" />
    <path
      d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    />
  </svg>
</button>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('[data-theme-toggle]');
    if (!btn) return;
    const html = document.documentElement;
    const next = html.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('oz_theme', next);
  });
</script>
