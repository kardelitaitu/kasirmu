# kasir.mu Website environment variables.
# Astro only exposes PUBLIC_* vars to the browser — set the same names in
# Cloudflare Pages (Settings → Builds → Environment variables).
#
# License server web API (OTP auth + license status). This is the unified
# service (runbook §8). Empty in dev = the login/account pages render a
# "not configured" state instead of failing.
PUBLIC_LICENSE_API_URL=https://license.kasir.mu
# Runtime override: the Worker serves this from wrangler.toml [vars] LICENSE_API_URL
# — update THAT var (dashboard or wrangler.toml) to repoint the site without a
# rebuild; the value here is only the build-time fallback.
#
# Paddle.js (v2). Empty = checkout buttons fall back to a contact link.
# PUBLIC_PADDLE_ENVIRONMENT controls the Paddle SDK: "sandbox" or "production"
# (defaults to production when unset). Use sandbox until real price ids ship.
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_ENVIRONMENT=sandbox
#
# Support contact form target: the license-server route that forwards
# messages to the Discord channel (e.g. https://license.kasir.mu/api/v1/web/contact).
# The Discord webhook URL must live server-side only — never in the browser.
# Empty = the form degrades to a prefilled mailto to support@kasir.mu.
PUBLIC_CONTACT_ENDPOINT=
