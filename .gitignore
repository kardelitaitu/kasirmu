# reappears as an untracked file after any local report run.
/skill-drift-report.md

# Legacy TypeDoc HTML drop. TypeDoc now emits into docs/src/api/ts/ (covered by
# /docs/src/api/ below), so nothing writes here anymore — the rule is kept as a
# regression guard against re-adding the 466 HTML files this once committed.
/docs/html/

# Generated documentation portal (mdBook) — see docs/plans/documentation-portal-plan.md.
# The canonical docs live in docs/*.md + docs/decisions/; the book source and
# output are regenerated by scripts/build-docs.sh|.ps1 on every build.
/docs/book/
/docs/src/api/
/docs/src/guides/
/docs/src/decisions/
/docs/src/releases/
/docs/src/operations/
/docs/src/SUMMARY.md

# Graph analysis artifacts (generated by graphify)
/graphify-out/
# Graphify rebuild hooks — local-only tooling; installed via `graphify hook install`.
.githooks/post-checkout

# Scratch & temporary scripts/files
scripts/tmp-*
scripts/temp-*
tmp-*
temp-*
# Underscore variant: the dash-only patterns above let temp_check.ps1 through.
temp_*
*.tmp
# Dot-prefixed scratch from agent runs: .tmp-build/, .tmp-apk-verify/, .tmp-28-a.txt.
# Matches at any depth and covers files as well as directories, which is what lets
# the one-off .tmp-28-*.txt entries below be deleted rather than kept beside it.
.tmp-*
/temp.go
/tmp/
# PR body scratch, written by the pr-create-pull-request skill each cycle.
/pr_body.md

# Tauri — generated platform code (Android/iOS)
# The generated scaffold under apps/*/gen/ is COMMITTED so CI and
# contributors don't need the Tauri CLI installed to build (same policy as
# the icons below). The scaffold ships its own committed .gitignore that
# already excludes Gradle/Kotlin build junk (build/, .gradle/, .kotlin/,
# captures/, local.properties, generated/ code, *.so, tauri.conf.json, ...);
# only what that misses is listed here:
apps/mobile-tauri/gen/android/buildSrc/.kotlin/
# apps/*/icons/*.png   ← committed, do not ignore
# apps/*/icons/*.ico   ← committed, do not ignore

# UI  (ui/.gitignore already covers node_modules, dist*, .vite, coverage,
#  .eslintcache — only what it misses is listed here.)
/ui/.stylelintcache
# ui/vite.config.js is emitted from vite.config.ts by the TS build.
ui/vite.config.js

