# ── OZ-POS .dockerignore ────────────────────────────────────────────
#
# Exclude everything that is not needed for building the cloud-server
# binary: node_modules, Tauri build artifacts, IDE configs, etc.

# Version control
.git
.gitignore
.gitattributes
.gitmodules
.githooks

# CI / GitHub
.github

# Documentation & design docs (not needed at compile time)
docs

# Front-end (Node.js / Tauri) — not needed for cloud-server. kasirmu-core
# vendors its copy of topologySemantics.json (crates/kasirmu-core/src/), so the
# server build never touches the UI tree at all.
ui
node_modules
apps/desktop-tauri
apps/mobile-tauri

# IDE / editor configs
.vscode
.idea
*.swp
*.swo

# OS garbage
.DS_Store
Thumbs.db

# Rust build artifacts (will be rebuilt in the container)
target

# Environment / secrets
.env
*.env
oz-pos-updater.key.pub

# Temporary / generated files
*.log
*.tmp
Cargo.lock.bak

# Go license-server: test files, healthcheck (//go:build ignore), and
# build artifacts are excluded so COPY apps/license-server/ ./ pulls
# only production sources into the unified gobuilder stage.
apps/license-server/*_test.go
apps/license-server/healthcheck.go
apps/license-server/*.exe
apps/license-server/*.test
apps/license-server/*.out
apps/license-server/coverage.html
apps/license-server/coverage.out
apps/license-server/pb_data/
apps/license-server/winres/
apps/license-server/app.manifest
apps/license-server/*.syso
