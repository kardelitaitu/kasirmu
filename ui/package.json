{
  "name": "oz-pos-ui",
  "private": true,
  "version": "0.0.37",
  "type": "module",
  "description": "OZ-POS front-end: React 18 + Vite + TypeScript + @fluent/react.",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "dev": "vite",
    "dev:tablet": "vite --config vite.tablet.config.ts",
    "check:all": "node ../scripts/check-ui.mjs",
    "build": "tsc -b && vite build",
    "build:tablet": "tsc -b && vite build --config vite.tablet.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:i18n": "bash ../scripts/lint-i18n.sh",
    "dedupe:ftl": "python3 ../scripts/dedupe-ftl.py",
    "typecheck": "tsc --noEmit",
    "bundle:check": "node ../scripts/check-bundle.mjs",
    "bundle:check:tablet": "node ../scripts/check-bundle.mjs --config=vite.tablet.config.ts",
    "test": "vitest run",
    "test:a11y": "vitest run --reporter=verbose src/__tests__/a11y/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:perf": "playwright test --config e2e/playwright.config.ts e2e/perf-smoke.spec.ts",
    "test:scripts": "node --test \"../scripts/__tests__/*.test.mjs\"",
    "e2e": "node ../scripts/run-e2e.mjs",
    "e2e:headed": "node ../scripts/run-e2e.mjs --headed",
    "e2e:api": "node ../scripts/run-e2e.mjs --api-only e2e/api.spec.ts",
    "e2e:ui": "node ../scripts/run-e2e.mjs --ui-only",
    "docs": "npx -y typedoc --skipErrorChecking --entryPointStrategy expand ./src/api ./src/types ./src/hooks --out ../docs/src/api/ts"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@fluent/bundle": "^0.18.0",
    "@fluent/react": "^0.15.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "fuse.js": "^7.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.2.7",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.1.0",
    "msw": "^2.15.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "4.1.10"
  },
  "overrides": {
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "msw@2.15.0": true
  }
}
