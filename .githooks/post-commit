#!/bin/sh

# tripwire-start ---------------------------------------------------------------
# UI typecheck tripwire. Records, never enforces.
#
# WHY THIS IS NOT JUST pre-commit STEP 9
#   Step 9 exists, works, and is bypassable twice over: `git commit --no-verify`
#   skips pre-commit and commit-msg outright, and a one-off `KASIRMU_SKIP_TYPECHECK=1`
#   prefix skips that step alone. Both leave no trace anywhere. --no-verify does
#   NOT skip post-commit, and post-commit cannot abort a commit, which is exactly
#   what makes it the right place for a tripwire: it observes, it records, it gets
#   out of the way.
#
# WHY THIS BLOCK SITS ABOVE THE INDEXER AND NOT AT THE TAIL
#   This hook has four ways to leave before its last line: CBM_SKIP_POST_COMMIT=1,
#   an empty `git rev-parse --show-toplevel`, an unresolved indexer binary, and the
#   backgrounded subshell that does the real indexing work. Anything appended at
#   the tail is therefore conditional on the indexer being installed and enabled -
#   silently disabled under three of those four, which is the exact bug this hook
#   was rewritten to fix (see the header below: 535 commits indexed nothing and
#   nothing revealed it). DO NOT MOVE THIS BLOCK DOWNWARD. If you are adding a
#   step to this hook, it goes above the indexer too.
#   It also runs BEFORE the indexer path, so it cannot inherit indexer latency;
#   the reverse is true and harmless - on a rare ui/src commit the backgrounded
#   index starts ~21s late, and it is backgrounded, so nobody waits for it.
#
# WHY ITS OWN LOG FILE AND NOT cbm-post-commit.log
#   The existing log is the indexer's run log, not a gate log: 982 lines, 162
#   `index start`, zero hits for `typecheck`, `error TS` or `gate`. There is no
#   record of gate runs anywhere, because pre-commit writes nothing. That file is
#   also rotated by an unrelated process with a `mv` at 512 KB, so a tripwire line
#   written there is thrown away on schedule.
#
# THE CONTRACT, and what keeps this hook cheap on a branch where ten commits an
#   hour land: when the commit touched no ui/src TypeScript this block runs one
#   `git show` (~80 ms measured) and returns. It never runs npm install, never
#   formats, never writes outside its own log file, never logs file contents or a
#   diff, and it always returns success. A tripwire that can break someone's
#   commit becomes the thing that gets deleted, and a deleted gate is worse than
#   a bypassable one.
#
#   TC_TRIPWIRE_HEAD points the block at a commit other than HEAD. It exists only
#   so the FAIL path can be exercised against real history without checking
#   anything out; it changes which commit is inspected, never whether it is.
#
# Log format, one line per firing, nothing else:
#   <ISO-8601> <sha> PASS|FAIL|ERROR|SKIP errors=<n>
(
    _TC_REF="${TC_TRIPWIRE_HEAD:-HEAD}"
    _TC_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$_TC_ROOT" ] || exit 0

    # The same pathspec pre-commit step 9 uses, so the tripwire fires on exactly
    # the commits the gate was built for and on nothing else.
    _TC_TOUCHED="$(git -C "$_TC_ROOT" show --diff-filter=ACM --name-only --format= \
        "$_TC_REF" -- 'ui/src/*.ts' 'ui/src/*.tsx' 2>/dev/null | tr -d '\r' | grep -v '^[[:space:]]*$' || true)"
    [ -n "$_TC_TOUCHED" ] || exit 0

    _TC_SHA="$(git -C "$_TC_ROOT" rev-parse --short "$_TC_REF" 2>/dev/null || echo unknown)"
    _TC_TS="$(date -Iseconds 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
    _TC_LOG="$(git -C "$_TC_ROOT" rev-parse --git-path typecheck-tripwire.log 2>/dev/null || true)"
    case "$_TC_LOG" in
        /*|[A-Za-z]:/*) : ;;
        "") _TC_LOG="$_TC_ROOT/.git/typecheck-tripwire.log" ;;
        *) _TC_LOG="$_TC_ROOT/$_TC_LOG" ;;
    esac

    if [ ! -d "$_TC_ROOT/ui/node_modules" ] || ! command -v npm >/dev/null 2>&1; then
        # An unrecorded skip is the failure mode this file exists to kill. Say it
        # in the log AND out loud, the way step 9 warns instead of failing here.
        printf '%s %s SKIP errors=0\n' "$_TC_TS" "$_TC_SHA" >>"$_TC_LOG"
        echo "post-commit tripwire: ui typecheck NOT RUN (npm or ui/node_modules missing)." >&2
        exit 0
    fi

    # When KASIRMU_SKIP_TRIPWIRE=1 (default) or KASIRMU_FAST_HOOKS=1, avoid running
    # foreground typecheck (~21s) during atomic commits. Heavy typechecks are
    # enforced at pre-push (scripts/run-pre-push.py) and in CI (dev-ci.yml#ui-test).
    # Preserves execution in test harnesses where NPM_STUB_MODE is set.
    if [ "${KASIRMU_SKIP_TRIPWIRE:-1}" = "1" ] && [ -z "${NPM_STUB_MODE:-}" ]; then
        exit 0
    fi

    # Foreground on purpose when active.
    # a line in a log nobody reads. The person who bypassed step 9 is the one
    # person who should still be looking at the terminal when this says so.
    _TC_OUT="$( cd "$_TC_ROOT/ui" && npm run --silent typecheck 2>&1 )"
    _TC_RC=$?
    _TC_ERRS="$(printf '%s\n' "$_TC_OUT" | grep -c 'error TS' 2>/dev/null | tr -d ' ' || true)"
    [ -n "$_TC_ERRS" ] || _TC_ERRS=0

    if [ "$_TC_RC" -eq 0 ]; then
        printf '%s %s PASS errors=%s\n' "$_TC_TS" "$_TC_SHA" "$_TC_ERRS" >>"$_TC_LOG"
        exit 0
    fi

    # rc != 0 with no parseable diagnostics means the check itself broke, not that
    # the tree is red. Recording that as FAIL would invent a verdict.
    if [ "$_TC_ERRS" -gt 0 ]; then _TC_VERDICT=FAIL; else _TC_VERDICT=ERROR; fi
    printf '%s %s %s errors=%s\n' "$_TC_TS" "$_TC_SHA" "$_TC_VERDICT" "$_TC_ERRS" >>"$_TC_LOG"

    echo "" >&2
    echo "==============================================================================" >&2
    echo " post-commit tripwire: $_TC_VERDICT - $_TC_ERRS TypeScript error(s) at $_TC_SHA" >&2
    echo " pre-commit step 9 was bypassed for this commit (--no-verify or" >&2
    echo " KASIRMU_SKIP_TYPECHECK=1). Nothing enforced this; the commit stands." >&2
    printf '%s\n' "$_TC_OUT" | grep 'error TS' | head -30 >&2
    echo "------------------------------------------------------------------------------" >&2
    echo " Recorded in $_TC_LOG" >&2
    echo "==============================================================================" >&2
    exit 0
)
# tripwire-end -----------------------------------------------------------------

# codebase-memory-mcp auto-index start
# Refresh the code knowledge graph in the background after every commit.
#
# WHY THIS EXISTS
#   Agents explore this repo through the codebase-memory graph, and the graph
#   only advances when something re-indexes it. The previous version of this
#   hook ran 535 commits (2026-09-05 01:32 -> 2026-09-08) without indexing once,
#   and nothing anywhere revealed it: every failure path was pointed at
#   /dev/null. A gate that fails silently is indistinguishable from a gate that
#   was deleted, so this revision's whole design is "make the failure visible".
#
# TWO LIVE BUGS THIS NOW GUARDS
#   1. Binary resolution. An indexer build refuses to act as a client while a
#      *newer* daemon is active - it hangs 30s and dies with "CBM daemon is
#      active or starting but could not accept this client". The copy under
#      %LOCALAPPDATA%\Programs was exactly that stale build, and it was winning
#      because the hook resolved via PATH first. Resolution now mirrors
#      ~/.agents/bin/codebase-memory-mcp-launcher.py, which had already learned
#      this and documented it; the hook simply never got the memo.
#   2. Windows reserved-name ghosts. A file literally named `nul` in the repo
#      root (created by a `2> nul` typo under Git bash - cmd writes to the NUL
#      device, MSYS creates a real file) aborts the indexer's discovery pass
#      before it writes anything, so the whole root index fails in ~2s with a
#      generic "Pipeline failed". `.cbmignore` lists `nul` but never gets the
#      chance to apply. The old comment here claimed those files were "now
#      deleted", which is how the bug survived: the claim was true at the time
#      and false forever after, with no guard to notice.
#
# Everything expensive runs in a backgrounded subshell: a commit must never
# wait on the indexer, and a 30s daemon handshake must never look like a hang.
#
# Tunables (all optional):
#   CBM_EXE                  pin the indexer binary, skip resolution entirely
#   CODEBASE_MEMORY_MCP_BIN  same pin, under the name the MCP launcher honours
#   RAYON_NUM_THREADS        indexer thread pool (default 32)
#   CBM_MEM_BUDGET_MB        indexer RAM cap (default 16384)
#   CBM_POST_COMMIT_LOG      override the run-log path
#   CBM_SKIP_POST_COMMIT=1   disable for this one commit

export RAYON_NUM_THREADS="${RAYON_NUM_THREADS:-32}"
export CBM_MEM_BUDGET_MB="${CBM_MEM_BUDGET_MB:-16384}"

if [ "${CBM_SKIP_POST_COMMIT:-0}" = "1" ]; then
    exit 0
fi

_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$_REPO_ROOT" ]; then
    exit 0
fi

# cbm-resolve-start -------------------------------------------------------------
# Resolve the indexer binary. Order mirrors the MCP launcher on purpose, so the
# binary this hook spawns and the daemon the agents talk to are the same build.
_CBM_EXE="${CBM_EXE:-${CODEBASE_MEMORY_MCP_BIN:-}}"

# 1. Newest versioned Windows install - the UI daemon runs from this root.
if [ -z "$_CBM_EXE" ]; then
    _CBM_NEWEST="$(ls -1 "$HOME/AppData/Local/codebase-memory-mcp"/*/codebase-memory-mcp.exe 2>/dev/null | sort -V -r | head -1)"
    [ -n "$_CBM_NEWEST" ] && _CBM_EXE="$_CBM_NEWEST"
fi

# 2. Newest versioned POSIX install (macOS/Linux contributors).
if [ -z "$_CBM_EXE" ]; then
    _CBM_NEWEST="$(ls -1 "$HOME/.local/share/codebase-memory-mcp"/*/codebase-memory-mcp 2>/dev/null | sort -V -r | head -1)"
    [ -n "$_CBM_NEWEST" ] && _CBM_EXE="$_CBM_NEWEST"
fi

# 3. PATH. A fallback, never a first choice: a PATH entry can point at the
#    legacy Programs install, which is the build that refuses to join a newer
#    daemon. This is the exact ordering mistake that cost 535 commits.
if [ -z "$_CBM_EXE" ]; then
    _CBM_EXE="$(command -v codebase-memory-mcp 2>/dev/null || command -v codebase-memory-mcp.exe 2>/dev/null || true)"
fi

# 4. Legacy Programs install, last. Better a stale build that may fail loudly
#    in the log than no indexer at all.
if [ -z "$_CBM_EXE" ]; then
    for _CBM_D in "$HOME/AppData/Local/Programs/codebase-memory-mcp"; do
        if [ -x "$_CBM_D/codebase-memory-mcp.exe" ]; then
            _CBM_EXE="$_CBM_D/codebase-memory-mcp.exe"
            break
        fi
    done
fi

# 5. Bare POSIX locations.
if [ -z "$_CBM_EXE" ]; then
    for _CBM_D in "$HOME/.local/bin" /usr/local/bin; do
        if [ -x "$_CBM_D/codebase-memory-mcp" ]; then
            _CBM_EXE="$_CBM_D/codebase-memory-mcp"
            break
        fi
    done
fi
# cbm-resolve-end ---------------------------------------------------------------

if [ -z "$_CBM_EXE" ]; then
    # The only message this hook ever prints, and it prints for the one state a
    # developer can actually act on: the indexer is not installed anywhere.
    echo "post-commit: codebase-memory-mcp not found - graph index NOT refreshed" >&2
    exit 0
fi

# cbm-ghosts-start ---------------------------------------------------------------
# Relocate Windows reserved-name ghosts out of the repo root. Tracked paths are
# never touched: only files git does not know about are moved, and they are
# moved (not deleted), so a concurrent agent's in-flight file is recoverable.
_cbm_quarantine_ghosts() {
    _GQ_ROOT="${1:-}"
    [ -n "$_GQ_ROOT" ] || return 0
    _GQ_KEEP="$(git -C "$_GQ_ROOT" rev-parse --git-path cbm-ghosts 2>/dev/null || true)"
    [ -n "$_GQ_KEEP" ] || return 0
    # --git-path answers relative to the worktree, so re-anchor it: the caller
    # may not be sitting in the repo root.
    case "$_GQ_KEEP" in
        /*|[A-Za-z]:/*) : ;;
        *) _GQ_KEEP="$_GQ_ROOT/$_GQ_KEEP" ;;
    esac
    mkdir -p "$_GQ_KEEP" 2>/dev/null || return 0
    for _GQ_NAME in nul nul.txt con con.txt aux aux.txt prn prn.txt com1 lpt1; do
        _GQ_FILE="$_GQ_ROOT/$_GQ_NAME"
        [ -e "$_GQ_FILE" ] || continue
        if git -C "$_GQ_ROOT" ls-files --error-unmatch -- "$_GQ_NAME" >/dev/null 2>&1; then
            continue
        fi
        mv -f -- "$_GQ_FILE" "$_GQ_KEEP/$(date +%s)-$_GQ_NAME" 2>/dev/null || true
    done
    return 0
}
# cbm-ghosts-end -----------------------------------------------------------------

_CBM_LOG="${CBM_POST_COMMIT_LOG:-}"
if [ -z "$_CBM_LOG" ]; then
    _CBM_LOG="$(git rev-parse --git-path cbm-post-commit.log 2>/dev/null || true)"
fi
case "$_CBM_LOG" in
    /*|[A-Za-z]:/*) : ;;
    "") : ;;
    *) _CBM_LOG="$_REPO_ROOT/$_CBM_LOG" ;;
esac
[ -n "$_CBM_LOG" ] || _CBM_LOG="${TMPDIR:-/tmp}/cbm-post-commit.log"

(
    _CBM_LOG_FILE="$_CBM_LOG"
    # Keep the log bounded: 1679 historical runs would otherwise grow forever.
    if [ -f "$_CBM_LOG_FILE" ] && [ "$(wc -c <"$_CBM_LOG_FILE" 2>/dev/null || echo 0)" -gt 524288 ]; then
        mv -f -- "$_CBM_LOG_FILE" "$_CBM_LOG_FILE.old" 2>/dev/null || true
    fi

    _cbm_quarantine_ghosts "$_REPO_ROOT"

    printf '%s index start exe=%s root=%s\n' "$(date -Iseconds 2>/dev/null)" "$_CBM_EXE" "$_REPO_ROOT" >>"$_CBM_LOG_FILE"
    "$_CBM_EXE" cli index_repository \
        --repo-path "$_REPO_ROOT" \
        --mode full \
        --name "oz-pos" >>"$_CBM_LOG_FILE" 2>&1
    _CBM_STATUS=$?
    printf '%s index exit=%s\n' "$(date -Iseconds 2>/dev/null)" "$_CBM_STATUS" >>"$_CBM_LOG_FILE"
) &

exit 0
# codebase-memory-mcp auto-index end
