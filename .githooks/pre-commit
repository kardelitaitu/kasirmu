#!/bin/bash

# .githooks/pre-commit — auto-format Rust code before every commit.
set -e

# Locate rustup portably. The previous hardcoded WSL path
# (/mnt/c/Users/.../.cargo/bin/rustup.exe) broke the hook under Git Bash
# on Windows, where /mnt/c does not resolve. Prefer rustup on PATH, then
# rustup.exe, then the standard Windows install location under /c/.
RUSTUP=""
if command -v rustup >/dev/null 2>&1; then
    RUSTUP="rustup"
elif command -v rustup.exe >/dev/null 2>&1; then
    RUSTUP="rustup.exe"
else
    for d in /c/Users/*/.cargo/bin; do
        if [ -x "$d/rustup.exe" ]; then
            RUSTUP="$d/rustup.exe"
            break
        fi
    done
fi

if [ -z "$RUSTUP" ]; then
    echo "error: rustup not found — install Rust or add cargo's bin dir to PATH. Aborting commit." >&2
    exit 1
fi

# Locate Python portably. Git Bash on Windows ships `python` (not
# `python3`), while WSL/Linux have `python3` — hardcoding either breaks
# the bundle-parity / FTL-dedupe gates for the other environment.
PYTHON=""
if command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON="python"
fi

if [ -z "$PYTHON" ]; then
    echo "error: python3/python not found — install Python or add it to PATH. Aborting commit." >&2
    exit 1
fi

# ── cargo fmt ──────────────────────────────────────────────────────────────
# Run cargo fmt, capturing output if it fails
if ! "$RUSTUP" run stable cargo fmt --all 2>/dev/null; then
    echo "error: cargo fmt failed — aborting commit." >&2
    exit 1
fi

# Re-stage ONLY .rs files that are part of the current commit (staged
# before the hook ran). `git diff --name-only -- '*.rs'` lists every
# working-tree-modified Rust file — including other agents' in-flight
# changes — so adding that whole list swept unrelated Rust work into
# the commit despite this comment's earlier claim. Formatting fixes to
# .rs files outside the staged set stay in the worktree for their
# owner's own commit; the hook is a check, not a silent re-stage.
STAGED_RS=$(git diff --cached --name-only -- '*.rs')
if [ -n "$STAGED_RS" ]; then
    # Re-add only the .rs files that still exist in the worktree.
    # cargo fmt can only modify existing files, and `git add` on a
    # staged deletion (or any missing path) exits non-zero, which
    # `set -e` turns into an aborted commit.
    EXISTING_RS=""
    for f in $STAGED_RS; do
        if [ -f "$f" ]; then
            EXISTING_RS="$EXISTING_RS $f"
        fi
    done
    if [ -n "$EXISTING_RS" ]; then
        echo "cargo fmt applied changes to:"
        echo "$EXISTING_RS"
        git add $EXISTING_RS
    fi
fi

# ── Line-ending normalization ──────────────────────────────────────────────
# Normalizes staged text files to LF in BOTH the index and the working tree
# before commit. With `.gitattributes` (`* text=auto eol=lf`) git already
# stores LF in the index and expects LF in the working tree on every
# platform; this step is the enforcement net that repairs files staged from
# a CRLF checkout or by a CRLF-writing tool, then re-stages them so the
# committed blob is LF and `git status` is clean immediately after commit.
# It is a no-op for the normal case (LF already), and never touches
# binaries or staged deletions.
#
# It also honours per-path `eol` overrides: `*.bat`/`*.cmd` are `eol=crlf` in
# .gitattributes and are skipped. Without that the net silently fought the
# attribute on every batch file -- see the check-attr eol guard below.
STAGED_NORM=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
if [ -n "$STAGED_NORM" ]; then
    NORMALIZED_EOL=""
    for f in $STAGED_NORM; do
        [ -f "$f" ] || continue
        # Only files git treats as text -- and only ones that really are.
        #
        # `* text=auto` means check-attr answers "auto" for EVERY path, binary
        # included; the auto part is git's own content sniffing, which happens
        # later, inside `git add`. Filtering on check-attr alone therefore lets
        # a PNG through. Then `tr -d '\r'` removes the 0D 0A pair in the PNG
        # signature (`89 50 4E 47 0D 0A 1A 0A`), which the spec requires as a
        # line-ending check, and `git add` stores the mangled blob. Verified on
        # apps/desktop-client/icons/32x32.png: 1515 -> 1507 bytes, signature
        # destroyed. 40+ tracked icons contain CR bytes, so any commit that
        # stages one silently corrupts it -- data loss with a green hook.
        #
        # `grep -qI` is git-independent binary detection (a NUL in the first
        # buffer makes grep report the file as binary and skip it), so it
        # catches what check-attr's "auto" cannot.
        case "$(git check-attr text -- "$f")" in
            *"text: set"*|*"text: auto"*) ;;
            *) continue ;;
        esac
        if ! grep -qI '' -- "$f" 2>/dev/null; then
            continue   # git says text-ish, grep says binary: leave it alone
        fi
        # ...AND only files whose effective eol is LF. `.gitattributes` pins
        # `*.bat text eol=crlf` and `*.cmd text eol=crlf` because cmd.exe
        # mis-parses labels and `goto` in LF-only batch files. Checking `text`
        # without checking `eol` meant this loop saw a .bat as "text, so LF it"
        # and stripped the CR bytes out of the WORKING TREE. The index keeping
        # LF is correct and intended (.gitattributes L29); the working tree is
        # supposed to be CRLF. Observed: scripts/start-desktop.bat came out of a
        # hook run with 0 CRLFs while its never-committed sibling
        # start-local-sync.bat still had 167 -- and `git status` then reports the
        # file modified with a zero content diff, the phantom-M that makes people
        # commit noise "fixes".
        case "$(git check-attr eol -- "$f")" in
            *"eol: crlf"*) continue ;;
        esac
        # cmp -s after stripping CR: identical => already LF (skip);
        # differs => the file has CR bytes and gets normalized. This is
        # more robust than `grep -q $'\r'`, which native-Windows grep
        # builds can fail to match on CRLF input.
        if ! tr -d '\r' < "$f" | cmp -s - "$f"; then
            if tr -d '\r' < "$f" > "$f.lf.tmp"; then
                mv "$f.lf.tmp" "$f"
                git add -- "$f"
                NORMALIZED_EOL="$NORMALIZED_EOL $f"
            fi
        fi
    done
    if [ -n "$NORMALIZED_EOL" ]; then
        echo "normalized line endings to LF:"
        echo "$NORMALIZED_EOL"
    fi
fi

# ── i18n lint ──────────────────────────────────────────────────────────────
# Runs the local i18n quality gate (mirrors `.github/workflows/dev-ci.yml#i18n`)
# on every commit so translation gaps and Fluent
# key duplicates surface BEFORE reaching CI. ~1 second cost because
# it targets `i18nBundle.test.tsx` only.
if [ -f scripts/lint-i18n.sh ]; then
    if ! bash scripts/lint-i18n.sh; then
        echo "error: i18n lint failed — fix issues above or run 'bash scripts/check.sh' for context." >&2
        exit 1
    fi
fi

# ── Bundle parity: staged files only ───────────────────────────────────
# Runs `scripts/verify-bundle-parity.py --staged-only` against
# .tsx / .ts files modified in the current commit (cheap ~100ms;
# targeted, not full repo). Catches missing-translation regressions
# BEFORE push, independently of the baseline because it inspects only
# the files this commit touches. CI's `lint-i18n.sh` still runs the
# full-tree scan in complement; this hook is the commit-time
# cheap-fail-fast guard. Skipped silently when no eligible file is
# staged (e.g. a commit touching only Rust code or .ftl locale files).
#
# Scope covers eight surfaces (rev-2 getString/nav-keys, rev-3 key-fields
# and dynamic ternary literals, rev-4 id-map values) and every ui/src
# directory that renders copy (--scan-dirs), not just features/. Before the
# Fluent page audit the hook walked only literal <Localized id> under
# ui/src/features/**, and printed "path outside ui/src/features, skipping"
# for every shared chrome and context file it was handed, so
# `ContextMenu.tsx` could ship an unresolvable key with the gate reporting
# success.
#
# Reads .tsx/.ts from `git diff --cached --diff-filter=ACM` (added /
# copied / modified) and feeds them as positional args to the
# script. Uses `while read` + array (NOT `mapfile`) so the hook
# stays portable to bash 3.2 / macOS /bin/bash where `mapfile` is
# unavailable.
if [ -f scripts/verify-bundle-parity.py ]; then
    STAGED_FILES=()
    while IFS= read -r file; do
        STAGED_FILES+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
        | grep -E '\.(tsx|ts)$' || true)
    # || true: swallow grep no-match (e.g. no .tsx/.ts staged) + mask any upstream pipe failure.
    if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
        if ! "$PYTHON" scripts/verify-bundle-parity.py --staged-only \
                --include-getstring --include-nav-keys --include-key-fields \
                --include-dynamic-literals --include-id-maps --check-domain-pairs \
                --scan-dirs features,components,frontend,contexts,hooks,platform \
                "${STAGED_FILES[@]}"; then
            printf '%s\n' "error: bundle parity — staged files reference keys missing from one or both .ftl bundles. See verify-bundle-parity.py output above." >&2
            exit 1
        fi
    fi
fi

# ── FTL dedupe dry-run ────────────────────────────────────────────────────
# Runs `scripts/dedupe-ftl.py --dry-run` so any new Fluent key
# duplicates surface BEFORE reaching CI. ~50ms cost; runs in-process
# without mutating any files (use `npm run dedupe:ftl` to actually
# rewrite). Skipped silently when the script is not present.
# Gates on the script's exit code (1 = duplicates found, 0 = clean)
# rather than string-matching its output so the gate stays decoupled
# from the diagnostic wording. Captures both streams so the quiet
# path silences the "no duplicates" line entirely while the loud
# path prints the actual file list alongside the error.
if [ -f scripts/dedupe-ftl.py ]; then
    if output=$("$PYTHON" scripts/dedupe-ftl.py --dry-run 2>&1); then
        : # clean — silently discard the "no duplicates" line
    else
        printf '%s\n' "error: FTL duplicates detected — run 'npm run dedupe:ftl' to fix:" >&2
        printf '%s\n' "$output" >&2
        exit 1
    fi
fi

# ── Migration column-type lint ──────────────────────────────────────
# REAL/DOUBLE PRECISION columns silently corrupt exact-decimal values
# (LOYALTY-01: the 1.4 tier multiplier stored as 1.3999999999999999111
# made a $22.50 sale earn 31 points instead of 32; MONEY-01 same class).
# New float columns require a justified whitelist entry in the script.
# Runs only when the commit stages files under crates/oz-core/migrations/
# (the script re-derives the staged set itself, ~50ms). CI runs the full
# scan in complement (.github/workflows/dev-ci.yml # static-gates).
if [ -f scripts/verify-migration-column-types.py ]; then
    STAGED_MIG=$(git diff --cached --name-only --diff-filter=ACM -- 'crates/oz-core/migrations/*.sql' || true)
    if [ -n "$STAGED_MIG" ]; then
        if ! "$PYTHON" scripts/verify-migration-column-types.py --staged-only; then
            echo "error: migration column-type lint failed — exact-decimal values must be fixed-point integers (*_minor, *_millionths). See message above." >&2
            exit 1
        fi
    fi
fi

# ── PG schema drift guard ─────────────────────────────────────────
# crates/oz-core/migrations/20260813_init.pg.sql is GENERATED from the
# full SQLite migration chain by scripts/generate-pg-migration.py and
# must never be hand-edited. Any staged change to a migration file, the
# registry, the generator, or the PG file itself re-derives the expected
# output (~2s: two independent renders prove determinism); drift aborts
# the commit. CI runs the same --check unconditionally
# (.github/workflows/dev-ci.yml # static-gates).
if [ -f scripts/generate-pg-migration.py ]; then
    STAGED_PG_TRIGGER=$(git diff --cached --name-only --diff-filter=ACM -- \
        'crates/oz-core/migrations/*.sql' 'crates/oz-core/src/migrations.rs' \
        'scripts/generate-pg-migration.py' || true)
    if [ -n "$STAGED_PG_TRIGGER" ]; then
        if ! "$PYTHON" scripts/generate-pg-migration.py --check; then
            echo "error: Postgres schema drift — regenerate with 'python3 scripts/generate-pg-migration.py' and re-stage 20260813_init.pg.sql." >&2
            exit 1
        fi
    fi
fi

# ── Go gate: apps/license-server ──────────────────────────────────────
# gofmt (auto-fix + re-stage, mirroring the cargo fmt step above) and
# `go vet ./...` (hard fail) for the Go license server. Runs only when
# the commit stages .go files under apps/license-server/. Line endings
# are handled by the normalization step above (.gitattributes pins LF
# everywhere), so gofmt -l is reliable here; auto-fixing with
# `gofmt -w` still re-stages real formatting changes. CI runs the
# strict `gofmt -l` check on its LF checkout
# (`.github/workflows/dev-ci.yml` # static-gates).
STAGED_GO=$(git diff --cached --name-only -- 'apps/license-server/*.go')
if [ -n "$STAGED_GO" ]; then
    if ! command -v go >/dev/null 2>&1 || ! command -v gofmt >/dev/null 2>&1; then
        echo "error: go/gofmt not found — install Go (https://go.dev/dl/) or add its bin dir to PATH. Aborting commit." >&2
        exit 1
    fi
    # Auto-format staged .go files, then re-add only the ones that still
    # exist and actually changed. gofmt -w on a CRLF-only file normalizes
    # it to LF; git re-stores LF in the blob, so there is no staged diff
    # and no line-ending churn. `git diff --quiet` masks the CRLF-only
    # case (exit 0) and only flags real formatting changes (exit 1).
    if ! gofmt -w $STAGED_GO 2>/dev/null; then
        echo "error: gofmt failed — aborting commit." >&2
        exit 1
    fi
    EXISTING_GO=""
    for f in $STAGED_GO; do
        if [ -f "$f" ]; then
            EXISTING_GO="$EXISTING_GO $f"
        fi
    done
    if [ -n "$EXISTING_GO" ] && ! git diff --quiet -- $EXISTING_GO; then
        echo "gofmt applied changes to:"
        echo "$EXISTING_GO"
        git add $EXISTING_GO
    fi
    # go vet — read-only module-wide check; hard fail on issues.
    if ! (cd apps/license-server && go vet ./...); then
        echo "error: go vet failed — fix issues above or run 'cd apps/license-server && go vet ./...'." >&2
        exit 1
    fi
fi

# ── UI typecheck (staged ui/src TypeScript only) ───────────────────────────
# `npm run test` does NOT type-check: Vitest injects describe/it/expect/beforeEach/vi
# at runtime, so a test file that forgets to import one passes locally and fails
# `tsc --noEmit`. Ten commits this week landed with HEAD red for exactly this and its
# neighbours — an unused import (TS6133), a fixture whose `as T` cast was approving
# wrong field types, a widened `status: string` against a union. All of them were
# detectable in 21 seconds by the one command nothing ran before commit.
#
# Scope is deliberately narrow: only fires when the commit stages a .ts/.tsx under
# ui/src, so Rust-only, CI-only and docs-only commits keep the previous ~6s cost.
# tsc cannot meaningfully check a subset of a project (a file's errors depend on the
# whole program), so when it does fire it checks everything.
#
# OZPOS_SKIP_TYPECHECK=1 skips this step alone. Prefer it to `git commit --no-verify`,
# which skips all nine gates including the ones that are fast and never wrong.
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM -- 'ui/src/*.ts' 'ui/src/*.tsx' || true)
if [ -n "$STAGED_TS" ] && [ "${OZPOS_SKIP_TYPECHECK:-0}" != "1" ]; then
    if [ -d ui/node_modules ]; then
        echo "ui typecheck ($(echo "$STAGED_TS" | wc -l | tr -d ' ') staged file(s), ~21s)..."
        if ! (cd ui && npm run --silent typecheck); then
            echo "" >&2
            echo "error: TypeScript type-check failed — the commit stages ui/src TypeScript." >&2
            echo "       Fix the errors above, or set OZPOS_SKIP_TYPECHECK=1 to skip this step." >&2
            echo "       (Avoid 'git commit --no-verify': it skips every gate, not just this one.)" >&2
            exit 1
        fi
    else
        # Skipping silently here would mean the gate nobody noticed was missing was
        # also the gate that never ran. Say so on every commit that could have used it.
        echo "warning: ui/node_modules missing — UI typecheck skipped. Run 'cd ui && npm ci'." >&2
    fi
fi
