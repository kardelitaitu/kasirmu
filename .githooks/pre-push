#!/bin/bash
# .githooks/pre-push — parallelized path-aware local gate, run once per push.
#
# WHY THIS EXISTS
# dev-ci.yml is the only live workflow and it re-runs the whole matrix on every
# push to an open PR. Locally, running static gates and language suites concurrently
# across CPU cores drops pre-push validation time from ~2.5 minutes to ~15-60s.
#
# Escape hatch: `git push --no-verify` skips this entirely, silently.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# ── Portable toolchain resolution ────────────────────────────────────────
PYTHON=""
for p in python3 python; do
    if command -v "$p" >/dev/null 2>&1; then PYTHON="$p"; break; fi
done

# ── Which refs are being pushed, and what changed? ───────────────────────
ZERO=0000000000000000000000000000000000000000
CHANGED=""
ANY_PUSH=0
NEW_BRANCH=0

while read -r _lref loid _rref roid; do
    [ -z "${loid:-}" ] && continue
    # Deleting a remote branch: nothing to check.
    [ "$loid" = "$ZERO" ] && continue
    ANY_PUSH=1
    if [ "$roid" = "$ZERO" ]; then
        # Brand-new branch: no remote ancestor to diff against.
        NEW_BRANCH=1
        continue
    fi
    if base=$(git merge-base "$roid" "$loid" 2>/dev/null); then
        CHANGED="$CHANGED
$(git diff --name-only "$base" "$loid" 2>/dev/null)"
    else
        # Unrelated histories (force-push, rebase onto a different root).
        NEW_BRANCH=1
    fi
done

# Fail safe: if no refs pushed, exit cleanly.
if [ "$ANY_PUSH" = "0" ]; then
    exit 0
fi

if [ "$NEW_BRANCH" = "1" ] || [ -z "$(printf '%s' "$CHANGED" | tr -d '[:space:]')" ]; then
    ROUTE_ALL=1
else
    ROUTE_ALL=0
fi

want() {
    [ "$ROUTE_ALL" = "1" ] && return 0
    printf '%s\n' "$CHANGED" | grep -qE "$1"
}

FLAGS=""
if [ "$ROUTE_ALL" = "1" ]; then
    FLAGS="--all"
else
    want '^crates/|^modules/|^platform/|^foundation/|^apps/(cloud-server|desktop-client|tablet-client)/|^fuzz/|^scripts/updater-compat-check/|^Cargo\.(toml|lock)$|^\.cargo/|^rust-toolchain' && FLAGS="$FLAGS --rust"
    want '^ui/' && FLAGS="$FLAGS --ui"
    want '^website/' && FLAGS="$FLAGS --website"
    want '^ui/src/locales/|^ui/src/.*\.(ts|tsx)$|^scripts/lint-i18n\.sh$|^scripts/verify-bundle-parity\.py$|^scripts/dedupe-ftl\.py$' && FLAGS="$FLAGS --i18n"
fi

echo "pre-push: $(printf '%s\n' "$CHANGED" | grep -c . ) changed file(s) detected"
if [ -n "$PYTHON" ] && [ -f "scripts/run-pre-push.py" ]; then
    "$PYTHON" scripts/run-pre-push.py $FLAGS
    exit $?
else
    echo "warning: python not found on PATH, pre-push checks skipped"
    exit 0
fi
