# ── Android Build Pipeline ─────────────────────────────────────────────
#
# Builds a signed Android APK + AAB for the OZ-POS tablet client.
#
# Triggered by:
#   - Push to main (verifies the build compiles)
#   - Tag v* (creates a release artifact)
#   - Manual workflow_dispatch
#
# Secrets required:
#   ANDROID_KEYSTORE_BASE64  — base64-encoded .keystore file
#   KEYSTORE_PASSWORD        — keystore master password
#   KEY_PASSWORD             — key password (defaults to KEYSTORE_PASSWORD)
#   KEY_ALIAS                — key alias in the keystore

name: Android Build

# ⚠️ Stub — disabled on push/PR until the NDK toolchain is fully
# stabilised. Run manually via workflow_dispatch or tag push (v*)
# when a release build is needed.
#
# AUDIT-28 RELEASE-02/09: on tag pushes the APK/AAB are uploaded directly
# into the SAME GitHub Release created by release.yml (via gh release
# upload, waiting for the release to exist) so mobile artifacts are not
# stranded in a separate workflow run. The concurrency group prevents
# duplicate-tag upload races.
on:
  push:
    tags: ['v*']
  workflow_dispatch:

concurrency:
  group: release-android-${{ github.ref_name }}
  cancel-in-progress: false

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: -D warnings
  RUSTC_WRAPPER: sccache
  SCCACHE_GHA_ENABLED: "true"

defaults:
  run:
    shell: bash

# CICD-01: least-privilege default; android-build grants contents: write
# in its own block for the release upload.
permissions:
  contents: read

jobs:
  android-build:
    name: Android APK
    runs-on: ubuntu-latest
    # AUDIT-28 RELEASE-02: the release.yml workflow creates the GitHub
    # Release only after all matrix builds finish (build timeouts are 60
    # min each), so this job must survive the build + a long poll window.
    timeout-minutes: 120
    # RELEASE-02: contents:write lets the tag step upload straight to the
    # release created by release.yml; build steps otherwise need nothing.
    permissions:
      contents: write
    env:
      ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}

    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      # ── JDK + Android SDK ──────────────────────────────────────
      - name: Setup JDK 17
        uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Android SDK
        uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3

      # ── Rust toolchain ─────────────────────────────────────────
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        with:
          targets: aarch64-linux-android,armv7-linux-androideabi,x86_64-linux-android

      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}

      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10

      # ── Node / UI dependencies ─────────────────────────────────
      - name: Setup Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'

      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts

      - name: Build UI (tablet)
        run: cd ui && npx vite build --config vite.tablet.config.ts

      # ── Install cargo-ndk + Tauri CLI ──────────────────────────
      - name: Install cargo-ndk
        run: cargo install cargo-ndk --locked

      - name: Install Tauri CLI
        run: cargo install tauri-cli --version "^2" --locked

      # ── Initialize Android project ─────────────────────────────
      - name: Initialize Tauri Android project
        run: |
          cd apps/tablet-client
          cargo tauri android init

      # ── Decode keystore ────────────────────────────────────────
      # Writes keystore.properties in gen/android/ (the official Tauri v2
      # signing route — the CLI has no keystore flags; build.gradle.kts
      # reads this file and applies the release signingConfig when present).
      - name: Decode keystore
        if: env.ANDROID_KEYSTORE_BASE64 != ''
        run: |
          cd apps/tablet-client/gen/android
          printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 -d > oz-pos-release.keystore
          echo "keyAlias=$KEY_ALIAS" > keystore.properties
          echo "password=$KEYSTORE_PASSWORD" >> keystore.properties
          echo "storeFile=$(pwd)/oz-pos-release.keystore" >> keystore.properties
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}

      # ── Build APK + AAB ────────────────────────────────────────
      - name: Build Android APK
        run: |
          cd apps/tablet-client
          cargo tauri android build --apk --target aarch64

      # ── CICD-04: remove signing material after the build ───────
      # keystore.properties holds the plaintext passwords and the decoded
      # .keystore is the signing key itself; nothing after this step needs
      # them and the artifact upload path (app/build/outputs) is scoped,
      # but the files must not linger in the workspace.
      - name: Remove decoded signing material
        if: always()
        run: |
          rm -f apps/tablet-client/gen/android/oz-pos-release.keystore
          rm -f apps/tablet-client/gen/android/keystore.properties

      # ── Locate output files ────────────────────────────────────
      - name: Find APK output
        run: |
          find apps/tablet-client/gen/android -name "*.apk" -o -name "*.aab" 2>/dev/null | head -20

      # ── Upload APK artifact ────────────────────────────────────
      - name: Upload APK
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: oz-pos-tablet-aarch64.apk
          path: |
            apps/tablet-client/gen/android/app/build/outputs/apk/**/*.apk
            apps/tablet-client/gen/android/app/build/outputs/bundle/**/*.aab
          retention-days: 90

      # ── RELEASE-02: attach APK/AAB to the release.yml GitHub Release ──
      # The release may still be building (matrix builds + publish job);
      # poll for it for up to ~60 minutes, then upload with --clobber so
      # retries are idempotent. Fails only if the release never appears or
      # no APK/AAB was produced.
      - name: Upload APK/AAB to GitHub Release (tag only)
        if: startsWith(github.ref, 'refs/tags/v')
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          TAG="${{ github.ref_name }}"
          found=0
          for i in $(seq 1 180); do
            if gh release view "$TAG" >/dev/null 2>&1; then
              echo "Release $TAG found (attempt $i)"
              found=1
              break
            fi
            if [ $((i % 10)) -eq 0 ]; then echo "Release $TAG not ready yet (attempt $i/180)..."; fi
            sleep 20
          done
          [ "$found" -eq 1 ] || { echo "::error::release $TAG not found after 60 min — release.yml likely failed"; exit 1; }
          APK=$(find apps/tablet-client/gen/android -name '*.apk' -o -name '*.aab' 2>/dev/null | head -1)
          if [ -z "$APK" ]; then
            echo "::error::no APK/AAB produced — cannot attach to release"
            exit 1
          fi
          echo "Uploading to release $TAG:"
          find apps/tablet-client/gen/android \( -name '*.apk' -o -name '*.aab' \) -exec echo "  {}" \;
          # Retry the upload (transient API/network failures) with --clobber.
          for attempt in 1 2 3; do
            if gh release upload "$TAG" $(find apps/tablet-client/gen/android \( -name '*.apk' -o -name '*.aab' \)) --clobber; then
              echo "Upload succeeded (attempt $attempt)"
              break
            fi
            echo "Upload failed (attempt $attempt/3), retrying..."
            sleep 15
            if [ "$attempt" -eq 3 ]; then echo "::error::upload to release $TAG failed"; exit 1; fi
          done

      # ── sccache stats ──────────────────────────────────────────
      - name: sccache stats
        run: sccache --show-stats
