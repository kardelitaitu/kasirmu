name: Security

on:
  schedule:
    # Run weekly on Monday morning UTC.
    - cron: '0 6 * * 1'
  workflow_dispatch:

# CICD-01: least-privilege default; container-scan grants
# security-events: write in its own block.
permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  audit:
    name: cargo audit
    runs-on: ubuntu-latest
    # The ubuntu runner image globally sets RUSTC_WRAPPER=sccache, but sccache
    # is only installed on PATH by mozilla/sccache-action (used by the other
    # Rust jobs). cargo-audit invokes `cargo metadata`, whose rustc version
    # probe execs `sccache .../bin/rustc -vV` and dies with "No such file or
    # directory" when sccache is not installed. Override the wrapper to empty
    # so rustc resolves normally — same pattern as the fuzz job in ci.yml.
    env:
      RUSTC_WRAPPER: ''
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - run: cargo install --locked cargo-audit
      - run: cargo audit

  deny:
    name: cargo deny
    runs-on: ubuntu-latest
    # Same runner-image sccache wrapper issue as the audit job: cargo-deny's
    # internal `cargo metadata` probe dies with "could not execute process
    # sccache .../bin/rustc -vV (No such file or directory)". Disable the
    # wrapper (fuzz-job pattern, see ci.yml) — sccache provides no benefit for
    # a metadata-only gate.
    env:
      RUSTC_WRAPPER: ''
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - run: cargo install --locked cargo-deny
      - run: cargo deny check

  # ── Container scan (cloud + license) ────────────────────────────
  #
  # DOCKER-03: Trivy on BOTH application images, blocking on
  # CRITICAL/HIGH with a documented exception mechanism (.trivyignore).
  # Weekly schedule + manual dispatch complement the per-PR scan in ci.yml.
  container-scan:
    name: Trivy container scan
    runs-on: ubuntu-latest
    # SARIF upload needs the token to write code-scanning results; the repo
    # default GITHUB_TOKEN is read-only (no permissions block = no
    # security-events: write), which made upload-sarif fail with "Resource
    # not accessible by integration" on every scheduled run.
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Build cloud image
        run: docker build -f Dockerfile.server -t oz-pos-cloud:security .
      - name: Build license image
        run: docker build -f apps/license-server/Dockerfile -t oz-pos-license:security apps/license-server
      # DOCKER-03: `ignorefile` is not a valid trivy-action input — use `trivyignores`
      # (silently dropped → baseline never applied); use `trivyignores`.
      # Also set `limit-severities-for-sarif: true` so SARIF mode keeps the
      # CRITICAL/HIGH filter (otherwise the action scans ALL severities).
      # continue-on-error + the explicit gate keep both SARIFs uploaded even
      # when findings exist, then fail the job AFTER uploads.
      - name: Scan cloud image (blocking)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        continue-on-error: true
        with:
          image-ref: oz-pos-cloud:security
          format: sarif
          exit-code: 1
          severity: CRITICAL,HIGH
          limit-severities-for-sarif: true
          trivyignores: .trivyignore
          output: trivy-cloud.sarif
      - name: Scan license image (blocking)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        continue-on-error: true
        with:
          image-ref: oz-pos-license:security
          format: sarif
          exit-code: 1
          severity: CRITICAL,HIGH
          limit-severities-for-sarif: true
          trivyignores: .trivyignore
          output: trivy-license.sarif
      - name: Upload Trivy SARIF (cloud)
        if: always()
        uses: github/codeql-action/upload-sarif@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4
        with:
          sarif_file: trivy-cloud.sarif
          category: trivy-cloud
      - name: Upload Trivy SARIF (license)
        if: always()
        uses: github/codeql-action/upload-sarif@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4
        with:
          sarif_file: trivy-license.sarif
          category: trivy-license
      - name: Fail if Trivy found CRITICAL/HIGH findings
        if: always()
        shell: bash
        run: |
          FAILED=0
          for f in trivy-cloud.sarif trivy-license.sarif; do
            if [ ! -f "$f" ]; then
              echo "::error::Missing SARIF file $f — scan produced no report"
              FAILED=1
              continue
            fi
            count=$(jq '[.runs[]?.results[]?] | length' "$f")
            if [ "$count" -gt 0 ]; then
              echo "::error::Trivy found $count CRITICAL/HIGH finding(s) in $f"
              jq -r '.runs[]?.results[]? | "\(.ruleId): \(.message.text // .message // "")"' "$f" | head -n 30 || true
              FAILED=1
            else
              echo "OK: no CRITICAL/HIGH findings in $f"
            fi
          done
          exit $FAILED
