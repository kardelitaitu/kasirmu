# ── CI Pipeline ─────────────────────────────────────────────────────
#
# Goals:
#   • < 5 min for lint + typecheck + unit tests (down from ~10 min)
#   • Parallel Rust jobs: fmt, clippy, test (cross-platform)
#   • Parallel UI jobs: lint, typecheck, test
#   • sccache for cross-job Rust compilation caching
#   • save-always: true to persist cache across PR branches
#
# Trigger: every push/PR to main.
# All jobs are independent — no `needs` dependency unless noted.

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: -D warnings
  SCCACHE_GHA_ENABLED: "true"

defaults:
  run:
    shell: bash

# CICD-01: least-privilege default; jobs that write (GHCR push, SARIF
# upload) grant it in their own permissions blocks.
permissions:
  contents: read

jobs:
  # ── Change Detection (PR Path Filtering) ────────────────────────────
  # Evaluates path filters on pull requests so non-relevant jobs skip.
  # On push to main, all required merge validation jobs run normally.
  changes:
    name: Detect Changes
    runs-on: ubuntu-latest
    outputs:
      rust: ${{ steps.filter.outputs.rust }}
      ui: ${{ steps.filter.outputs.ui }}
      docker: ${{ steps.filter.outputs.docker }}
      e2e: ${{ steps.filter.outputs.e2e }}
      go: ${{ steps.filter.outputs.go }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dorny/paths-filter@0e4a8c6effa4802afeda77dc8d303f8176d7dfad # v3
        id: filter
        with:
          filters: |
            rust:
              - 'crates/**'
              - 'platform/**'
              - 'modules/**'
              - 'apps/desktop-client/**'
              - 'apps/tablet-client/**'
              - 'apps/cloud-server/**'
              - 'foundation/**'
              - 'fuzz/**'
              - 'Cargo.toml'
              - 'Cargo.lock'
              - '.cargo/**'
              - 'rust-toolchain.toml'
              - '.github/workflows/ci.yml'
            ui:
              - 'ui/**'
              - '.github/workflows/ci.yml'
            docker:
              - 'Dockerfile*'
              - 'docker-compose*'
              - 'apps/license-server/**'
              - 'apps/cloud-server/**'
              - '.github/workflows/ci.yml'
            e2e:
              - 'ui/e2e/**'
              - 'docker-compose.e2e.yml'
              - 'scripts/run-e2e.mjs'
              - 'scripts/__tests__/**'
              - '.github/workflows/ci.yml'
            go:
              - 'apps/license-server/**'
              - '.github/workflows/ci.yml'

  # ── Rust: Format (fastest — ~30s, no deps needed) ──────────────────
  rust-fmt:
    name: Rust Format
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - run: cargo fmt --all -- --check

  # ── Go: format + vet (apps/license-server) ─────────────────────────
  # Fail-closed gate for the Go license server: `gofmt -l` must report
  # zero unformatted files and `go vet ./...` must pass. The ubuntu
  # checkout is LF, so the strict gofmt check is authoritative (no CRLF
  # false positives — the commit-time hook in `.githooks/pre-commit`
  # auto-fixes instead because Windows checkouts are CRLF on disk).
  go:
    name: Go Format + Vet
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.go == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: apps/license-server/go.mod
          cache-dependency-path: apps/license-server/go.sum
      - name: Check gofmt
        run: |
          UNFORMATTED=$(gofmt -l apps/license-server)
          if [ -n "$UNFORMATTED" ]; then
            echo "::error::gofmt violations in apps/license-server:"
            echo "$UNFORMATTED"
            exit 1
          fi
      - name: Run go vet
        run: cd apps/license-server && go vet ./...
      - name: Run Go tests (short mode)
        # The full license-server suite is ~82s; -short skips the slowest
        # Midtrans webhook integration tests (each carries a load-bearing
        # 1.1s sleep for second-precision expiry assertions) so quick CI
        # stays fast while the full suite still runs in pre-merge builds.
        # gofmt + vet gate formatting/types; tests gate behavior.
        run: cd apps/license-server && go test -short ./...
  # Unified image healthcheck script test — exercises the SMTP sender-identity
  # gate counter logic in apps/unified/healthcheck.sh against a fake-wget
  # harness (apps/unified/test-healthcheck.sh). Pure POSIX sh, no toolchain.
  unified-healthcheck:
    name: Unified Healthcheck Script Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Run unified healthcheck script test
        run: sh apps/unified/test-healthcheck.sh

  # ── Rust: Panic-inventory gate (RUST-07 / ADR #33) — fail-closed ────
  # Fails when any production unwrap()/expect() lacks a documented
  # invariant comment (// SAFETY: / // INVARIANT: on the same or preceding
  # line). Pure python — no toolchain deps, so it stays fast.
  rust-panic-inventory:
    name: Rust Panic Inventory
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Scan production unwrap/expect inventory
        run: python3 scripts/scan-unwrap-panic.py --fail-on-recoverable

  # ── Rust: Hardcoded money-format gate — fail-closed ─────────────────
  # Fails when production .rs code hardcodes `/ 100` division or `{}.{:02}`
  # format strings instead of foundation::format_minor() (a regression
  # would silently mis-render IDR/JPY/KWD amounts that have 0/3-decimal
  # minor units). Pure python — no toolchain deps, so it stays fast.
  rust-money-format:
    name: Rust Money Format
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify no hardcoded exp-2 money formatting
        run: python3 scripts/verify-no-hardcoded-money-format.py

  # ── Migration column-type lint (LOYALTY-01 / MONEY-01 class guard) ──
  # REAL/DOUBLE PRECISION columns silently corrupt exact-decimal values
  # (the 1.4 tier multiplier stored as 1.3999999999999999111 earned 31
  # points where the owner meant 32). New float columns need a justified
  # whitelist entry in the script; stale exemptions also fail. Mirrored
  # as a staged-only pre-commit gate in .githooks/pre-commit.
  migration-column-types:
    name: Migration Column Types
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify no unwhitelisted float columns in migrations
        run: python3 scripts/verify-migration-column-types.py

  # ── Postgres schema drift guard ──────────────────────────────────────
  # 20260813_init.pg.sql is GENERATED from the full SQLite migration
  # chain (registry order, applied and dumped at final state) by
  # scripts/generate-pg-migration.py — hand-porting incrementals onto it
  # is how the PG twin silently diverged (per-tenant uniqueness,
  # product_activity.tenant_id). --check renders twice (determinism
  # self-proof) and diffs against the committed file; drift fails here
  # and in .githooks/pre-commit. Needs python ≥ 3.35-sqlite for
  # DROP COLUMN-era migrations (ubuntu-latest ships 3.37+).
  pg-schema-drift:
    name: Postgres Schema Drift Guard
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify generated PG schema matches the migration chain
        run: python3 scripts/generate-pg-migration.py --check

  # ── Architecture boundary checker (P1 pilot) ───────────────────────
  # Static-only enforcement: existing transitional findings are tracked in
  # the expiring baseline; new, expired, or stale findings block CI.
  architecture-boundaries:
    name: Architecture Boundaries
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - name: Verify architecture boundaries
        run: python3 scripts/verify-architecture-boundaries.py --strict

  ipc-parity:
    name: IPC Registration Parity
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify IPC parity (F-008/F-050)
        run: python3 scripts/verify-ipc-parity.py

  # ── Rust: Clippy (needs system deps for compilation, all-features) ─
  rust-clippy:
    name: Rust Clippy
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Clippy (workspace, all features, exclude Tauri binaries)
        run: cargo clippy --workspace --all-targets --all-features --exclude oz-pos-app --exclude oz-pos-tablet -- -D warnings
      - name: sccache stats
        run: sccache --show-stats

  # ── Rust: Test Fast Track (default features, < 3 min) ─────────────
  #
  # PRs only run this job. It excludes `slow-tests` feature gates
  # (10 platform/sync integration tests with multi-second delays).
  # Sharded 5-ways for parallel crate-group execution.
  rust-test-fast:
    name: Rust Test Fast (${{ matrix.shard }})
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'pull_request' && needs.changes.outputs.rust == 'true'
    # Postgres for the cloud-server / oz-api PG integration tests
    # (`OZ_TEST_PG_URL`). Without it those tests skip-if-unreachable and the
    # Postgres data layer would never actually run in CI.
    env:
      OZ_TEST_PG_URL: postgres://postgres:postgres@localhost:5432/postgres
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    strategy:
      fail-fast: false
      matrix:
        shard:
          - crate: oz-core
          - crate: crates
          - crate: platform
          - crate: modules
          - crate: apps
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install cargo-nextest
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      - name: Run crate-group tests (nextest)
        run: |
          case "${{ matrix.shard.crate }}" in
            oz-core)
              cargo nextest run -p oz-core --profile ci
              ;;
            crates)
              for pkg in oz-api oz-cli oz-hal oz-logging oz-lua oz-payment oz-plugin oz-reporting oz-security; do
                cargo nextest run -p "$pkg" --profile ci || exit 1
              done
              ;;
            platform)
              for pkg in foundation platform-core platform-kernel platform-startup platform-sync; do
                cargo nextest run -p "$pkg" --profile ci || exit 1
              done
              ;;
            modules)
              for pkg in modules-crm modules-currency modules-inventory modules-reporting modules-sales modules-settings modules-staff modules-tax modules-terminal; do
                cargo nextest run -p "$pkg" --profile ci || exit 1
              done
              ;;
            apps)
              # AUDIT-27 CI-01: failures must propagate — no `|| true` swallow.
              for pkg in oz-cloud-server oz-pos-app oz-pos-tablet; do
                cargo nextest run -p "$pkg" --profile ci || exit 1
              done
              ;;
          esac
      - name: sccache stats
        run: sccache --show-stats

  # ── Rust: Sync slow-tests integration suite (audit/09 SYNC residual) ─
  #
  # The 19 HTTP push/pull/conflict/retry/tenant integration tests are
  # gated behind `--features slow-tests` and are NOT covered by the PR
  # fast track. This dedicated job runs them on every main-branch push so
  # the full sync scenario suite is an explicit release gate, and uploads
  # the nextest JUnit report for visibility.
  sync-slow-tests:
    name: Sync Integration (slow-tests)
    runs-on: ubuntu-latest
    continue-on-error: ${{ github.event_name == 'pull_request' }}
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    # Runs on every main push (release gate for the slow HTTP sync suite).
    # On PRs it only runs when sync-relevant code changed (platform/sync +
    # its deps) — the suite's multi-second integration tests would
    # otherwise burn ~3 min on every PR commit for no signal. Mirrors the
    # security-pr fail-closed gate pattern: a missing/unresolvable base
    # SHA runs the suite rather than silently skipping.
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0  # Needed for the PR diff against base
      - name: Check for sync-relevant changes
        id: gate
        run: |
          if [ "${{ github.event_name }}" != "pull_request" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          BASE="${{ github.event.pull_request.base.sha }}"
          if [ -z "$BASE" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "::warning::No base SHA — running sync slow-tests (fail-closed)"
            exit 0
          fi
          git fetch --no-tags --depth=1 origin "$BASE" >/dev/null 2>&1 || true
          if ! git cat-file -e "${BASE}^{commit}" 2>/dev/null; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "::warning::Base SHA $BASE not fetchable — running sync slow-tests (fail-closed)"
            exit 0
          fi
          # git diff rc: 0 = no differences, 1 = differences, >1 = error.
          # A failed diff must run the suite (fail-closed), never skip it.
          git diff --name-only "$BASE"...HEAD > /tmp/oz-changed.txt 2>/dev/null
          RC=$?
          if [ "$RC" -gt 1 ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "::warning::git diff failed (rc=$RC) — running sync slow-tests (fail-closed)"
            exit 0
          fi
          CHANGED=$(grep -E '^(platform/sync/|crates/oz-core/|foundation/|Cargo\.toml$|Cargo\.lock$)' /tmp/oz-changed.txt || true)
          if [ -n "$CHANGED" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "Sync-relevant files changed:"
            echo "$CHANGED"
          else
            echo "run=false" >> "$GITHUB_OUTPUT"
            echo "No sync-relevant changes — slow-tests skipped."
          fi
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        if: steps.gate.outputs.run == 'true'
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        if: steps.gate.outputs.run == 'true'
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: steps.gate.outputs.run == 'true' && runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
        if: steps.gate.outputs.run == 'true'
      - name: Install cargo-nextest
        if: steps.gate.outputs.run == 'true'
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      - name: Run platform-sync integration suite (slow-tests feature)
        if: steps.gate.outputs.run == 'true'
        run: cargo nextest run -p platform-sync --features slow-tests --profile ci
      - name: sccache stats
        if: steps.gate.outputs.run == 'true'
        run: sccache --show-stats
      - name: Upload JUnit report
        if: always() && steps.gate.outputs.run == 'true'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: sync-slow-tests-junit
          path: target/nextest/ci/junit.xml
          retention-days: 7

  # ── Rust: Test Full (all features, main-branch + manual only) ─────
  rust-test-full:
    name: Rust Test Full (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    if: github.event_name == 'push'
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies (Linux)
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install cargo-nextest
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      - name: Run workspace tests (nextest, all features)
        run: cargo nextest run --workspace --all-features --exclude oz-pos-app --exclude oz-pos-tablet --profile ci
      - name: sccache stats
        run: sccache --show-stats

  # ── Rust: App crate tests (dedicated — AUDIT-27 CI-01) ───────────
  #
  # The two Tauri app crates are excluded from rust-test-full, nightly,
  # and release test jobs because their desktop/mobile build targets need
  # the webkit/gtk system libraries. This dedicated job runs their unit
  # tests on ubuntu (where the system deps ARE installed) so the app
  # command surfaces are never silently untested. The old `2>/dev/null
  # || true` in rust-test-fast's apps shard was removed: failures now
  # fail fast in BOTH the PR fast track and this push/job run.
  rust-test-apps:
    name: Rust Test Apps
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true'
    # Postgres for the cloud-server PG integration tests (same rationale as
    # rust-test-fast).
    env:
      OZ_TEST_PG_URL: postgres://postgres:postgres@localhost:5432/postgres
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install cargo-nextest
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      - name: Run app crate tests (nextest, default features)
        run: cargo nextest run -p oz-cloud-server -p oz-pos-app -p oz-pos-tablet --profile ci
      - name: sccache stats
        run: sccache --show-stats

  # ── UI: Lint ──────────────────────────────────────────────────────
  ui-lint:
    name: UI Lint
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.ui == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - run: cd ui && npm run lint

  # ── UI: TypeCheck ─────────────────────────────────────────────────
  ui-typecheck:
    name: UI TypeCheck
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.ui == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - run: cd ui && npm run typecheck

  # ── UI: Tests + quality gates (4-way sharded) ────────────────────
  ui-test:
    name: UI Tests (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.ui == 'true'
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2, 3, 4]
        totalShards: [4]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      # Persist Vitest transform cache across runs (P27-5)
      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
        with:
          path: ui/node_modules/.cache/vitest
          # AUDIT-27 CI-05: shard-scoped save key — concurrent shard
          # writes no longer contend on one mutable cache entry.
          key: vitest-cache-${{ runner.os }}-${{ matrix.shard }}-${{ hashFiles('ui/package-lock.json') }}
          restore-keys: vitest-cache-${{ runner.os }}-
      - run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Run vitest (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
        # AUDIT-27 CI-04: explicit pipefail shell — a failing test before
        # `tee` must fail the step, not be masked by a successful tee.
        shell: bash --noprofile --norc -eo pipefail {0}
        run: (cd ui && npm run test -- --reporter=verbose --shard=${{ matrix.shard }}/${{ matrix.totalShards }} --pool=forks 2>&1) | tee ui/vitest-output.log

      # Hard-fail on any act() or flushSync warnings. Components
      # whose mount effect fires an async IPC must use the
      # `renderInAct` / `renderHookInAct` helper from
      # ui/src/test-utils/renderInAct.ts. The gate catches regressions
      # before they reach main.
      - name: Gate on act() / flushSync warnings
        if: always()
        run: |
          if grep -E 'Warning: (An update to .* was not wrapped in act|flushSync was called from inside)' ui/vitest-output.log; then
            echo "::warning::vitest emitted act() or flushSync warnings — see ui/vitest-output.log. Apply renderInAct / renderHookInAct to fix."
            head -50 ui/vitest-output.log || true
          else
            echo "No act() or flushSync warnings detected."
          fi

      # ── i18n quality gate ─────────────────────────────────────────
      # Only run on shard 1 to avoid duplicate checks
      - name: i18n quality gate
        if: always() && matrix.shard == 1
        run: bash scripts/lint-i18n.sh

      # ── A11y regression tests (jest-axe) ──────────────────────────
      # Only run on shard 1 to avoid duplicate checks. Non-blocking
      # (continue-on-error) since known product-level a11y bugs
      # (ProductLookupScreen aria roles, SalesHistoryScreen heading-order)
      # are tracked but not yet fixed.
      - name: A11y regression tests
        if: always() && matrix.shard == 1
        continue-on-error: true
        shell: bash --noprofile --norc -eo pipefail {0}
        run: (cd ui && npm run test:a11y 2>&1) | tee ui/a11y-output.log

  # ── Lighthouse a11y audit ─────────────────────────────────────────
  #
  # AUDIT-27 CI-08: documented as advisory (docs/ci-pipeline.md and
  # scripts/gates.json) — a sub-90 score must not block merges. The
  # continue-on-error is enforced by scripts/verify-ci-docs-drift.py.
  lighthouse:
    name: Lighthouse a11y audit
    runs-on: ubuntu-latest
    continue-on-error: true
    timeout-minutes: 10
    needs: [changes, ui-typecheck, ui-lint]
    if: github.event_name == 'push' || needs.changes.outputs.ui == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - run: cd ui && npm run build
      - name: Run Lighthouse CI
        run: npx -p @lhci/cli@0.14.x -- lhci autorun

  # ── Docker build + blocking vulnerability scan (both images) ───
  #
  # DOCKER-03/08: both application images (cloud + license) are built,
  # size-checked, and Trivy-scanned as BLOCKING gates (exit-code 1 on
  # CRITICAL/HIGH). Documented exceptions live in `.trivyignore`. A
  # Compose smoke test then boots the full E2E stack to verify both
  # services start, pass healthchecks, and answer their health endpoints.
  docker:
    name: Docker (build + scan + smoke)
    runs-on: ubuntu-latest
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.docker == 'true' || needs.changes.outputs.rust == 'true'
    # SARIF upload needs security-events: write on the token. Without an
    # explicit permissions block the repo's read-only default token makes
    # upload-sarif fail with "Resource not accessible by integration" on
    # push/schedule events (PR events happened to pass).
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      # DOCKER-09: fail fast (no image build) if the Dockerfile cache stage
      # drifts from the Cargo workspace members.
      - name: Verify Dockerfile cache stage matches Cargo workspace
        run: python scripts/verify-dockerfile-workspace.py
      - name: Build cloud-server image
        run: docker build -f Dockerfile.server -t oz-pos-cloud:ci .
      - name: Build license-server image
        run: docker build -f apps/license-server/Dockerfile -t oz-pos-license:ci apps/license-server
      - name: Verify cloud binary size (< 50 MB)
        run: |
          SIZE=$(docker run --rm --entrypoint stat oz-pos-cloud:ci --format=%s /app/oz-cloud-server)
          MAX=$((50 * 1024 * 1024))
          echo "Binary size: $SIZE bytes ($((SIZE / 1024 / 1024)) MB)"
          if [ "$SIZE" -gt "$MAX" ]; then
            echo "::error::Binary size $SIZE exceeds 50 MB limit"
            exit 1
          fi
          echo "Binary size check passed"
      # DOCKER-03/08: `ignorefile` is NOT a valid trivy-action input —
      # it is silently dropped. Use `trivyignores` instead. The action
      # also unsets TRIVY_SEVERITY in SARIF mode unless
      # `limit-severities-for-sarif: true`, so the "blocking CRITICAL/HIGH"
      # gate was actually scanning ALL severities (76 LOW + 62 MEDIUM on
      # cloud). Both are fixed below. continue-on-error guarantees BOTH
      # SARIF files are emitted even when findings exist; the explicit
      # gate step after the uploads fails the job, so diagnostics always
      # reach the log first.
      - name: Trivy vulnerability scan (cloud, blocking)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        continue-on-error: true
        with:
          image-ref: oz-pos-cloud:ci
          format: sarif
          exit-code: 1
          severity: CRITICAL,HIGH
          limit-severities-for-sarif: true
          trivyignores: .trivyignore
          output: trivy-cloud.sarif
      - name: Trivy vulnerability scan (license, blocking)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        continue-on-error: true
        with:
          image-ref: oz-pos-license:ci
          format: sarif
          exit-code: 1
          severity: CRITICAL,HIGH
          limit-severities-for-sarif: true
          trivyignores: .trivyignore
          output: trivy-license.sarif
      - name: Upload Trivy SARIF (cloud)
        if: always()
        uses: github/codeql-action/upload-sarif@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4
        with:
          sarif_file: trivy-cloud.sarif
          category: trivy-cloud
      - name: Upload Trivy SARIF (license)
        if: always()
        uses: github/codeql-action/upload-sarif@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4
        with:
          sarif_file: trivy-license.sarif
          category: trivy-license
      # DOCKER-03/08: fail the job ONLY after both SARIF files exist and
      # the uploads above have run — a CRITICAL/HIGH finding must never
      # hide the diagnostics. A missing SARIF (scan crashed before
      # writing) is also a hard failure. jq is preinstalled on ubuntu-
      # latest.
      - name: Fail if Trivy found CRITICAL/HIGH findings
        if: always()
        shell: bash
        run: |
          FAILED=0
          for f in trivy-cloud.sarif trivy-license.sarif; do
            if [ ! -f "$f" ]; then
              echo "::error::Missing SARIF file $f — scan produced no report"
              FAILED=1
              continue
            fi
            count=$(jq '[.runs[]?.results[]?] | length' "$f")
            if [ "$count" -gt 0 ]; then
              echo "::error::Trivy found $count CRITICAL/HIGH finding(s) in $f"
              jq -r '.runs[]?.results[]? | "\(.ruleId): \(.message.text // .message // "")"' "$f" | head -n 30 || true
              FAILED=1
            else
              echo "OK: no CRITICAL/HIGH findings in $f"
            fi
          done
          exit $FAILED
      # DOCKER-08: Compose smoke — verify BOTH services together on the
      # images built above, using the E2E stack (no rebuild needed).
      - name: Compose smoke test (cloud + license + redis)
        env:
          OZ_API_SECRET: ci-test-secret
        run: |
          docker tag oz-pos-cloud:ci e2e-cloud-server:latest
          docker tag oz-pos-license:ci e2e-license-server:latest
          # Throwaway RSA-2048 PKCS#8 key (escaped newlines, like run-e2e.mjs).
          KEY=$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null | awk '{printf "%s\\n", $0}')
          export OZ_LICENSE_PRIVATE_KEY="$KEY"
          docker compose -f docker-compose.e2e.yml up -d --wait --pull=missing
          echo "── health checks ──"
          curl -sf http://localhost:3099/api/v1/health && echo " (cloud OK)"
          curl -sf http://localhost:8080/api/health && echo " (license OK)"
          echo "── non-root verification (cloud; license lands in DOCKER-01) ──"
          docker compose -f docker-compose.e2e.yml exec -T e2e-cloud-server id -u | grep -v '^0$' && echo " (cloud non-root OK)"
          docker compose -f docker-compose.e2e.yml down -v
        shell: bash

  # ── Coverage gate (non-blocking, informational) ─────────────────
  coverage:
    name: Coverage Report
    runs-on: ubuntu-latest
    continue-on-error: true
    if: github.event_name == 'push'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        with:
          components: llvm-tools-preview
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install cargo-llvm-cov
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-llvm-cov
      - name: Run coverage (workspace)
        run: cargo llvm-cov --workspace --all-features --exclude oz-pos-app --exclude oz-pos-tablet --lcov --output-path lcov.info
      - name: sccache stats
        run: sccache --show-stats
      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: coverage-report
          path: lcov.info
          retention-days: 7

  # ── Dependency audit (required on main push, advisory on PR) ─────
  # AUDIT-27 CI-03/CI-10: high/critical dependency findings block main
  # pushes (release gate) and are advisory on PRs until a reviewed
  # baseline is published. The `|| true` swallows were removed so
  # findings are always recorded in the job log.
  audit:
    name: Dependency Audit
    runs-on: ubuntu-latest
    continue-on-error: ${{ github.event_name == 'pull_request' }}
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.rust == 'true' || needs.changes.outputs.ui == 'true'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - name: Install cargo-audit
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-audit
      - name: Run cargo audit
        run: cargo audit
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
      - name: Run npm audit
        run: cd ui && npm audit --audit-level=high

  # ── PR security baseline (AUDIT-27 CI-10) ────────────────────────
  #
  # Lightweight, fail-closed dependency/container audit for PRs that
  # change manifests. Runs only when Cargo.toml/lock, package files, or
  # container definitions changed — so PRs touching only library code
  # don't pay the audit cost, while security-relevant changes are gated
  # before merge (the weekly security.yml stays for the full tree).
  security-pr:
    name: Security (PR baseline)
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - name: Check for changed dependency/container manifests
        id: deps
        run: |
          # AUDIT-27 CI-10: fail CLOSED — if the base ref cannot be
          # resolved or the diff fails, treat the PR as having changed
          # manifests and run the audits. Never silently skip.
          BASE="${{ github.event.pull_request.base.sha }}"
          if [ -z "$BASE" ]; then
            echo "changed=true" >> "$GITHUB_OUTPUT"
            echo "::warning::No base SHA available — running baseline audits (fail-closed)"
            exit 0
          fi
          # Ensure the base commit exists locally (checkout may not fetch it).
          git fetch --no-tags --depth=1 origin "$BASE" >/dev/null 2>&1 || true
          if ! git cat-file -e "${BASE}^{commit}" 2>/dev/null; then
            echo "changed=true" >> "$GITHUB_OUTPUT"
            echo "::warning::Base SHA $BASE not fetchable — running baseline audits (fail-closed)"
            exit 0
          fi
          CHANGED=$(git diff --name-only "$BASE"...HEAD 2>/dev/null | grep -E '^(Cargo\.toml$|Cargo\.lock$|ui/package\.json$|ui/package-lock\.json$|Dockerfile\.server$|apps/license-server/Dockerfile$|docker-compose\.(e2e|prod)\.yml$)' || true)
          if [ -n "$CHANGED" ]; then
            echo "changed=true" >> "$GITHUB_OUTPUT"
            echo "Dependency/container manifests changed:"
            echo "$CHANGED"
          else
            echo "changed=false" >> "$GITHUB_OUTPUT"
            echo "No dependency/container manifests changed — baseline audit skipped."
          fi
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        if: steps.deps.outputs.changed == 'true'
      - name: Install cargo-audit
        if: steps.deps.outputs.changed == 'true'
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-audit
      - name: Run cargo audit (blocking)
        if: steps.deps.outputs.changed == 'true'
        run: cargo audit
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        if: steps.deps.outputs.changed == 'true'
        with:
          node-version: '24'
      - name: Run npm audit (blocking)
        if: steps.deps.outputs.changed == 'true'
        run: cd ui && npm audit --audit-level=high

  # ── Fuzz tests (non-blocking, informational) ─────────────────────
  fuzz:
    name: Fuzz
    runs-on: ubuntu-latest
    continue-on-error: true
    timeout-minutes: 30
    # Advisory (crash artifacts uploaded). Runs on every main push; on PRs
    # only when fuzz-relevant code changed (fuzz targets + the crates they
    # import: foundation, oz-core, oz-lua, oz-plugin). The cold dep build
    # (codegen-units=1 + ASAN/sancov, no sccache — see env below) can take
    # 15-25 min, so the 30-min cap is the outer bound; cached runs finish
    # in ~8 min. Gating PRs on paths keeps the signal without taxing every
    # PR commit. Mirrors the security-pr fail-closed gate pattern.
    env:
      # rustup toolchain resolution: the fuzz build runs from the repo
      # root, whose rust-toolchain.toml pins STABLE — but cargo-fuzz
      # requires nightly (-Z sanitizer flags). RUSTUP_TOOLCHAIN pins
      # nightly job-wide so rustup resolves it regardless of the toolchain
      # file (fuzz/rust-toolchain.toml alone is not enough: rustup resolves
      # from the CWD, which is the repo root during `cargo fuzz run`).
      RUSTUP_TOOLCHAIN: nightly
      # The ubuntu runner image globally sets RUSTC_WRAPPER=sccache for
      # every job. That wrapper breaks cargo-fuzz's `--target` build: its
      # rustc version probe (`sccache .../toolchains/nightly-.../bin/rustc
      # -vV`) execs the resolved toolchain path directly and dies with
      # "No such file or directory". Override it to empty so cargo invokes
      # rustc through rustup normally (as every other job does).
      RUSTC_WRAPPER: ''
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0  # Needed for the PR diff against base
      - name: Check for fuzz-relevant changes
        id: gate
        run: |
          if [ "${{ github.event_name }}" == "pull_request" ]; then
            BASE="${{ github.event.pull_request.base.sha }}"
          else
            BASE="${{ github.event.before }}"
            if [ -z "$BASE" ] || [ "$BASE" = "0000000000000000000000000000000000000000" ]; then
              BASE="HEAD~1"
            fi
          fi
          if [ -z "$BASE" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "::warning::No base SHA — running fuzz (fail-closed)"
            exit 0
          fi
          git fetch --no-tags --depth=1 origin "$BASE" >/dev/null 2>&1 || true
          if ! git cat-file -e "${BASE}^{commit}" 2>/dev/null; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "::warning::Base SHA $BASE not fetchable — running fuzz (fail-closed)"
            exit 0
          fi
          # git diff rc: 0 = no differences, 1 = differences, >1 = error.
          # A failed diff must run the fuzz suite (fail-closed), never skip it.
          git diff --name-only "$BASE"...HEAD > /tmp/oz-changed.txt 2>/dev/null
          RC=$?
          if [ "$RC" -gt 1 ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "::warning::git diff failed (rc=$RC) — running fuzz (fail-closed)"
            exit 0
          fi
          CHANGED=$(grep -E '^(fuzz/|foundation/|crates/oz-core/|crates/oz-lua/|crates/oz-plugin/|Cargo\.toml$|Cargo\.lock$)' /tmp/oz-changed.txt || true)
          if [ -n "$CHANGED" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "Fuzz-relevant files changed:"
            echo "$CHANGED"
          else
            echo "run=false" >> "$GITHUB_OUTPUT"
            echo "No fuzz-relevant changes — fuzz skipped."
          fi
      - uses: dtolnay/rust-toolchain@7c8d7d138f5c09cef361f8214cf96882cd029cdb # nightly
        if: steps.gate.outputs.run == 'true'
      # The fuzz crate is a STANDALONE workspace, so default workspace
      # discovery misses its target dir; `workspaces: fuzz` caches
      # fuzz/target/ — and cargo-fuzz compiles everything there, including
      # the path deps (foundation, oz-core, oz-lua, oz-plugin). Save on
      # every push (main + release branches) so PR runs — same Cargo.lock
      # — restore a warm build; PR runs only restore, never save.
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        if: steps.gate.outputs.run == 'true'
        with:
          workspaces: fuzz
          save-if: ${{ github.event_name != 'pull_request' }}
      - name: Install cargo-fuzz
        if: steps.gate.outputs.run == 'true'
        run: cargo install cargo-fuzz
      # Build fuzz targets in three feature tiers to isolate C-dep linking:
      #
      # Tier 1 (no features): sku_parse, money_parse, lua_sandbox
      #   Pure Rust + foundation + oz-lua only; NO bundled SQLite.
      #   These binaries are the ones that were crashing (exit 77) because
      #   oz-plugin's bundled SQLite conflicted with libFuzzer's signal-handler
      #   setup when the fuzz crate became a standalone workspace.
      #
      # Tier 2 (oz-core-fuzz): cart_deser
      #   Adds oz-core (bundled SQLite via rusqlite). Separate from Tier 1 to
      #   keep SQL-free targets isolated.
      #
      # Tier 3 (oz-plugin-fuzz): ozpkg_parse, manifest_parse
      #   Adds oz-plugin (implies oz-core-fuzz). Needed for PLG-01/06/08 tests.
      - name: Build fuzz targets (tier 1 — no C deps)
        if: steps.gate.outputs.run == 'true'
        run: |
          for target in sku_parse money_parse lua_sandbox; do
            cargo fuzz build "$target"
          done
      - name: Build fuzz targets (tier 2 — oz-core-fuzz)
        if: steps.gate.outputs.run == 'true'
        run: cargo fuzz build --features oz-core-fuzz cart_deser
      - name: Build fuzz targets (tier 3 — oz-plugin-fuzz)
        if: steps.gate.outputs.run == 'true'
        run: |
          for target in ozpkg_parse manifest_parse; do
            cargo fuzz build --features oz-plugin-fuzz "$target"
          done
      - name: Fuzz tier-1 targets (60s each, no C deps)
        if: steps.gate.outputs.run == 'true'
        run: |
          for target in sku_parse money_parse lua_sandbox; do
            echo "::group::Fuzzing $target"
            # AUDIT-27 CI-03: no `|| true` — fuzz failures surface to the
            # advisory job and trigger the crash-artifact upload below.
            # The target bins are already built above; `cargo fuzz run` only
            # does a seconds-long incremental rebuild, so the 65s cap now
            # bounds the 60s fuzz run itself.
            #
            # lua_sandbox MUST actually run, not just build: it was dropped
            # from this loop as collateral in the 6e7c37b6 tier split and
            # stayed build-only until round 171 — the stale os-is-nil assert
            # (round 170's crash class) survived in the versioned target
            # exactly because CI compiled but never executed it.
            timeout 65 cargo fuzz run "$target" -- -max_total_time=60
            echo "::endgroup::"
          done
      - name: Fuzz tier-2 targets (60s each, oz-core-fuzz)
        if: steps.gate.outputs.run == 'true'
        run: |
          echo "::group::Fuzzing cart_deser"
          timeout 65 cargo fuzz run --features oz-core-fuzz cart_deser -- -max_total_time=60
          echo "::endgroup::"
      - name: Fuzz tier-3 targets (60s each, oz-plugin-fuzz)
        if: steps.gate.outputs.run == 'true'
        run: |
          for target in ozpkg_parse manifest_parse; do
            echo "::group::Fuzzing $target"
            timeout 65 cargo fuzz run --features oz-plugin-fuzz "$target" -- -max_total_time=60
            echo "::endgroup::"
          done
      - name: Upload crash artifacts
        if: failure() && steps.gate.outputs.run == 'true'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: fuzz-crashes-ci
          path: fuzz/artifacts/
          retention-days: 30

  # ── Flaky-test quarantine registry (AUDIT-27 CI-09) ──────────────
  #
  # Gates scripts/flaky-quarantine.json: fails when an entry is expired,
  # lacks an issue reference, or lacks an owner. This closes the loop so
  # quarantined tests have an enforced lifecycle (see docs/ci-pipeline.md).
  flaky-quarantine:
    name: Flaky Quarantine Registry
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify quarantine manifest
        run: python3 scripts/verify-flaky-quarantine.py

  # ── Windows config drift (AUDIT-28) ──────────────────────────────
  #
  # Rejects future Windows release config drift: fails when a
  # tauri.conf.json sets NSIS installMode to perMachine (a perMachine
  # installer requires elevation and reintroduces the UAC prompt) or any
  # source app.manifest drops the asInvoker execution level. The PE scan
  # of actually-built Windows exes runs in release.yml's Windows job.
  windows-config:
    name: Windows Config Drift
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify NSIS installMode + asInvoker manifests
        run: python3 scripts/verify-windows-config.py

  # ── Skill drift tests ────────────────────────────────────────────
  skill-drift-tests:
    name: Skill drift tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Install bats
        if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y bats
      - name: Clean baseline smoke test
        run: bash .agents/skills/skill-drift-guard/scripts/detect.sh
      - name: Bats test suite
        run: bash .agents/skills/skill-drift-guard/scripts/run-tests.sh

  # ── CI docs drift (AUDIT-27 CI-08) ──────────────────────────────
  #
  # Gates docs/ci-pipeline.md against the live workflows + local
  # runners: fails when a documented job no longer exists in
  # .github/workflows/*.yml, when a documented workflow file is
  # missing, or when the check.sh / check:all gate vocabulary drifts.
  # Pure python — no toolchain deps, so it stays fast.
  ci-docs-drift:
    name: CI Docs Drift
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify docs/ci-pipeline.md matches workflows + local runners
        run: python3 scripts/verify-ci-docs-drift.py

  # ── E2E: Pre-build Docker image (main only, GHCR push) ───────────
  e2e-docker-image:
    name: E2E Docker Image
    runs-on: ubuntu-latest
    if: github.event_name == 'push'
    permissions:
      packages: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Build and push E2E cloud-server image
        uses: docker/build-push-action@ca052bb54ab0790a636c9b5f226502c73d547a25 # v5
        with:
          context: .
          file: Dockerfile.server
          push: true
          tags: ghcr.io/${{ github.repository }}/oz-pos-cloud:e2e
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ── E2E Tests (Playwright) ───────────────────────────────────────
  #
  # P28: 3-way Playwright sharding + parallel server startup +
  # Docker layer caching via GHCR pre-built image on cache hit.
  # Target: < 8 min (down from ~20 min).
  e2e:
    name: E2E Tests (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
    runs-on: ubuntu-latest
    timeout-minutes: 12
    needs: [changes]
    if: github.event_name == 'push' || needs.changes.outputs.e2e == 'true' || needs.changes.outputs.ui == 'true' || needs.changes.outputs.docker == 'true' || needs.changes.outputs.rust == 'true'
    permissions:
      packages: read
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2, 3]
        totalShards: [3]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Cache Playwright browsers
        id: playwright-cache
        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ hashFiles('ui/package-lock.json') }}
      - name: Install Playwright browsers
        if: steps.playwright-cache.outputs.cache-hit != 'true'
        run: cd ui && npx playwright install chromium --with-deps
      - name: Install Playwright system deps (cached)
        if: runner.os == 'Linux' && steps.playwright-cache.outputs.cache-hit == 'true'
        run: cd ui && npx playwright install-deps chromium
      # P28-1: Docker layer caching via BuildKit GHA cache
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3

      - name: Build E2E cloud-server image with GHA cache
        uses: docker/build-push-action@ca052bb54ab0790a636c9b5f226502c73d547a25 # v5
        with:
          context: .
          file: Dockerfile.server
          load: true
          tags: e2e-cloud-server:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max
      # P28-2: Parallel server startup — Docker + Vite concurrently
      - name: Start Docker E2E backend & Vite dev server (parallel)
        env:
          OZ_API_SECRET: ci-test-secret
          # The dev-mode DevToolbar overlay floats bottom-right at tooltip
          # z-index and would sit on top of the retail cart action buttons,
          # intercepting pointer events (see sale.spec.ts discount click).
          # run-e2e.mjs sets this too — but Playwright's webServer.env only
          # applies when IT starts the server; with reuseExistingServer:true
          # it reuses THIS manually-started Vite, so the flag must be set
          # here as well (App.tsx reads VITE_DEV_TOOLBAR to disable it).
          VITE_DEV_TOOLBAR: '0'
        run: |
          # DOCKER-06: pre-pull the PINNED Redis digest (immutable, matches
          # docker-compose.e2e.yml) to mitigate registry rate-limit timeouts.
          REDIS_DIGEST="public.ecr.aws/docker/library/redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2"
          for i in 1 2 3; do
            echo "Pulling $REDIS_DIGEST (attempt $i/3)..."
            docker pull "$REDIS_DIGEST" && break
            echo "Redis pull failed (attempt $i/3), retrying..."
            sleep 15
          done
          # Start Docker Compose (use pre-pulled image, don't re-pull)
          docker compose -f docker-compose.e2e.yml up -d --pull=missing
          # Start Vite dev server in background
          cd ui && npm run dev &
          VITE_PID=$!
          echo "VITE_PID=$VITE_PID" >> $GITHUB_ENV
          # Wait for BOTH to become healthy in parallel
          DOCKER_READY=false
          VITE_READY=false
          for i in $(seq 1 45); do
            if [ "$DOCKER_READY" != "true" ] && curl -sf http://localhost:3099/api/v1/health > /dev/null 2>&1; then
              echo "Docker backend ready (attempt $i)"
              DOCKER_READY=true
            fi
            if [ "$VITE_READY" != "true" ] && curl -sf http://localhost:1420 > /dev/null 2>&1; then
              echo "Vite dev server ready (attempt $i)"
              VITE_READY=true
            fi
            if [ "$DOCKER_READY" = "true" ] && [ "$VITE_READY" = "true" ]; then
              echo "Both servers ready (attempt $i)"
              break
            fi
            if [ "$i" -eq 45 ]; then
              echo "::error::Server startup timed out (Docker: $DOCKER_READY, Vite: $VITE_READY)"
              docker compose -f docker-compose.e2e.yml logs e2e-cloud-server --tail=50 2>/dev/null || true
              exit 1
            fi
            sleep 2
          done
      # P28-3: Playwright sharding — each shard runs 1/3 of spec files
      - name: Run E2E tests (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
        shell: bash --noprofile --norc -eo pipefail {0}
        run: |
          cd ui && npx playwright test --config e2e/playwright.config.ts --project=desktop --shard=${{ matrix.shard }}/${{ matrix.totalShards }} 2>&1 | tee e2e-output.log
      - name: Upload E2E test results
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: e2e-results-shard-${{ matrix.shard }}
          path: ui/e2e-results/
          retention-days: 7
      - name: Upload Playwright trace
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: e2e-traces-shard-${{ matrix.shard }}
          path: ui/test-results/
          retention-days: 7
      - name: Stop Docker E2E backend
        if: always()
        run: docker compose -f docker-compose.e2e.yml down -v
