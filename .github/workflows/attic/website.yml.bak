# ── Website Deploy (Cloudflare Workers) ─────────────────────────────
#
# Builds the Astro marketing site (website/) and deploys it to Cloudflare
# Workers static assets (workers.dev) via wrangler.
#
#   • PRs + pushes to main:  astro check + i18n audit gate + docs portal
#                            build + build + internal-link audit
#   • Pushes to main only:   deploy to Cloudflare (requires secrets)
#
# Fail-closed: if CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are not
# configured as repo secrets, the deploy step FAILS loudly instead of
# silently skipping — a "successful" run must never mean "not deployed".
# The deploy job additionally validates the token against Cloudflare's
# /user/tokens/verify endpoint BEFORE the ~5 min portal build, so a rejected
# (expired / revoked / insufficient-scope) token fails the job in ~1s with a
# pointer to runbook §9 instead of burning the build first.
#
# Required secrets (Settings → Secrets and variables → Actions):
#   CLOUDFLARE_API_TOKEN   — token with Workers Scripts:Edit
#                            (wrangler.toml → name "oz-pos")
#   CLOUDFLARE_ACCOUNT_ID  — Cloudflare account id (dash.cloudflare.com)  #   PUBLIC_LICENSE_API_URL — https://license.ozpos.my.id
  #                            (unified service, runbook §8)
#   PUBLIC_PADDLE_CLIENT_TOKEN — Paddle.js v2 client token (optional:
#                            without it the checkout buttons degrade to
#                            the mailto fallback at build time)

name: Website Deploy

on:
  push:
    branches: [main]
    paths:
      - 'website/**'
      - '.github/workflows/website.yml'
      # Portal sources: the built docs-portal ships inside the website bundle,
      # so a change to any of these must redeploy the site.
      - 'scripts/build-docs.*'
      - 'scripts/gen-summary.py'
      - 'docs/**'
      - 'ui/src/**'
      - 'Cargo.toml'
      - 'Cargo.lock'
  pull_request:
    branches: [main]
    paths:
      - 'website/**'
  # Manual redeploy (e.g. pick up a portal rebuild without a source change).
  workflow_dispatch:

env:
  # Baked into the JS bundle at build time (import.meta.env) — must be set
  # here, NOT in wrangler.toml. Empty strings are fine for local preview;
  # CI always injects the real values for main-branch deploys.
  PUBLIC_LICENSE_API_URL: ${{ secrets.PUBLIC_LICENSE_API_URL }}
  PUBLIC_PADDLE_CLIENT_TOKEN: ${{ secrets.PUBLIC_PADDLE_CLIENT_TOKEN }}
  # Defaults to sandbox so a test_ client token never initializes Paddle
  # against production; flip the secret to "production" when going live.
  PUBLIC_PADDLE_ENVIRONMENT: ${{ secrets.PUBLIC_PADDLE_ENVIRONMENT || 'sandbox' }}

defaults:
  run:
    shell: bash

# CICD-01: least-privilege default — deploys authenticate with the
# Cloudflare API token, not the GitHub token.
permissions:
  contents: read

jobs:
  check:
    name: Website Check + Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'website/package-lock.json'
      - run: cd website && npm ci --no-audit --no-fund
      # Build-time Mermaid rendering (rehype-mermaid) needs a Playwright
      # browser at build only — never shipped to the client.
      - run: cd website && npx playwright install --with-deps chromium
      - run: cd website && npm run check
      # Review follow-up (H2): `astro check` only type-checks the vitest
      # suites — it never executes them. Run the admin/dashboard SPA helper
      # tests + worker auth-gate tests here (vitest/jsdom already installed
      # by npm ci; ~1s) so a regression fails BEFORE the ~5-min portal
      # build. Gate: scripts/gates.json → "website-tests".
      - name: Website unit tests
        run: cd website && npm test
      # ── Docs portal build ────────────────────────────────────────────
      # Build the full portal (mdBook hub + cargo doc + TypeDoc) so the
      # docs hub renders all 4 cards and the internal-link audit validates
      # the portal tree. HARD-fail here (unlike the deploy job's soft-fail):
      # a portal build hiccup on a PR must surface before merge, and a
      # silently-degraded hub would defeat the purpose of the check. The
      # steps mirror the deploy job below exactly — keep them in sync.
      - name: Install Rust toolchain (portal cargo doc)
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install system dependencies (portal cargo doc)
        if: runner.os == 'Linux'
        # platform-startup depends on tauri → gdk-sys (gtk3) and oz-hal
        # depends on serialport → libudev; both must exist even for
        # --no-deps because the workspace members compile to emit docs.
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            pkg-config \
            libglib2.0-dev \
            libgtk-3-dev \
            libwebkit2gtk-4.1-dev \
            libayatana-appindicator3-dev \
            libudev-dev
      - name: Install mdbook
        uses: peaceiris/actions-mdbook@ee69d230fe19748b7abf22df32acaa93833fad08 # v2
        with:
          mdbook-version: 'latest'
      - name: Build docs portal
        run: bash scripts/build-docs.sh
      - run: cd website && npm run build
      # Internal-link audit — FAILING gate: every href on a built page must
      # resolve to a file in dist/ (or a known-external/portal-generated
      # target; see check-links.mjs for the exact skip list). Runs after
      # build because it audits the rendered output — and with the portal
      # staged above, it validates the full hub + portal tree.
      - name: Internal-link audit
        run: cd website && npm run check:links
      # The 4-card hub degrades to just Get Started when the portal is
      # absent (portalExists gate) — assert the portal targets actually
      # shipped so a silent staging failure can't pass this job.
      - name: Portal staged (4-card hub targets)
        run: |
          test -f website/dist/docs-portal/intro.html && \
          test -f website/dist/docs-portal/api/rust/index.html && \
          test -f website/dist/docs-portal/api/ts/index.html && \
          echo "portal staged: full 4-card docs hub exercised"

  deploy:
    name: Deploy to Cloudflare Workers
    runs-on: ubuntu-latest
    if: github.event_name == 'push'
    needs: check
    environment: production
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      # Fail-fast credential gate: a missing or rejected Cloudflare token is a
      # credentials problem, not a build problem. Validating here (before npm ci
      # and the portal build) turns the silent 20-red-runs failure mode into a
      # ~1s loud failure with the exact remediation (runbook §9).
      - name: Validate Cloudflare deploy credentials (fail-fast)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          if [ -z "$CLOUDFLARE_API_TOKEN" ] || [ -z "$CLOUDFLARE_ACCOUNT_ID" ]; then
            echo "::error::Missing CLOUDFLARE_API_TOKEN or CLOUDFLARE_ACCOUNT_ID repo secret — cannot deploy."
            echo "Add both secrets (Workers Scripts:Edit token + account id), then re-run this job."
            exit 1
          fi
          # Authoritative validity probe (runbook §9.3): Cloudflare's own
          # /user/tokens/verify endpoint. HTTP 400 + code 9109 = the secret
          # is invalid/expired; HTTP 000 = runner cannot reach api.cloudflare.com.
          # Short-lived tokens (cfat_ prefix) are account-scoped only — they
          # get 401 on user-level endpoints while still being perfectly valid
          # for the deploy. Fall back to the account-scoped verify (the probe
          # Cloudflare's dashboard suggests for them) before declaring failure.
          HTTP=$(curl -sS -m 15 -o /tmp/cf-verify.json -w '%{http_code}' \
            "https://api.cloudflare.com/client/v4/user/tokens/verify" \
            -H "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}" || true)
          if [ "$HTTP" = "401" ]; then
            echo "User-level verify rejected the token — retrying against account ${CLOUDFLARE_ACCOUNT_ID} (short-lived tokens are account-scoped)."
            HTTP=$(curl -sS -m 15 -o /tmp/cf-verify.json -w '%{http_code}' \
              "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/tokens/verify" \
              -H "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}" || true)
          fi
          if [ "$HTTP" != "200" ]; then
            echo "::error::Cloudflare token verification failed (HTTP ${HTTP}) — deploy blocked."
            echo "  Response: $(head -c 300 /tmp/cf-verify.json 2>/dev/null || echo 'no response body')"
            echo "  HTTP 400 + 'Invalid access token [code: 9109]' → CLOUDFLARE_API_TOKEN is invalid or expired;"
            echo "  rotate it per docs/operations/runbook.md §9. HTTP 000 → runner could not reach"
            echo "  api.cloudflare.com; retry before touching the token."
            exit 1
          fi
          STATUS=$(jq -r '.result.status // empty' /tmp/cf-verify.json 2>/dev/null || true)
          if [ "$STATUS" != "active" ]; then
            echo "::error::Cloudflare API token is not active (status: '${STATUS}') — deploy blocked."
            echo "  Rotate CLOUDFLARE_API_TOKEN per docs/operations/runbook.md §9."
            exit 1
          fi
          echo "Cloudflare token valid (status: active) — proceeding."
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'website/package-lock.json'
      - run: cd website && npm ci --no-audit --no-fund
      - run: cd website && npx playwright install --with-deps chromium
      # ── Docs portal build ────────────────────────────────────────────
      # The portal (docs/book/) is generated (mdBook hub + cargo doc + TypeDoc)
      # and staged into website/public/docs-portal by import-portal.sh during
      # `npm run build`. nightly.yml's docs job compiles cargo doc on its own schedule; here
      # we run the full build-docs.sh so the mdBook hub and TypeDoc ship too.
      #
      # SOFT-FAIL (continue-on-error): a docs build hiccup must never block the
      # marketing site deploy. When it fails, docs/book stays absent, the
      # import-portal step skips, and the docs hub degrades to the Get Started
      # card (see src/pages/[locale]/docs/index.astro portalExists gate) —
      # no dead links, site still ships.
      - name: Install Rust toolchain (portal cargo doc)
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install system dependencies (portal cargo doc)
        if: runner.os == 'Linux'
        # platform-startup depends on tauri → gdk-sys (gtk3) and oz-hal
        # depends on serialport → libudev; both must exist even for
        # --no-deps because the workspace members compile to emit docs.
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            pkg-config \
            libglib2.0-dev \
            libgtk-3-dev \
            libwebkit2gtk-4.1-dev \
            libayatana-appindicator3-dev \
            libudev-dev
      - name: Install mdbook
        uses: peaceiris/actions-mdbook@ee69d230fe19748b7abf22df32acaa93833fad08 # v2
        with:
          mdbook-version: 'latest'
      - name: Build docs portal (soft-fail)
        continue-on-error: true
        run: bash scripts/build-docs.sh
      - run: cd website && npm run build
        env:
          PUBLIC_LICENSE_API_URL: ${{ secrets.PUBLIC_LICENSE_API_URL }}
          PUBLIC_PADDLE_CLIENT_TOKEN: ${{ secrets.PUBLIC_PADDLE_CLIENT_TOKEN }}
          PUBLIC_PADDLE_ENVIRONMENT: ${{ secrets.PUBLIC_PADDLE_ENVIRONMENT || 'sandbox' }}
      - name: Deploy with wrangler
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          DEPLOY_MESSAGE: "Coding Agent — ${{ github.sha }} (${{ github.ref_name }})"
          DEPLOY_TAG: "${{ github.ref_name }}"
          SKIP_BUILD: "1"   # already built above
        run: bash scripts/wrangler-deploy.sh


