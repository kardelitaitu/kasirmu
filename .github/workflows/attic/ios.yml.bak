# ── iOS Build Pipeline ─────────────────────────────────────────────────
#
# Builds a signed iOS IPA for the OZ-POS tablet client using a macOS
# runner with Xcode.
#
# Triggered by:
#   - Tag v* (release build)
#   - Manual workflow_dispatch
#
# Note: PR builds on main are skipped because macOS runners are
# significantly more expensive than Linux runners.
#
# Secrets required:
#   APPLE_TEAM_ID            — Apple Developer team ID
#   APPLE_BUNDLE_ID          — Bundle identifier (e.g. com.ozpos.tablet)
#   APPLE_PROV_PROFILE_BASE64 — base64-encoded provisioning profile
#   APPLE_CERT_BASE64        — base64-encoded distribution certificate p12
#   APPLE_CERT_PASSWORD      — certificate password
#   KEYCHAIN_PASSWORD        — temporary keychain password (any value)

name: iOS Build

# AUDIT-28 RELEASE-02/09: on tag pushes the IPA is uploaded directly into
# the SAME GitHub Release created by release.yml (via gh release upload,
# waiting for the release to exist) so mobile artifacts are not stranded in
# a separate workflow run. The concurrency group prevents duplicate-tag
# upload races.
on:
  push:
    tags: ['v*']
  workflow_dispatch:

concurrency:
  group: release-ios-${{ github.ref_name }}
  cancel-in-progress: false

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: -D warnings
  RUSTC_WRAPPER: sccache
  SCCACHE_GHA_ENABLED: "true"

# CICD-01: least-privilege default; ios-build grants contents: write
# in its own block for the release upload.
permissions:
  contents: read

jobs:
  ios-build:
    name: iOS IPA
    runs-on: macos-latest
    # AUDIT-28 RELEASE-02: the release.yml workflow creates the GitHub
    # Release only after all matrix builds finish (build timeouts are 60
    # min each), so this job must survive the build + a long poll window.
    timeout-minutes: 150
    # RELEASE-02: contents:write lets the tag step upload straight to the
    # release created by release.yml; build steps otherwise need nothing.
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      # ── Rust toolchain ─────────────────────────────────────────
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        with:
          targets: aarch64-apple-ios,x86_64-apple-ios,aarch64-apple-ios-sim

      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}

      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10

      # ── Node / UI dependencies ─────────────────────────────────
      - name: Setup Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'

      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts

      - name: Build UI (tablet)
        run: cd ui && npx vite build --config vite.tablet.config.ts

      # ── Tauri CLI ──────────────────────────────────────────────
      - name: Install Tauri CLI
        run: cargo install tauri-cli --version "^2" --locked

      # ── Initialize iOS project ─────────────────────────────────
      - name: Initialize Tauri iOS project
        run: |
          cd apps/tablet-client
          cargo tauri ios init
          # Locate the generated Xcode project (name varies by Tauri config)
          XCODE_PROJ=$(find gen/apple -name "*.xcodeproj" -maxdepth 2 | head -1)
          if [ -z "$XCODE_PROJ" ]; then
            echo "::error::No Xcode project found in gen/apple/"
            exit 1
          fi
          echo "Found Xcode project: $XCODE_PROJ"
          echo "XCODE_PROJ=$XCODE_PROJ" >> $GITHUB_ENV

      # ── Setup code signing ─────────────────────────────────────
      # CICD-03: secrets reach the script through env (never direct
      # ${{ }} interpolation) and the decoded key material is removed
      # from /tmp immediately after import.
      - name: Create keychain and import certificate
        env:
          KEYCHAIN_PASSWORD: ${{ secrets.KEYCHAIN_PASSWORD }}
          APPLE_CERT_BASE64: ${{ secrets.APPLE_CERT_BASE64 }}
          APPLE_CERT_PASSWORD: ${{ secrets.APPLE_CERT_PASSWORD }}
          APPLE_PROV_PROFILE_BASE64: ${{ secrets.APPLE_PROV_PROFILE_BASE64 }}
        run: |
          # Create a temporary keychain
          security create-keychain -p "${KEYCHAIN_PASSWORD}" build.keychain
          security default-keychain -s build.keychain
          security unlock-keychain -p "${KEYCHAIN_PASSWORD}" build.keychain

          # Import distribution certificate
          echo "${APPLE_CERT_BASE64}" | base64 -d > /tmp/cert.p12
          security import /tmp/cert.p12 -k build.keychain -P "${APPLE_CERT_PASSWORD}" -T /usr/bin/codesign
          rm -f /tmp/cert.p12

          # Import provisioning profile
          echo "${APPLE_PROV_PROFILE_BASE64}" | base64 -d > /tmp/profile.mobileprovision
          mkdir -p "$HOME/Library/MobileDevice/Provisioning Profiles"
          cp /tmp/profile.mobileprovision "$HOME/Library/MobileDevice/Provisioning Profiles/"
          rm -f /tmp/profile.mobileprovision

          # Allow codesign access to the keychain
          security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "${KEYCHAIN_PASSWORD}" build.keychain

      # ── Build iOS IPA ──────────────────────────────────────────
      # Signing is configured via APPLE_DEVELOPMENT_TEAM (read by the
      # tauri CLI at build time and synced into the generated Xcode
      # project; see crates/tauri-cli/src/mobile/ios/mod.rs). The cert +
      # provisioning profile were imported above, so manual signing with
      # this team resolves without an extra xcodebuild step.
      - name: Build iOS release
        run: |
          cd apps/tablet-client
          cargo tauri ios build --release
        env:
          APPLE_DEVELOPMENT_TEAM: ${{ secrets.APPLE_TEAM_ID }}

      # ── Locate IPA ─────────────────────────────────────────────
      - name: Find IPA output
        run: |
          find apps/tablet-client/gen/apple -name "*.ipa" 2>/dev/null | head -10

      # ── Upload IPA artifact ────────────────────────────────────
      - name: Upload IPA
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: oz-pos-tablet.ipa
          path: |
            apps/tablet-client/gen/apple/build/**/*.ipa
            target/release/ipa/**/*.ipa
          retention-days: 90

      # ── RELEASE-02: attach IPA to the release.yml GitHub Release ──
      # The release may still be building (matrix builds + publish job);
      # poll for it for up to ~60 minutes, then upload with --clobber so
      # retries are idempotent. Fails only if the release never appears or
      # no IPA was produced.
      - name: Upload IPA to GitHub Release (tag only)
        if: startsWith(github.ref, 'refs/tags/v')
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          TAG="${{ github.ref_name }}"
          found=0
          for i in $(seq 1 180); do
            if gh release view "$TAG" >/dev/null 2>&1; then
              echo "Release $TAG found (attempt $i)"
              found=1
              break
            fi
            if [ $((i % 10)) -eq 0 ]; then echo "Release $TAG not ready yet (attempt $i/180)..."; fi
            sleep 20
          done
          [ "$found" -eq 1 ] || { echo "::error::release $TAG not found after 60 min — release.yml likely failed"; exit 1; }
          IPA=$(find apps/tablet-client -name '*.ipa' 2>/dev/null | head -1)
          if [ -z "$IPA" ]; then
            echo "::error::no IPA produced — cannot attach to release"
            exit 1
          fi
          echo "Uploading to release $TAG:"
          find apps/tablet-client -name '*.ipa' -exec echo "  {}" \;
          # Retry the upload (transient API/network failures) with --clobber.
          for attempt in 1 2 3; do
            if gh release upload "$TAG" $(find apps/tablet-client -name '*.ipa') --clobber; then
              echo "Upload succeeded (attempt $attempt)"
              break
            fi
            echo "Upload failed (attempt $attempt/3), retrying..."
            sleep 15
            if [ "$attempt" -eq 3 ]; then echo "::error::upload to release $TAG failed"; exit 1; fi
          done

      # ── sccache stats ──────────────────────────────────────────
      - name: sccache stats
        run: sccache --show-stats
