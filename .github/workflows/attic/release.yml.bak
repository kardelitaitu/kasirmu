# ── Release Pipeline ────────────────────────────────────────────────────
#
# AUDIT-28 remediation:
#   RELEASE-01  Real Tauri installers (cargo tauri build), not raw binaries.
#   RELEASE-03  macOS desktop added to the release matrix.
#   RELEASE-04  Signed updater manifests (latest.json + beta.json) generated
#               and verified against the committed pubkey before publishing.
#   RELEASE-05  Tag ↔ application version gate (release-validate) runs first.
#   RELEASE-06  build provenance attestation + SHA-256 checksums attached.
#   RELEASE-08  Post-build artifact existence + signature verification.
#   RELEASE-09  Concurrency group keyed by tag, draft release, environment
#               approval gate (configure the `release` environment to require
#               reviewers; it auto-exists with no gate until then).
#
# Mobile (Android/iOS) build in their own tag-triggered workflows and upload
# their artifacts directly into THIS release via `gh release upload`
# (RELEASE-02) — they are excluded from the hard gate here because the
# android.yml NDK toolchain is still marked unstable.
#
# Secrets required for a fully-signed release:
#   UPDATER_PRIVATE_KEY — Ed25519 seed (32 bytes, hex or base64) matching
#                         apps/desktop-client/tauri.conf.json pubkey
#   UPDATER_CERT + UPDATER_CERT_PASSWORD — Windows code-signing (optional)
#   SIGNPATH_API_TOKEN (secret) + SIGNPATH_ORGANIZATION_ID /
#   SIGNPATH_PROJECT_SLUG / SIGNPATH_SIGNING_POLICY_SLUG (variables) —
#   FREE public-trust Windows signing via SignPath (optional; see the
#   SignPath steps in release-build). No-op until the token is configured.

name: Release

on:
  push:
    tags: ['v*']

# CICD-01: least-privilege default. Jobs that need more grant it in their
# own `permissions:` block (release-build reads; release-publish writes).
permissions:
  contents: read

defaults:
  run:
    shell: bash

env:
  CARGO_TERM_COLOR: always

concurrency:
  group: release-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  # ── RELEASE-05: tag ↔ version parity gate ──────────────────────────
  release-validate:
    name: Validate (tag ↔ version)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Validate tag vs app versions + changelog heading
        run: node scripts/check-release-version.mjs "${{ github.ref_name }}"
      - name: Self-test version gate
        run: node scripts/check-release-version.mjs --self-test
      # RELEASE-04: end-to-end proof that the sign/verify toolchain emits
      # signatures the REAL Tauri updater client verifier accepts. Builds a
      # tiny Rust harness pinned to the client's minisign-verify 0.2.5 and
      # feeds generate-latest-json.mjs output through it (plus tamper +
      # real-tauri-cli fixture cross-checks). Fails fast, before any build.
      - name: Install Rust toolchain (compat harness)
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - name: Updater client compatibility check
        run: node scripts/check-updater-compat.mjs

  # ── RELEASE-01/03/08: build real installers + Docker images ───────
  release-build:
    name: Build (${{ matrix.target }})
    needs: release-validate
    runs-on: ${{ matrix.os }}
    timeout-minutes: 60
    permissions:
      contents: read
      actions: read
    env:
      # Job-level so step `if:` conditions can gate on it. Step-level env is
      # NOT visible in a step's own `if:`, and GitHub disallows referencing
      # secrets directly in `if:` — job-level env is the documented pattern.
      SIGNPATH_API_TOKEN: ${{ secrets.SIGNPATH_API_TOKEN }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - target: desktop-linux
            os: ubuntu-latest
            tauri: true
            bundles: appimage,deb
            bundle_ext: AppImage deb
            upload_path: |
              apps/desktop-client/target/release/bundle/appimage/*.AppImage
              apps/desktop-client/target/release/bundle/deb/*.deb
          - target: desktop-windows
            os: windows-latest
            tauri: true
            bundles: nsis,msi
            bundle_ext: exe msi
            upload_path: |
              apps/desktop-client/target/release/bundle/nsis/*.exe
              apps/desktop-client/target/release/bundle/msi/*.msi
          - target: desktop-macos
            os: macos-latest
            tauri: true
            bundles: dmg
            bundle_ext: dmg
            upload_path: |
              apps/desktop-client/target/release/bundle/dmg/*.dmg
          - target: docker-cloud
            os: ubuntu-latest
          - target: docker-license
            os: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10

      - name: Install cargo-nextest
        if: matrix.target != 'docker-cloud' && matrix.target != 'docker-license'
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      # Release-time safety net: run the workspace test suite on the release
      # commit before shipping (matches the original workflow's behavior).
      - name: Run tests (desktop targets)
        if: matrix.tauri
        run: cargo nextest run --workspace --all-features --exclude oz-pos-app --exclude oz-pos-tablet --profile ci

      - name: Install system deps (Linux)
        if: runner.os == 'Linux' && matrix.tauri
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config

      - name: Install macOS deps
        if: runner.os == 'macOS'
        run: |
          brew install librsvg pkg-config 2>/dev/null || true

      - name: Install Tauri CLI (pinned)
        if: matrix.tauri
        run: cargo install tauri-cli --version "^2" --locked

      - name: Install UI dependencies
        if: matrix.tauri
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts

      # RELEASE-01: real Tauri bundles (installers), not raw binaries.
      - name: Build desktop installers (Linux/macOS)
        if: matrix.tauri && runner.os != 'Windows'
        run: cd apps/desktop-client && cargo tauri build --bundles ${{ matrix.bundles }}

      # Windows: invoke the configured signtool.exe ONLY when a code-signing
      # certificate is configured; otherwise build unsigned (never run
      # signtool with no cert, which would fail the release). The secret is
      # read inside the script — `if:` conditions cannot reference
      # step-level env portably, so the step runs and no-ops when empty.
      - name: Import code-signing certificate (Windows)
        if: runner.os == 'Windows'
        shell: pwsh
        env:
          UPDATER_CERT: ${{ secrets.UPDATER_CERT }}
        run: |
          if ([string]::IsNullOrEmpty($env:UPDATER_CERT)) {
            Write-Host "UPDATER_CERT not set — skipping certificate import (installers will be UNSIGNED)"
            exit 0
          }
          $bytes = [Convert]::FromBase64String($env:UPDATER_CERT)
          [IO.File]::WriteAllBytes("$env:RUNNER_TEMP\cert.pfx", $bytes)
          Import-PfxCertificate -FilePath "$env:RUNNER_TEMP\cert.pfx" -CertStoreLocation Cert:\CurrentUser\My -Exportable
          # CICD-03: the PFX (password-less export of the signing key) must
          # not linger on disk after the import.
          Remove-Item "$env:RUNNER_TEMP\cert.pfx" -Force

      - name: Build desktop installers (Windows)
        if: matrix.tauri && runner.os == 'Windows'
        shell: bash
        env:
          UPDATER_CERT: ${{ secrets.UPDATER_CERT }}
        run: |
          cd apps/desktop-client
          if [ -n "$UPDATER_CERT" ]; then
            echo "UPDATER_CERT configured — installers will be code-signed"
            cargo tauri build --bundles ${{ matrix.bundles }}
          else
            # No cert secret: no-op signCommand so the build never invokes
            # signtool. Releases built this way are UNSIGNED — wire the
            # UPDATER_CERT secret to enable Authenticode signing. `exit /b 0`
            # is used so trailing Tauri-injected %1 path args are ignored.
            echo "::warning::No UPDATER_CERT secret — Windows installers will be UNSIGNED"
            cargo tauri build --bundles ${{ matrix.bundles }} \
              --config '{"bundle":{"windows":{"signCommand":"cmd /c exit /b 0"}}}'
          fi

      - name: Build Docker image (cloud)
        if: matrix.target == 'docker-cloud'
        run: |
          docker build -f Dockerfile.server -t oz-pos-cloud:${{ github.ref_name }} .
          docker save oz-pos-cloud:${{ github.ref_name }} -o oz-pos-cloud.tar

      - name: Build license Docker image
        if: matrix.target == 'docker-license'
        run: |
          docker build -f apps/license-server/Dockerfile -t oz-pos-license:${{ github.ref_name }} apps/license-server
          docker save oz-pos-license:${{ github.ref_name }} -o oz-pos-license.tar

      # DOCKER-03/08: blocking scan on the EXACT release-tagged image.
      # `ignorefile` is not a valid trivy-action input (silently
      # dropped → baseline never applied); use `trivyignores`.
      # `limit-severities-for-sarif: true` keeps the CRITICAL/HIGH filter in
      # SARIF mode (otherwise the action scans ALL severities and this gate
      # would block on 76 LOW + 62 MEDIUM too).
      - name: Scan cloud Docker image (blocking)
        if: matrix.target == 'docker-cloud'
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: oz-pos-cloud:${{ github.ref_name }}
          format: sarif
          exit-code: 1
          severity: CRITICAL,HIGH
          limit-severities-for-sarif: true
          trivyignores: .trivyignore
          output: trivy-cloud.sarif

      - name: Scan license Docker image (blocking)
        if: matrix.target == 'docker-license'
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: oz-pos-license:${{ github.ref_name }}
          format: sarif
          exit-code: 1
          severity: CRITICAL,HIGH
          limit-severities-for-sarif: true
          trivyignores: .trivyignore
          output: trivy-license.sarif

      # RELEASE-08: fail the job if an expected bundle artifact is absent.
      - name: Verify expected bundle artifacts exist
        if: matrix.tauri
        shell: bash
        run: |
          for ext in ${{ matrix.bundle_ext }}; do
            count=$(find apps/desktop-client/target/release/bundle -type f -name "*.$ext" 2>/dev/null | wc -l)
            if [ "$count" -eq 0 ]; then
              echo "::error::no .$ext bundle artifact produced for ${{ matrix.target }}"
              exit 1
            fi
            echo "Found $count .$ext artifact(s) for ${{ matrix.target }}"
          done

      # AUDIT-28: fail the release if the built Windows app exe lost its
      # loadable asInvoker manifest (numeric RT_MANIFEST type 24). A
      # named-type or missing manifest reintroduces the UAC installer-
      # detection prompt for end users even though the NSIS config is
      # currentUser. Runs BEFORE any upload so a bad binary never ships.
      # NB: `python` (not python3) — on windows runners python3 has no alias.
      - name: Verify Windows exe embeds asInvoker manifest
        if: matrix.target == 'desktop-windows'
        shell: bash
        run: python scripts/verify-windows-config.py --exe apps/desktop-client/target/release/oz-pos-app.exe

      # Windows only: FREE end-user code signing via SignPath (signpath.org).
      # Self-signed certs only remove the "unknown publisher" label on machines
      # that install the root - end users still get SmartScreen popups. SignPath
      # signs with a PUBLICLY-trusted certificate (cloud HSM) for FREE for
      # qualifying open-source projects, so downloaded installers show a real
      # publisher and no SmartScreen warning. Requires one-time onboarding
      # (create org + project + signing policy, install the GitHub App or mint
      # an API token) then set the secrets/vars below. The steps are gated on
      # SIGNPATH_API_TOKEN and are a NO-OP (upload unsigned) until configured.
      - name: Upload unsigned installers (SignPath candidate)
        if: matrix.target == 'desktop-windows'
        id: upload-unsigned
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: windows-unsigned
          path: ${{ matrix.upload_path }}
          if-no-files-found: error
          retention-days: 1

      - name: Sign installers with SignPath (free public trust)
        # Gated on the JOB-level env var defined above (step-level env is
        # invisible in a step's own `if:`; secrets cannot go in `if:`).
        if: matrix.target == 'desktop-windows' && env.SIGNPATH_API_TOKEN != ''
        id: signpath
        # MUST continue on error: a SignPath failure (network, approval
        # timeout, bad token) must degrade to the unsigned fallback upload
        # below, never abort the job and strand the Windows installer.
        continue-on-error: true
        uses: signpath/github-action-submit-signing-request@c92b958760219087e01f8d67a1669ed57afe2627 # v2
        with:
          api-token: ${{ secrets.SIGNPATH_API_TOKEN }}
          organization-id: ${{ vars.SIGNPATH_ORGANIZATION_ID }}
          project-slug: ${{ vars.SIGNPATH_PROJECT_SLUG }}
          signing-policy-slug: ${{ vars.SIGNPATH_SIGNING_POLICY_SLUG }}
          github-artifact-id: ${{ steps.upload-unsigned.outputs.artifact-id }}
          wait-for-completion: true
          output-artifact-directory: signed-installers

      - name: Upload signed installers
        if: matrix.target == 'desktop-windows' && steps.signpath.outcome == 'success'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: ${{ matrix.target }}
          path: signed-installers/
          if-no-files-found: error
          retention-days: 30

      - name: Upload desktop installers (unsigned fallback)
        # Non-Windows targets never run the SignPath step, so outcome is
        # 'skipped' != 'success' and they always land here.
        if: matrix.tauri && !(matrix.target == 'desktop-windows' && steps.signpath.outcome == 'success')
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: ${{ matrix.target }}
          path: ${{ matrix.upload_path }}
          if-no-files-found: error
          retention-days: 30

      - name: Upload Docker artifact
        if: matrix.target == 'docker-cloud'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: docker-cloud
          path: oz-pos-cloud.tar
          retention-days: 30

      - name: Upload license Docker artifact
        if: matrix.target == 'docker-license'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: docker-license
          path: oz-pos-license.tar
          retention-days: 30

  # ── RELEASE-04/06/08/09: assemble signed manifest, attest, publish ──
  release-publish:
    name: Publish Release
    needs: release-build
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write
      id-token: write
      attestations: write
    environment: release
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'

      # RELEASE-04: dry-run signature/manifest tests in CI so the sign/verify
      # toolchain is proven before any real key material is used.
      - name: Self-test updater toolchain
        run: |
          node scripts/generate-latest-json.mjs --self-test
          node scripts/verify-updater-signature.mjs --self-test

      - name: Download all build artifacts
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          path: artifacts/

      # RELEASE-04: generate a single merged latest.json (+ beta.json) with
      # Ed25519 signatures over the raw installer bytes, and fail fast if the
      # private seed does not match the committed pubkey.
      - name: Generate signed updater manifest (latest.json + beta.json)
        env:
          UPDATER_PRIVATE_KEY: ${{ secrets.UPDATER_PRIVATE_KEY }}
          REPO: ${{ github.repository }}
        shell: bash
        run: |
          set -euo pipefail
          VERSION="${GITHUB_REF_NAME#v}"
          NOTES="Release ${GITHUB_REF_NAME}"
          PUBKEY=$(node -e "const c=require('./apps/desktop-client/tauri.conf.json');process.stdout.write(c.plugins.updater.pubkey)")
          [ -n "$PUBKEY" ] || { echo "::error::updater pubkey missing from tauri.conf.json"; exit 1; }
          if [ -z "$UPDATER_PRIVATE_KEY" ]; then
            echo "::error::UPDATER_PRIVATE_KEY secret is not set — cannot sign updater manifest"
            exit 1
          fi
          APPIMAGE=$(find artifacts -type f -name '*.AppImage' | head -1)
          WINEXE=$(find artifacts -type f -name '*.exe' | head -1)
          DMG=$(find artifacts -type f -name '*.dmg' | head -1)
          echo "Installers found: AppImage=$APPIMAGE exe=$WINEXE dmg=$DMG"
          for pair in "$APPIMAGE|linux-x86_64" "$WINEXE|windows-x86_64" "$DMG|darwin-aarch64"; do
            INST="${pair%%|*}"; KEY="${pair##*|}"
            [ -n "$INST" ] || continue
            echo "Signing $KEY ← $INST"
            if [ -f latest.json ]; then
              node scripts/generate-latest-json.mjs "$VERSION" "$NOTES" "$KEY" "$INST" \
                --merge latest.json --verify-pubkey "$PUBKEY" > latest.json.tmp
              mv latest.json.tmp latest.json
            else
              node scripts/generate-latest-json.mjs "$VERSION" "$NOTES" "$KEY" "$INST" \
                --verify-pubkey "$PUBKEY" > latest.json
            fi
          done
          [ -f latest.json ] || { echo "::error::no platforms signed — no installer artifacts"; exit 1; }
          cp latest.json beta.json
          echo "Generated latest.json:"
          cat latest.json

      # RELEASE-04/08: every signature must verify against the committed pubkey.
      - name: Verify updater signatures
        shell: bash
        run: |
          set -euo pipefail
          APPIMAGE=$(find artifacts -type f -name '*.AppImage' | head -1)
          WINEXE=$(find artifacts -type f -name '*.exe' | head -1)
          DMG=$(find artifacts -type f -name '*.dmg' | head -1)
          for pair in "$APPIMAGE|linux-x86_64" "$WINEXE|windows-x86_64" "$DMG|darwin-aarch64"; do
            INST="${pair%%|*}"; KEY="${pair##*|}"
            [ -n "$INST" ] || continue
            node scripts/verify-updater-signature.mjs latest.json "$KEY" "$INST"
          done

      # RELEASE-06: SHA-256 checksums over the exact release assets.
      - name: Generate SHA-256 checksums
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p release-assets
          find artifacts -type f \( -name '*.AppImage' -o -name '*.deb' -o -name '*.exe' -o -name '*.msi' -o -name '*.dmg' -o -name '*.tar' \) -exec cp {} release-assets/ \;
          cp latest.json beta.json release-assets/
          # Windows install scripts ship as release assets so the one-liner
          # `irm .../releases/latest/download/install.ps1 | iex` resolves, and
          # they are included in SHA256SUMS.txt so install.ps1 can verify its
          # OWN checksum when run from disk (see install/win/install.ps1).
          cp install/win/install.ps1 install/win/uninstall.ps1 release-assets/
          # Unix counterparts ship the same way (see install/install.sh) —
          # `curl -fsSL .../releases/latest/download/install.sh | bash`.
          cp install/install.sh install/uninstall.sh release-assets/
          (cd release-assets && sha256sum * > SHA256SUMS.txt)
          echo "Release asset inventory:"
          ls -la release-assets/

      # RELEASE-08: fail if any required platform artifact is missing.
      - name: Verify release asset inventory
        shell: bash
        run: |
          set -euo pipefail
          for required in latest.json beta.json SHA256SUMS.txt install.ps1 uninstall.ps1 install.sh uninstall.sh; do
            [ -f "release-assets/$required" ] || { echo "::error::required asset missing: $required"; exit 1; }
          done
          for ext in AppImage exe dmg tar; do
            count=$(find release-assets -maxdepth 1 -type f -name "*.$ext" | wc -l)
            if [ "$count" -eq 0 ]; then
              echo "::error::no .$ext asset produced — release inventory incomplete"
              exit 1
            fi
          done
          echo "Release inventory OK: $(ls release-assets | wc -l) asset(s)"

      # RELEASE-09: create as DRAFT; published only after the inventory gate.
      - name: Create draft GitHub Release with assets
        uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2
        with:
          name: Release ${{ github.ref_name }}
          generate_release_notes: true
          draft: true
          files: |
            release-assets/*

      # RELEASE-06: provenance attestation for the exact released artifacts.
      # Covers every published asset class (AppImage/deb installers, NSIS/MSI,
      # DMG, docker tars, and both updater manifests).
      - name: Attest build provenance
        uses: actions/attest-build-provenance@e8998f949152b193b063cb0ec769d69d929409be # v2
        with:
          subject-path: |
            release-assets/*.AppImage
            release-assets/*.deb
            release-assets/*.exe
            release-assets/*.msi
            release-assets/*.dmg
            release-assets/*.tar
            release-assets/latest.json
            release-assets/beta.json
            release-assets/install.ps1
            release-assets/uninstall.ps1
            release-assets/install.sh
            release-assets/uninstall.sh

      # RELEASE-08/09: verify the release contains the required assets, then
      # flip draft → published. Runs after attestation so the asset list is final.
      - name: Verify release assets and publish
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail
          TAG="${{ github.ref_name }}"
          gh release view "$TAG" --json assets --jq '.assets[].name' > /tmp/attached.txt
          for required in latest.json beta.json SHA256SUMS.txt install.ps1 uninstall.ps1 install.sh uninstall.sh; do
            grep -qx "$required" /tmp/attached.txt || { echo "::error::release asset missing after upload: $required"; exit 1; }
          done
          echo "Release asset count: $(wc -l < /tmp/attached.txt)"
          echo "Publishing draft release $TAG"
          gh release edit "$TAG" --draft=false
          echo "Release $TAG published"
