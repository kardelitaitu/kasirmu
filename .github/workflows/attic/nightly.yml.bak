# ── Nightly Full-Matrix CI ──────────────────────────────────────────
#
# Runs every day at 3 AM UTC. Covers the full test matrix that is too
# expensive to run on every PR:
#   • Complete Rust test suite (all features, Linux + Windows + macOS)
#   • License-server full Go test suite (PR CI runs `-short`)
#   • All 4 UI test shards
#   • All 3 E2E test shards with Docker Compose
#   • Rust doc generation
#   • Release builds (desktop: Linux + Windows + macOS, tablet: Android)
#   • Benchmarks with regression comparison
#
# Also triggerable manually via workflow_dispatch.

name: Nightly CI

on:
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: -D warnings
  SCCACHE_GHA_ENABLED: "true"

defaults:
  run:
    shell: bash

# CICD-01: least-privilege default; jobs that read GHCR images grant
# packages: read in their own blocks.
permissions:
  contents: read

jobs:
  # ── Rust: Test Full (all features, cross-platform) ───────────────
  rust-test:
    name: Rust Test (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies (Linux)
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - name: Install macOS dependencies
        if: runner.os == 'macOS'
        run: |
          brew install librsvg pkg-config 2>/dev/null || true
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install cargo-nextest
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      - name: Run workspace tests (nextest, all features)
        run: cargo nextest run --workspace --all-features --exclude oz-pos-app --exclude oz-pos-tablet --profile ci
      - name: sccache stats
        run: sccache --show-stats

  # ── Go: license-server FULL suite (nightly) ─────────────────────
  # PR CI runs `go test -short` (skips the 3 slowest Midtrans webhook
  # integration tests, each with a load-bearing 1.1s sleep for
  # second-precision expiry assertions). The full suite (~82s) runs here
  # nightly so those integration tests still gate every day, without
  # slowing every PR.
  license-server-test:
    name: License-server Go tests (full)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: apps/license-server/go.mod
          cache-dependency-path: apps/license-server/go.sum
      - name: Run full Go test suite
        run: cd apps/license-server && go test -count=1 ./...

  # ── Rust: Doc generation ─────────────────────────────────────────
  rust-doc:
    name: Rust Doc
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Build docs (workspace, no deps)
        # AUDIT-27 CI-04: explicit pipefail shell for the tee pipeline.
        shell: bash --noprofile --norc -eo pipefail {0}
        run: cargo doc --workspace --no-deps --all-features --exclude oz-pos-app --exclude oz-pos-tablet 2>&1 | tee cargo-doc-output.log
      - name: Count doc warnings
        run: |
          WARNINGS=$(grep -c "warning:" cargo-doc-output.log 2>/dev/null || echo 0)
          echo "Doc warnings: $WARNINGS"
          echo "DOC_WARNINGS=$WARNINGS" >> $GITHUB_ENV
      - name: Upload docs artifact
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: rust-docs
          path: target/doc/
          retention-days: 7

  # ── UI: Tests (4-way sharded) ────────────────────────────────────
  ui-test:
    name: UI Tests (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2, 3, 4]
        totalShards: [4]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
        with:
          path: ui/node_modules/.cache/vitest
          # AUDIT-27 CI-05: shard-scoped save key — concurrent shard
          # writes no longer contend on one mutable cache entry.
          key: vitest-cache-nighty-${{ runner.os }}-${{ matrix.shard }}-${{ hashFiles('ui/package-lock.json') }}
          restore-keys: vitest-cache-nighty-${{ runner.os }}-
      - run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Run vitest (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
        # AUDIT-27 CI-04: explicit pipefail shell — a failing test before
        # `tee` must fail the step, not be masked by a successful tee.
        shell: bash --noprofile --norc -eo pipefail {0}
        run: (cd ui && npm run test -- --reporter=verbose --shard=${{ matrix.shard }}/${{ matrix.totalShards }} --pool=forks 2>&1) | tee ui/vitest-output.log
      - name: Gate on act() / flushSync warnings
        if: always()
        run: |
          if grep -E 'Warning: (An update to .* was not wrapped in act|flushSync was called from inside)' ui/vitest-output.log; then
            echo "::warning::vitest emitted act() or flushSync warnings — see ui/vitest-output.log"
            head -50 ui/vitest-output.log || true
          else
            echo "No act() or flushSync warnings detected."
          fi
      - name: i18n quality gate (shard 1 only)
        if: always() && matrix.shard == 1
        run: bash scripts/lint-i18n.sh

  # ── E2E Tests (Playwright) ───────────────────────────────────────
  e2e:
    name: E2E Tests (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      packages: read
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2, 3]
        totalShards: [3]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Cache Playwright browsers
        id: playwright-cache
        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-nightly-${{ hashFiles('ui/package-lock.json') }}
      - name: Install Playwright browsers
        if: steps.playwright-cache.outputs.cache-hit != 'true'
        run: cd ui && npx playwright install chromium --with-deps
      - name: Install Playwright system deps (cached)
        if: steps.playwright-cache.outputs.cache-hit == 'true'
        run: cd ui && npx playwright install-deps chromium
      # P28-1: Docker layer caching via BuildKit GHA cache
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3

      - name: Build E2E cloud-server image with GHA cache
        uses: docker/build-push-action@ca052bb54ab0790a636c9b5f226502c73d547a25 # v5
        with:
          context: .
          file: Dockerfile.server
          load: true
          tags: e2e-cloud-server:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Start Docker E2E backend & Vite dev server (parallel)
        env:
          OZ_API_SECRET: ci-test-secret
          # The dev-mode DevToolbar overlay floats bottom-right at tooltip
          # z-index and would sit on top of the retail cart action buttons,
          # intercepting pointer events (see sale.spec.ts discount click).
          # run-e2e.mjs sets this too — but Playwright's webServer.env only
          # applies when IT starts the server; with reuseExistingServer:true
          # it reuses THIS manually-started Vite, so the flag must be set
          # here as well (App.tsx reads VITE_DEV_TOOLBAR to disable it).
          VITE_DEV_TOOLBAR: '0'
        run: |
          # DOCKER-06: pre-pull the PINNED Redis digest (immutable, matches
          # docker-compose.e2e.yml) to mitigate registry rate-limit timeouts.
          REDIS_DIGEST="public.ecr.aws/docker/library/redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2"
          for i in 1 2 3; do
            echo "Pulling $REDIS_DIGEST (attempt $i/3)..."
            docker pull "$REDIS_DIGEST" && break
            echo "Redis pull failed (attempt $i/3), retrying..."
            sleep 15
          done
          # Start Docker Compose (use pre-pulled image, don't re-pull)
          docker compose -f docker-compose.e2e.yml up -d --pull=missing
          cd ui && npm run dev &
          VITE_PID=$!
          echo "VITE_PID=$VITE_PID" >> $GITHUB_ENV
          DOCKER_READY=false
          VITE_READY=false
          for i in $(seq 1 45); do
            if [ "$DOCKER_READY" != "true" ] && curl -sf http://localhost:3099/api/v1/health > /dev/null 2>&1; then
              echo "Docker backend ready (attempt $i)"
              DOCKER_READY=true
            fi
            if [ "$VITE_READY" != "true" ] && curl -sf http://localhost:1420 > /dev/null 2>&1; then
              echo "Vite dev server ready (attempt $i)"
              VITE_READY=true
            fi
            if [ "$DOCKER_READY" = "true" ] && [ "$VITE_READY" = "true" ]; then
              echo "Both servers ready (attempt $i)"
              break
            fi
            if [ "$i" -eq 45 ]; then
              echo "::error::Server startup timed out"
              docker compose -f docker-compose.e2e.yml logs e2e-cloud-server --tail=50 2>/dev/null || true
              exit 1
            fi
            sleep 2
          done
      - name: Run E2E tests (shard ${{ matrix.shard }}/${{ matrix.totalShards }})
        shell: bash --noprofile --norc -eo pipefail {0}
        run: |
          cd ui && npx playwright test --config e2e/playwright.config.ts --project=desktop --shard=${{ matrix.shard }}/${{ matrix.totalShards }} 2>&1 | tee e2e-output.log
      - name: Upload E2E test results
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: e2e-results-shard-${{ matrix.shard }}
          path: ui/e2e-results/
          retention-days: 7
      - name: Upload Playwright trace
        if: failure()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: e2e-traces-shard-${{ matrix.shard }}
          path: ui/test-results/
          retention-days: 7
      - name: Stop Docker E2E backend
        if: always()
        run: docker compose -f docker-compose.e2e.yml down -v

  # ── Release: Desktop (Linux AppImage) ────────────────────────────
  release-desktop-linux:
    name: Release Desktop (Linux)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install Tauri CLI
        run: cargo install tauri-cli --version "^2" --locked
      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Build desktop (Linux)
        run: cd apps/desktop-client && cargo tauri build --bundles appimage
      - name: Upload desktop (Linux)
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: oz-pos-desktop-linux.AppImage
          path: apps/desktop-client/target/release/bundle/appimage/*.AppImage
          retention-days: 7
      - name: sccache stats
        run: sccache --show-stats

  # ── Release: Desktop (Windows MSI) ───────────────────────────────
  release-desktop-windows:
    name: Release Desktop (Windows)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install Tauri CLI
        run: cargo install tauri-cli --version "^2" --locked
      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Build desktop (Windows)
        run: cd apps/desktop-client && cargo tauri build --bundles msi
      - name: Upload desktop (Windows)
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: oz-pos-desktop-windows.msi
          path: apps/desktop-client/target/release/bundle/msi/*.msi
          retention-days: 7
      - name: sccache stats
        run: sccache --show-stats

  # ── Release: Desktop (macOS DMG) ─────────────────────────────────
  release-desktop-macos:
    name: Release Desktop (macOS)
    runs-on: macos-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - name: Install macOS dependencies
        run: |
          brew install librsvg pkg-config 2>/dev/null || true
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install Tauri CLI
        run: cargo install tauri-cli --version "^2" --locked
      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Build desktop (macOS)
        run: cd apps/desktop-client && cargo tauri build --bundles dmg
      - name: Upload desktop (macOS)
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: oz-pos-desktop-macos.dmg
          path: apps/desktop-client/target/release/bundle/dmg/*.dmg
          retention-days: 7
      - name: sccache stats
        run: sccache --show-stats

  # ── Release: Tablet (Android APK) ────────────────────────────────
  release-tablet-android:
    name: Release Tablet (Android)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      # Map secret to env var for use in if: condition
      ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Setup JDK 17
        uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          java-version: '17'
          distribution: 'temurin'
      - name: Setup Android SDK
        uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        with:
          targets: aarch64-linux-android,armv7-linux-androideabi,x86_64-linux-android
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Setup Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24'
          cache: 'npm'
          cache-dependency-path: 'ui/package-lock.json'
      - name: Install UI dependencies
        run: cd ui && npm ci --no-audit --no-fund --ignore-scripts
      - name: Build UI (tablet)
        run: cd ui && npx vite build --config vite.tablet.config.ts
      - name: Install cargo-ndk
        run: cargo install cargo-ndk --locked
      - name: Install Tauri CLI
        run: cargo install tauri-cli --version "^2" --locked
      - name: Initialize Tauri Android project
        run: |
          cd apps/tablet-client
          cargo tauri android init
      - name: Decode keystore
        if: env.ANDROID_KEYSTORE_BASE64 != ''
        run: |
          cd apps/tablet-client/gen/android
          printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 -d > oz-pos-release.keystore
          echo "keyAlias=$KEY_ALIAS" > keystore.properties
          echo "password=$KEYSTORE_PASSWORD" >> keystore.properties
          echo "storeFile=$(pwd)/oz-pos-release.keystore" >> keystore.properties
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
      - name: Build Android APK
        run: |
          cd apps/tablet-client
          cargo tauri android build --apk --target aarch64
      # ── CICD-03: remove signing material after the build ───────
      # Same hygiene as android.yml: keystore.properties holds plaintext
      # passwords and the decoded .keystore is the signing key itself.
      - name: Remove decoded signing material
        if: always()
        run: |
          rm -f apps/tablet-client/gen/android/oz-pos-release.keystore
          rm -f apps/tablet-client/gen/android/keystore.properties
      - name: Find APK output
        run: |
          find apps/tablet-client/gen/android -name "*.apk" -o -name "*.aab" 2>/dev/null | head -20
      - name: Upload APK
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: oz-pos-tablet-aarch64.apk
          path: |
            apps/tablet-client/gen/android/app/build/outputs/apk/**/*.apk
            apps/tablet-client/gen/android/app/build/outputs/bundle/**/*.aab
          retention-days: 14
      - name: sccache stats
        run: sccache --show-stats

  # ── Flaky-test detector (AUDIT-27 CI-09) ─────────────────────────
  #
  # Runs scripts/report-flaky.sh (3 repeat runs) on a scheduled basis and
  # verifies the quarantine registry is valid. The detector is
  # informational (continue-on-error) — it surfaces flaky candidates
  # without failing nightly; the registry gate in ci.yml fails closed on
  # expired/ownerless/issueless entries. Upload the report as an artifact.
  # Split into TWO jobs so a detector timeout (continue-on-error) can never
  # skip the fail-closed registry verifier. The detector runs the full
  # workspace 3×, which is the expensive part; the verifier is seconds.
  flaky-detect:
    name: Flaky Detection
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - name: Install system dependencies
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
            libdbus-1-dev libudev-dev pkg-config
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Install cargo-nextest
        uses: taiki-e/install-action@1ed6d7be6168f6c9046541087ff549b6bc581fdf # v2
        with:
          tool: cargo-nextest
      - name: Run flaky detector (2 repeat runs, workspace)
        continue-on-error: true
        run: bash scripts/report-flaky.sh --runs 2
      - name: Upload flaky report
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: flaky-report
          path: target/flaky-reports/
          retention-days: 30

  flaky-quarantine-registry:
    name: Flaky Quarantine Registry (nightly)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify quarantine manifest (fail-closed)
        run: python3 scripts/verify-flaky-quarantine.py

  # ── CI docs drift (AUDIT-27 CI-08) — nightly gates are manifest-governed ─
  #
  # nightly-* gates live in scripts/gates.json; this job verifies the
  # manifest matches the workflows (job existence + required/advisory
  # status vs continue-on-error) and the local runners, mirroring the
  # ci.yml `ci-docs-drift` gate. Pure python — no toolchain deps.
  ci-docs-drift:
    name: CI Docs Drift (nightly)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Verify gates.json matches workflows + local runners
        run: python3 scripts/verify-ci-docs-drift.py

  # Runs all oz-core Criterion.rs benchmarks and uploads the full
  # criterion output as a versioned artifact for manual comparison.
  #
  # To compare two nightly runs:
  #   1. Download two benchmark-results artifacts
  #   2. Extract each target/criterion/ directory
  #   3. Install critcmp:  cargo install critcmp
  #   4. Compare:          critcmp --load ./baseline-criterion baseline
  #                        critcmp baseline current
  #
  # See docs/benchmarks/regression-tracking.md for the full workflow.
  benchmarks:
    name: Benchmarks
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2
        with:
          save-if: ${{ github.ref == 'refs/heads/main' }}
      - uses: mozilla/sccache-action@9e7fa8a12102821edf02ca5dbea1acd0f89a2696 # v0.0.10
      - name: Run cargo bench (oz-core)
        # AUDIT-27 CI-04: explicit pipefail shell for the tee pipeline.
        shell: bash --noprofile --norc -eo pipefail {0}
        run: cargo bench -p oz-core 2>&1 | tee benchmark-output.txt
      - name: Extract benchmark timings to job summary
        run: |
          echo "## Benchmark Results (${{ github.sha }})" >> $GITHUB_STEP_SUMMARY
          echo '' >> $GITHUB_STEP_SUMMARY
          TIMINGS=$(grep -E 'time:\s*\[' benchmark-output.txt 2>/dev/null || true)
          if [ -n "$TIMINGS" ]; then
            echo "$TIMINGS" | sed 's/^/| /; s/$/ |/' >> $GITHUB_STEP_SUMMARY
          else
            echo '_No benchmark timings extracted._' >> $GITHUB_STEP_SUMMARY
          fi
      - name: Upload full criterion output for cross-run comparison
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: benchmark-results-${{ github.sha }}
          path: |
            benchmark-output.txt
            target/criterion/
          retention-days: 30
      - name: sccache stats
        run: sccache --show-stats
