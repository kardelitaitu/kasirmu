# ─────────────────────────────────────────────────────────────────────
# OZ-POS — Development Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# Do NOT commit `.env` files — they contain secrets.
#
#   cp .env.example .env
#
# Documents the CURRENT unified runtime (runbook §8): the Rust cloud server
# (apps/cloud-server) and the Go license server (apps/license-server), which
# ship together in ops/docker/Dockerfile.unified behind one caddy. The paste-ready
# Northflank block is docs/operations/go-live-checklist.md §2; the full
# license-server reference is apps/license-server/DEPLOY.md §7.

# ── Cloud server (Rust) — apps/cloud-server ─────────────────────────
# Log level filter (trace, debug, info, warn, error). Default: info.
RUST_LOG=info

# HTTP listen port (default: 3099 — matches the Dockerfile ENV).
OZ_API_PORT=3099

# SQLite database path (default: kasir.db in the CWD; /data/kasir.db is
# the Docker/Compose convention). Postgres overrides SQLite entirely.
OZ_DB_PATH=kasir.db
# DATABASE_URL=postgres://user:password@host:5432/ozpos   # when set, Postgres is used
# OZ_DB_REQUIRE_TLS=1                                     # implied by OZ_PRODUCTION=1; requires sslmode=require
# OZ_DB_POOL_SIZE=20                                      # Postgres pool size (default 20)

# JWT signing secret + admin key for token mint/plan endpoints. BOTH are
# REQUIRED at boot when OZ_PRODUCTION=1 (fail-closed: no dev-secret JWT
# fallback, no open token mint without OZ_ADMIN_KEY).
#   Generate with: openssl rand -hex 32
OZ_API_SECRET=
OZ_ADMIN_KEY=

# Fail-closed production mode: refuses to start unless OZ_API_SECRET and
# OZ_ADMIN_KEY are set, and implies OZ_DB_REQUIRE_TLS=1. Leave UNSET for
# local dev (token mint is then open — never expose that to the internet).
# OZ_PRODUCTION=1

# Postgres schema apply. Default (unset) = apply full DDL at startup. Set
# OZ_APPLY_SCHEMA=0 once the schema exists and the app runs as the restricted
# post-cutover role oz_app (runbook §6.3 / scripts/rls-cutover.sql) — that
# role has DML-only grants, so the DDL re-apply would fail.
# OZ_APPLY_SCHEMA=0

# Sync plan gating: 1 = reject sync from free-plan tenants (403 plan_required).
OZ_ENFORCE_PLANS=0

# Extra CORS origins beyond the default allowlist (comma-separated).
OZ_CORS_ORIGINS=

# License-server base URL override for desktop/tablet clients (default: the
# compiled-in URL — runbook §8 app-side table).
OZ_LICENSE_SERVER_URL=

# Sync service base URL used when a device links to an account (ADR #54 §2.5 step 6):
# the licence server registers the terminal there and hands the device its sync
# credential. No default — addresses are declared, never guessed (ADR #55). Left unset,
# a link still succeeds and answers terminal.issued=false: the account is linked, the
# device just holds no sync credential until this is set.
# Unified deployment (both services in one container): http://127.0.0.1:3099
OZ_SYNC_API_URL=

# Log output format: "json" or anything-else (plain, the default).
# OZ_LOG_FORMAT=json

# ── Sync service (Rust) — turned up only when the deployment needs it ──
# Optional Redis for the cache/pubsub layer; unset keeps the in-process cache.
# OZ_REDIS_URL=
# Tokio worker threads for the sync API (0 = logical CPU count; default 2). Raise it for many
# terminals on one deployment, and watch memory: one worker per core is the usual ceiling.
# OZ_WORKER_THREADS=2
# Skips UUID validation on pushed items (~0.02 core CPU each at 200+ terminals). A malformed id
# then reaches the database instead of being rejected at the edge: leave it off unless the CPU
# profile says otherwise.
# OZ_SKIP_PUSH_VALIDATION=
# Content-addressed image volume (spec 0046b). Defaults to /data/images in production and
# ./data/images in dev; created on startup.
# OZ_IMAGE_DIR=
# WIDENING ESCAPE HATCH — a privilege increase, not a tuning knob: OZ_TERMINAL_READ_TIER=full
# gives terminal client-credentials tokens the legacy full-read permission set instead of the
# `terminal` preset (spec 0047 F2). It warns once per process. Set it only to unblock a legacy
# device, and remove it once that device is updated.
# OZ_TERMINAL_READ_TIER=

# Optional sync-redirect mode (dev/testing only): OZ_REDIRECT_ONLY=true
# requires OZ_SYNC_REDIRECT_URL to be set.
# OZ_REDIRECT_ONLY=false
# OZ_SYNC_REDIRECT_URL=

# ── Google sign-in (ADR #54) ────────────────────────────────────────
# With OZ_GOOGLE_CLIENT_ID unset both OAuth endpoints answer 503. The website's
# sign-in button is gated on the API URL rather than on this key, so it renders
# anyway and the click shows that 503 — set these before announcing the feature.
# Register ALL FOUR callback URIs in the Google Cloud console BEFORE deploying — redirect
# URIs match exactly, so a live-but-unregistered host fails the flow at Google with
# redirect_uri_mismatch. There are two paths because there are two flows, and BOTH use this
# one Web-application client: the web form returns the browser to the licence host, and the
# desktop/tablet link returns Google to the licence host too (which then hands the app a
# one-time code on its loopback listener — the app's own port is never registered with
# Google, so nothing here depends on the device):
#   https://license.kasir.mu/api/v1/web/oauth/google/callback
#   https://license.ozpos.my.id/api/v1/web/oauth/google/callback
#   https://license.kasir.mu/api/v1/desktop/link/google/callback
#   https://license.ozpos.my.id/api/v1/desktop/link/google/callback
OZ_GOOGLE_CLIENT_ID=
OZ_GOOGLE_CLIENT_SECRET=
# Optional: pin the callback URL and the host the flow returns to.
# OZ_GOOGLE_REDIRECT_URI=
# OZ_WEB_SITE_URL=https://kasir.mu

# ── License server (Go) — apps/license-server ───────────────────────
# RSA private key that signs license payloads. REQUIRED at boot — the server
# exits without it. OZ_LICENSE_KEY is the legacy fallback alias for it.
OZ_LICENSE_PRIVATE_KEY=

# Paddle Billing — REQUIRED at boot (fail-fast gates): webhook signature
# secret + the price_id→tier_key map (unmapped prices fail provisioning).
# PADDLE_API_URL defaults to the LIVE API — use the sandbox URL until the
# live catalog exists, then swap the price ids for live ones.
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_TIERS=pri_xxxxxxxx:pro,pri_yyyyyyyy:premium
PADDLE_API_URL=https://sandbox-api.paddle.com
# PADDLE_API_KEY=                     # optional: customer-email fallback via GET /customers/{id}
# PADDLE_WEBHOOK_MAX_AGE=5m           # replay window for the webhook timestamp

# SMTP (Brevo relay): OTP + license-key receipt emails. OZ_SMTP_FROM must be
# a sender verified with the relay. Port 465 = implicit TLS; anything else =
# STARTTLS. Once OZ_SMTP_HOST is set, OZ_SMTP_FROM is required at boot
# (the sender identity is probed on startup).
OZ_SMTP_HOST=smtp-relay.brevo.com
OZ_SMTP_PORT=587
OZ_SMTP_USER=
OZ_SMTP_PASSWORD=
OZ_SMTP_FROM=

# Web auth surface (website login/signup/account/contact).
# Unset = defaults already include the deployed site + localhost.
# OZ_CORS_ORIGINS (comma-separated, shared with the Rust cloud server)
# is also merged in — set either one when adding a new domain.
OZ_WEB_ALLOWED_ORIGINS=
# Session lifetime (Go duration).
OZ_WEB_SESSION_TTL=24h
# Support-contact target for /api/v1/web/contact; unset → 503 + mailto fallback.
OZ_DISCORD_WEBHOOK=

# ── Container healthcheck (unified image) ───────────────────────────
# apps/unified/healthcheck.sh fails the container after N consecutive bad
# probes of each gate (defaults: 3).
# OZ_HEALTH_SMTP_MAX_FAILS=3
# OZ_HEALTH_PADDLE_MAX_FAILS=3

# ── Test-only (never needed in production) ──────────────────────────
# OZ_TEST_PG_URL=        # Postgres URL for cloud-server config tests
# PG_SYNC_TEST_URL=      # Postgres URL for sync integration tests
# LICENSE_KEY_COOLDOWN=  # shortens the per-key activation cooldown in Go tests

# ── POS terminal / desktop-mobile builds (NOT the unified server) ──
# The unified image never reads these; they serve the Tauri desktop/tablet
# apps and the Android build toolchain (docs/operations/android-install-test.md).
# STRIPE_SECRET_KEY=           # POS payment gateways (read by kasirmu-payment)
# MIDTRANS_SERVER_KEY=         # POS QRIS gateway
ANDROID_HOME=
ANDROID_NDK_HOME=
JAVA_HOME=
