# ── OZ-POS Cloud Server ──────────────────────────────────────────────
#
# Multi-stage Dockerfile that builds the headless cloud-sync binary
# (kasirmu-cloud) and packages it into a minimal runtime image.
#
# Usage:
#
#   docker build -f ops/docker/Dockerfile.server -t oz-pos-cloud:latest .
#   docker run -d -p 3099:3099 -v oz-data:/data oz-pos-cloud:latest
#
# Environment variables:
#   OZ_DB_PATH   — SQLite database path (default: /data/kasir.db)
#   OZ_API_PORT  — HTTP listen port (default: 3099)
#   RUST_LOG     — log level filter (default: info)
#   OZ_API_SECRET— JWT signing secret (REQUIRED in production)
#   OZ_ADMIN_KEY — admin key gating token mint + plan endpoint (REQUIRED;
#                  docker-compose.yml fails closed at parse time when unset)

# ── Stage 1: Builder ─────────────────────────────────────────────────
# DOCKER-02: base images pinned to immutable digests (refreshed 2026-08-03).
# rust:1.88-slim tag — multi-arch index digest.
FROM rust:1.88-slim@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89 AS builder

# Install build dependencies needed by some native crates (rusqlite
# bundles its own libsqlite3, but some transitive deps might need
# pkg-config / libc-dev). serialport (via kasirmu-hal) needs libudev.pc at
# compile time through libudev-sys — without libudev-dev the builder
# dies at libudev-sys's build script (measured 2026-09-16).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        pkg-config \
        libc-dev \
        libssl-dev \
        libudev-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy manifest files first so Docker can cache dependency downloads.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/kasirmu-core/Cargo.toml crates/kasirmu-core/
COPY crates/kasirmu-api/Cargo.toml crates/kasirmu-api/
COPY crates/kasirmu-logging/Cargo.toml crates/kasirmu-logging/
COPY crates/kasirmu-hal/Cargo.toml crates/kasirmu-hal/
COPY crates/kasirmu-lua/Cargo.toml crates/kasirmu-lua/
COPY crates/kasirmu-notification/Cargo.toml crates/kasirmu-notification/
COPY crates/kasirmu-plugin/Cargo.toml crates/kasirmu-plugin/
COPY crates/kasirmu-security/Cargo.toml crates/kasirmu-security/
COPY crates/kasirmu-payment/Cargo.toml crates/kasirmu-payment/
COPY crates/kasirmu-reporting/Cargo.toml crates/kasirmu-reporting/
COPY crates/kasirmu-cli/Cargo.toml crates/kasirmu-cli/
COPY crates/kasirmu-crypto/Cargo.toml crates/kasirmu-crypto/
COPY crates/kasirmu-media/Cargo.toml crates/kasirmu-media/
COPY crates/kasirmu-lan/Cargo.toml crates/kasirmu-lan/
COPY crates/kasirmu-local-api/Cargo.toml crates/kasirmu-local-api/
COPY crates/kasirmu-bridge/Cargo.toml crates/kasirmu-bridge/
COPY crates/qris-core/Cargo.toml crates/qris-core/
COPY foundation/Cargo.toml foundation/
COPY platform/core/Cargo.toml platform/core/
COPY platform/kernel/Cargo.toml platform/kernel/
COPY platform/startup/Cargo.toml platform/startup/
COPY platform/sync/Cargo.toml platform/sync/
COPY modules/sales/Cargo.toml modules/sales/
COPY modules/inventory/Cargo.toml modules/inventory/
COPY modules/crm/Cargo.toml modules/crm/
COPY modules/tax/Cargo.toml modules/tax/
COPY modules/settings/Cargo.toml modules/settings/
COPY modules/staff/Cargo.toml modules/staff/
COPY modules/reporting/Cargo.toml modules/reporting/
COPY modules/terminal/Cargo.toml modules/terminal/
COPY modules/currency/Cargo.toml modules/currency/
COPY modules/loyalty/Cargo.toml modules/loyalty/
COPY modules/giftcards/Cargo.toml modules/giftcards/
COPY modules/kitchen/Cargo.toml modules/kitchen/
COPY modules/promotions/Cargo.toml modules/promotions/
COPY modules/purchasing/Cargo.toml modules/purchasing/
COPY scripts/updater-compat-check/Cargo.toml scripts/updater-compat-check/
COPY apps/cloud-server/Cargo.toml apps/cloud-server/

# Prime the dependency cache. This layer is cached unless a manifest
# or lockfile changes.
#
# NOTE (DOCKER-09): the priming build below is BEST-EFFORT and its failure is
# intentionally non-fatal: `cargo build --package kasirmu-cloud` can
# legitimately fail here when a dependency target is not yet built (the
# dummy sources are placeholders, not a real program). The real build at
# line ~119 is the source of truth and fails the image on any error. The
# unbounded `|| true` from the audit was replaced with an explicit, logged
# best-effort marker so a broken cache layer is diagnosable while still
# never blocking a valid image. Workspace/priming consistency is enforced
# by scripts/verify-dockerfile-workspace.py in CI.
RUN mkdir -p crates/kasirmu-core/src crates/kasirmu-api/src crates/kasirmu-logging/src \
             crates/kasirmu-hal/src crates/kasirmu-lua/src crates/kasirmu-notification/src \
             crates/kasirmu-plugin/src crates/kasirmu-security/src crates/kasirmu-payment/src \
             crates/kasirmu-reporting/src crates/kasirmu-cli/src \
             crates/kasirmu-crypto/src crates/kasirmu-media/src crates/kasirmu-lan/src crates/kasirmu-local-api/src \
             crates/kasirmu-bridge/src \
             crates/qris-core/src \
             foundation/src \
             platform/core/src platform/kernel/src platform/startup/src \
             platform/sync/src \
             modules/sales/src modules/inventory/src \
             modules/crm/src modules/tax/src modules/settings/src \
             modules/staff/src modules/reporting/src modules/terminal/src \
             modules/currency/src modules/loyalty/src \
             modules/giftcards/src modules/kitchen/src \
             modules/promotions/src modules/purchasing/src \
             apps/cloud-server/src apps/desktop-tauri/src apps/mobile-tauri/src \
    && echo "// dummy" > crates/kasirmu-core/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-api/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-logging/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-hal/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-lua/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-notification/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-plugin/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-security/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-payment/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-reporting/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-cli/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-crypto/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-media/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-lan/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-local-api/src/lib.rs \
    && echo "// dummy" > crates/kasirmu-bridge/src/lib.rs \
    && echo "// dummy" > crates/qris-core/src/lib.rs \
    && echo "// dummy" > foundation/src/lib.rs \
    && echo "// dummy" > platform/core/src/lib.rs \
    && echo "// dummy" > platform/kernel/src/lib.rs \
    && echo "// dummy" > platform/startup/src/lib.rs \
    && echo "// dummy" > platform/sync/src/lib.rs \
    && echo "// dummy" > modules/sales/src/lib.rs \
    && echo "// dummy" > modules/inventory/src/lib.rs \
    && echo "// dummy" > modules/crm/src/lib.rs \
    && echo "// dummy" > modules/tax/src/lib.rs \
    && echo "// dummy" > modules/settings/src/lib.rs \
    && echo "// dummy" > modules/staff/src/lib.rs \
    && echo "// dummy" > modules/reporting/src/lib.rs \
    && echo "// dummy" > modules/terminal/src/lib.rs \
    && echo "// dummy" > modules/currency/src/lib.rs \
    && echo "// dummy" > modules/loyalty/src/lib.rs \
    && echo "// dummy" > modules/giftcards/src/lib.rs \
    && echo "// dummy" > modules/kitchen/src/lib.rs \
    && echo "// dummy" > modules/promotions/src/lib.rs \
    && echo "// dummy" > modules/purchasing/src/lib.rs \
    && echo "// dummy" > apps/cloud-server/src/main.rs \
    && echo "// dummy" > apps/desktop-tauri/src/main.rs \
    && printf '[package]\nname = "kasirmu-app"\nversion = "0.0.39"\nedition = "2024"\n' > apps/desktop-tauri/Cargo.toml \
    && echo "// dummy" > apps/mobile-tauri/src/main.rs \
    && printf '[package]\nname = "kasirmu-mobile"\nversion = "0.0.39"\nedition = "2024"\n' > apps/mobile-tauri/Cargo.toml \
    && (cargo build --package kasirmu-cloud --release > /tmp/prime.log 2>&1 \
        || { echo "WARN: dependency cache-priming build did not complete (best-effort; see /tmp/prime.log)"; }) \
    && true

# Now copy the actual source and rebuild (only changed source files
# invalidate this layer). ui/ is intentionally NOT copied: kasirmu-core vendors
# its topologySemantics.json contract and the server build must never
# depend on the UI tree (.dockerignore excludes ui entirely).
ARG CACHE_BUST=1
COPY crates/ crates/
COPY foundation/ foundation/
COPY platform/ platform/
COPY modules/ modules/
COPY apps/ apps/

# Build for real.
RUN cargo build --package kasirmu-cloud --release

# ── Stage 2: Runtime ────────────────────────────────────────────────
# debian:bookworm-slim tag — multi-arch index digest (refreshed 2026-09-17).
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

# Install CA certificates for outbound HTTPS and gosu for dropping privileges.
# libudev1 is the runtime half of the builder's libudev-dev: the cloud
# binary links libudev.so via serialport/kasirmu-hal. bookworm-slim already
# ships libudev1 (as a dependency of util-linux), so this line is
# belt-and-braces -- it pins the dependency explicitly instead of inheriting
# it from the base image. Measured 2026-09-18 against the pinned digest:
# `dpkg -l libudev1` reports 252.39-1~deb12u2, status `ii`, with the base
# image untouched. The earlier claim here that bookworm-slim "does not ship
# it" was wrong.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libc6 \
        libudev1 \
        gosu \
        wget \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security and initialize runtime /data directory.
RUN groupadd --system ozpos && \
    useradd --system --gid ozpos --home-dir /data ozpos && \
    mkdir -p /data && chown -R ozpos:ozpos /data

WORKDIR /app

COPY --from=builder /build/target/release/kasirmu-cloud /app/kasirmu-cloud
COPY scripts/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Runtime volume for persistent SQLite data.
VOLUME ["/data"]

# Default environment.
ENV OZ_DB_PATH=/data/kasir.db
ENV OZ_API_PORT=3099
ENV RUST_LOG=info

EXPOSE 3099

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/kasirmu-cloud"]
