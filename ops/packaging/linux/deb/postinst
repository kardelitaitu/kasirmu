#!/bin/sh
set -e

# Register the desktop file and update icon cache.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor
fi

# Ensure the data directory exists. Renamed from /var/lib/oz-pos 2026-10-08: the
# product is kasir.mu, and the old name was a pre-rebrand leftover. The app itself
# uses Tauri's app_data_dir() (bundle id mu.kasir.app) and never read the old path,
# so this is a naming fix rather than a data migration -- but an installation from
# before the rename may still hold a directory, so it is moved rather than abandoned.
DATA_DIR=/var/lib/kasir.mu
LEGACY_DIR=/var/lib/oz-pos
if [ -d "$LEGACY_DIR" ] && [ ! -e "$DATA_DIR" ]; then
    mv "$LEGACY_DIR" "$DATA_DIR"
fi
mkdir -p "$DATA_DIR"

exit 0
